From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Sun, 8 Nov 2026 05:56:34 +0000
Subject: [PATCH 3/5] flashnext: the window self-check serves the largest
 row-exact width

A differing row no longer falls back to a fixed 32: the check reports
the largest prefix of widths whose every row scored byte-equal to its
one-token step and serves that, floored at the upstream 32. On GB10
the boundary is the pending-row log capacity (48): widths 1..48 are
exact at 1176 of 1176 rows, 49..64 differ, so the load serves 48-row
copy windows and the core grows copies to 47 drafts.
---
 zig/src/families/flashnext/cuda_lanes_load.zig |  7 ++-----
 zig/src/families/flashnext/cuda_mtp_check.zig  | 11 ++++++++++-
 zig/src/platform/environment.zig               |  1 +
 3 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/zig/src/families/flashnext/cuda_lanes_load.zig b/zig/src/families/flashnext/cuda_lanes_load.zig
index 51c0bbb02..66af6d13f 100644
--- a/zig/src/families/flashnext/cuda_lanes_load.zig
+++ b/zig/src/families/flashnext/cuda_lanes_load.zig
@@ -88,11 +88,8 @@ pub fn open(comptime F: type, gpa: std.mem.Allocator, io: std.Io, ctx: *const cu
         if (std.c.getenv("TF_FLASHNEXT_CONFIDENCE")) |v| own.confidence = std.fmt.parseFloat(f64, std.mem.span(v)) catch mtp.default_confidence;
     }
     errdefer if (own.head) |h| h.deinit();
-    // the copied continuations' row invariance on the real weights, before anything serves: every row of
-    // every width to the served window must score byte-equal to its one-token step. A differing row falls
-    // back to the upstream 32-row windows for this load; a probe that cannot run leaves max_rows and says
-    // so (TF_FLASHNEXT_WINDOW_CHECK=0 skips the probe).
-    const probe = if (std.c.getenv("TF_FLASHNEXT_WINDOW_CHECK")) |v| !std.mem.eql(u8, std.mem.span(v), "0") else true;
+    // the boot self-check proves the copied continuations' row invariance; TF_FLASHNEXT_WINDOW_CHECK=0 skips it
+    const probe = @import("sys").environment.read(bool, "TF_FLASHNEXT_WINDOW_CHECK", true) catch true;
     if (own.head != null and o.drafts and o.tp == 1 and probe) {
         const tri = own.tri();
         mtp.served_rows = @import("cuda_mtp_check.zig").probeServed(@TypeOf(tri), gpa, driver, &own.stream, tri, own.engine, own.head.?, mtp.max_rows) catch |err| blk: {
diff --git a/zig/src/families/flashnext/cuda_mtp_check.zig b/zig/src/families/flashnext/cuda_mtp_check.zig
index 4c5b66341..242886861 100644
--- a/zig/src/families/flashnext/cuda_mtp_check.zig
+++ b/zig/src/families/flashnext/cuda_mtp_check.zig
@@ -241,7 +241,16 @@ pub fn probeServed(comptime Tri: type, gpa: std.mem.Allocator, driver: *cuda.Dri
     }
     std.log.info("flashnext: window self-check: {d} of {d} rows byte-equal to their one-token steps (widths 1-{d})", .{ compared - differing, compared, rows });
     if (first_bad > 0) std.log.warn("flashnext: width {d} is the first with rows differing from their one-token steps", .{first_bad});
-    return if (differing == 0) rows else 32;
+    if (differing == 0) return rows;
+    // serve the largest proven-exact prefix: every width to it has all rows byte-equal, past it some differ
+    var run: usize = 0;
+    for (bad[0..rows], 0..) |b, i| {
+        if (b != 0) break;
+        run = i + 1;
+    }
+    const served = @max(@min(run, rows), 32);
+    std.log.info("flashnext: widths 1-{d} are row-equal at every row; serving {d}-row copy windows", .{ run, served });
+    return served;
 }
 
 /// A sequence's caches back to empty (the check reruns a prompt on one allocation).
diff --git a/zig/src/platform/environment.zig b/zig/src/platform/environment.zig
index 022632984..8149e1a0a 100644
--- a/zig/src/platform/environment.zig
+++ b/zig/src/platform/environment.zig
@@ -47,6 +47,7 @@ pub const rules = [_]Rule{
     .{ .name = "TF_DRAFT_NODES", .scope = .cuda, .kind = .size, .forms = "a whole nonnegative native-size node count (capped by the drafter's window)" },
     .{ .name = "TF_QMMF_HALF_BELOW", .scope = .cuda, .kind = .size, .forms = "a whole nonnegative native-size block count (0 disables half tiles)" },
     .{ .name = "TENSORFOLD_PROMPT_CACHE_KEEP_OTHERS", .scope = .cuda, .kind = .flag, .forms = "0 or 1" },
+    .{ .name = "TF_FLASHNEXT_WINDOW_CHECK", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (0 skips the boot copy-window self-check)" },
     .{ .name = "TF_ROCE_GID_INDEX", .scope = .cuda, .kind = .u32, .forms = "a whole GID index from 0 to 2147483647" },
     .{ .name = "TF_GEMMA4_CHUNK_SOLO", .scope = .gemma4, .kind = .size, .forms = "a solo prompt pass's rows, a multiple of 512 up to 4096" },
     .{ .name = "TF_DRAMA_PREFILL_ROWS", .scope = .drama3, .kind = .u32, .trim = " ", .forms = "whole prompt rows a chunk, 1 through 1024 (checked when a Drama 3 checkpoint opens)" },
