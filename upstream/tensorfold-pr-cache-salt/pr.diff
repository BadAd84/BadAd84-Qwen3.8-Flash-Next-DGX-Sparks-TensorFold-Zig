index 00000000..ca497a6a
--- /dev/null
+++ b/zig/src/core/prompt_cache_salt_test.zig
@@ -0,0 +1,232 @@
+//! Cache salts: a salted request resumes, shares, evicts and learns only within its own salt; the unsalted as before.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const imprint = @import("prompt_imprint.zig");
+const rmTree = @import("prompt_imprint_test.zig").rmTree;
+const Fake = @import("prompt_cache_test.zig").Fake;
+const fresh = @import("prompt_cache_test.zig").fresh;
+const Store = pc.Store;
+
+/// `n` tokens counting up from `from`.
+fn seq(comptime n: usize, from: u32) [n]u32 {
+    var out: [n]u32 = undefined;
+    for (&out, 0..) |*t, i| t.* = from + @as(u32, @intCast(i));
+    return out;
+}
+
+/// One request under `salt`: begin, then a pass keeping at every mark; returns where it resumed.
+fn request(f: *Fake, s: *Store, a: std.mem.Allocator, prompt: []const u32, history: u32, shared: []const u32, salt: u64) !u32 {
+    f.salt = salt;
+    const p = try s.beginRewind(a, prompt, history, 0, shared, &.{}, null, &.{}, salt);
+    try std.testing.expectEqual(fresh(prompt), f.pass(s, prompt, p));
+    return p.from;
+}
+
+test "a salted prompt resumes only states its own salt kept; unsalted prompts share theirs as before" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 1 << 20);
+    defer s.deinit();
+    try std.testing.expectEqual(@as(u64, 0), pc.saltKey(null));
+    const ka = pc.saltKey("tenant-a");
+    const kb = pc.saltKey("tenant-b");
+    try std.testing.expect(ka != 0 and kb != 0 and ka != kb);
+    const t1 = seq(10, 1); // history 8
+    try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &t1, 8, &.{}, ka)); // cold under A
+    try std.testing.expect(s.find(&t1, &.{}, &.{}, 0) == null); // unsalted: cold
+    try std.testing.expect(s.find(&t1, &.{}, &.{}, kb) == null); // another salt: cold
+    try std.testing.expectEqual(@as(u32, 8), try request(&f, &s, a, &t1, 8, &.{}, ka)); // A resumes its own
+    try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &t1, 8, &.{}, kb)); // B keeps its own beside it
+    try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &t1, 8, &.{}, 0)); // and so do the unsalted
+    try std.testing.expectEqual(@as(u32, 8), try request(&f, &s, a, &t1, 8, &.{}, 0));
+    try std.testing.expectEqual(@as(usize, 3), s.entries.items.len);
+    for ([_]u64{ ka, kb, 0 }) |k| try std.testing.expectEqual(k, s.find(&t1, &.{}, &.{}, k).?.salt);
+    s.forget(&t1, 8, &.{}, kb); // a forget under B leaves A's and the unsalted state
+    try std.testing.expect(s.find(&t1, &.{}, &.{}, kb) == null);
+    try std.testing.expect(s.find(&t1, &.{}, &.{}, ka) != null and s.find(&t1, &.{}, &.{}, 0) != null);
+    try std.testing.expectEqual(s.entries.items.len, f.live);
+}
+
+test "a shared system cut is shared within its salt only" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 1 << 20);
+    defer s.deinit();
+    const ka = pc.saltKey("tenant-a");
+    const kb = pc.saltKey("tenant-b");
+    var c1 = seq(30, 1); // a 20-token system block, then a conversation
+    try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &c1, 28, &.{20}, ka));
+    try std.testing.expect(s.find(c1[0..21], &.{}, &.{}, ka).?.shared);
+    @memcpy(c1[20..], &seq(10, 500)); // another conversation on the same block
+    try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &c1, 20, &.{}, kb)); // B's history ends at the cut
+    try std.testing.expect(!s.find(c1[0..21], &.{}, &.{}, kb).?.shared); // not A's planned cut
+    try std.testing.expectEqual(@as(u32, 20), try request(&f, &s, a, &c1, 28, &.{20}, ka)); // A's next conversation
+    try std.testing.expectEqual(s.entries.items.len, f.live);
+}
+
+test "a salted request learns no state to disk and reads none back: learned states are the unsalted ones" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var root_buf: [128]u8 = undefined;
+    const root = try std.fmt.bufPrint(&root_buf, "/tmp/tf-learn-salt-{d}", .{std.c.getpid()});
+    defer rmTree(root);
+    const rules: pc.Rules = .{ .lookahead = 1, .min_prompt = 0, .min_gap = 1 };
+    const harness = [_]u32{ 7, 7, 7, 7, 7, 7 }; // a state at 5 reads it all (lookahead 1)
+    var im = try imprint.Imprint.open(gpa, root, 3, 1 << 30);
+    defer im.deinit();
+    const ka = pc.saltKey("tenant-a");
+    {
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.learned(), rules, 1 << 20);
+        defer s.deinit();
+        s.imprint = &im;
+        const first = harness ++ [_]u32{ 1, 2, 9 };
+        try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &first, 8, &.{5}, ka));
+        try std.testing.expect(s.keep(&first, 5, null, &.{}, &.{}, ka)); // the same state kept again: still not learned
+        try std.testing.expectEqual(@as(usize, 0), f.writes); // A's cut stays in memory
+        try std.testing.expect(!im.has(imprint.Imprint.keyOf(&harness)));
+        try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &first, 8, &.{5}, 0)); // the unsalted learn it
+        try std.testing.expect(im.has(imprint.Imprint.keyOf(&harness)));
+    }
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.learned(), rules, 1 << 20);
+    defer s.deinit();
+    s.imprint = &im;
+    const second = harness ++ [_]u32{ 3, 4, 9 };
+    try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &second, 8, &.{5}, ka)); // A reads nothing back
+    try std.testing.expectEqual(@as(u32, 5), try request(&f, &s, a, &second, 8, &.{5}, 0)); // the unsalted do
+    try std.testing.expectEqual(s.entries.items.len, f.live);
+}
+
+test "another salt's longer state never supersedes a state: eviction takes the oldest instead" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const ka = pc.saltKey("tenant-a");
+    const kb = pc.saltKey("tenant-b");
+    const other = seq(20, 50); // history 13: 113 bytes (100 + at), the least recently used
+    const p = seq(20, 1); // 113 under A
+    var q: [26]u32 = undefined; // p's first 13 tokens and 13 more under B: its state at 19 extends A's
+    @memcpy(q[0..13], p[0..13]);
+    @memcpy(q[13..], &seq(13, 300));
+    for ([_]u64{ 340, 400 }) |budget| { // B's own room (B's prompt extends A's state); a later prompt's room
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 3 }, budget);
+        defer s.deinit();
+        _ = try request(&f, &s, a, &other, 13, &.{}, 0);
+        _ = try request(&f, &s, a, &p, 13, &.{}, ka);
+        try std.testing.expectEqual(@as(u32, 0), try request(&f, &s, a, &q, 19, &.{}, kb));
+        if (budget == 400) _ = try request(&f, &s, a, &seq(20, 70), 13, &.{}, 0);
+        try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+        try std.testing.expect(s.find(&other, &.{}, &.{}, 0) == null);
+        try std.testing.expectEqual(@as(u32, 13), s.find(&p, &.{}, &.{}, ka).?.at);
+        try std.testing.expectEqual(s.entries.items.len, f.live);
+    }
+}
+
+test "a lookup's rewind is its own salt's: another salt's state near it is no rewind and goes as the oldest" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const ka = pc.saltKey("tenant-a");
+    const kb = pc.saltKey("tenant-b");
+    const first = seq(10, 1); // history 8, its latest user message at 4
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 1 << 20); // min_gap 256: a state near the rewind serves
+    defer s.deinit();
+    _ = try request(&f, &s, a, first[0..5], 2, &.{}, ka); // A keeps a state at 2
+    f.salt = kb;
+    var plan = try s.beginRewind(a, &first, 8, 4, &.{}, &.{}, null, &.{}, kb);
+    try std.testing.expectEqualSlices(u32, &.{ 4, 8 }, plan.marks); // B's own rewind: A's state at 2 does not serve it
+    try std.testing.expectEqual(fresh(&first), f.pass(&s, &first, plan));
+    var g: Fake = .{ .gpa = gpa, .salt = ka };
+    var t = Store.init(gpa, g.snapshots(), .{ .min_prompt = 0 }, 330); // fake bytes 100 + at
+    defer t.deinit();
+    plan = try t.beginRewind(a, &first, 8, 4, &.{}, &.{}, null, &.{}, ka); // A's rewind at 4 (104) and history (108)
+    try std.testing.expectEqual(fresh(&first), g.pass(&t, &first, plan));
+    g.salt = kb;
+    plan = try t.beginRewind(a, &first, 8, 4, &.{}, &.{}, null, &.{}, kb); // B needs 212 more: one of A's goes first
+    try std.testing.expectEqual(@as(u64, 1), t.counts.evicted);
+    try std.testing.expectEqual(fresh(&first), g.pass(&t, &first, plan));
+    const edited = [_]u32{ 1, 2, 3, 4, 50, 6, 7, 8, 9, 10 };
+    try std.testing.expect(t.find(&edited, &.{}, &.{}, ka) == null); // A's rewind was the oldest, not B's rewind
+    try std.testing.expectEqual(@as(u32, 8), t.find(&first, &.{}, &.{}, ka).?.at);
+    try std.testing.expectEqual(t.entries.items.len, g.live);
+    var h: Fake = .{ .gpa = gpa, .salt = kb };
+    var u = Store.init(gpa, h.snapshots(), .{ .min_prompt = 0 }, 300);
+    defer u.deinit();
+    plan = try u.beginRewind(a, &first, 8, 4, &.{}, &.{}, null, &.{}, kb); // B's own rewind (104) and history (108)
+    try std.testing.expectEqual(fresh(&first), h.pass(&u, &first, plan));
+    const more = first[0..4].* ++ seq(16, 200); // past B's rewind: its keep at 13 needs 113 more, and B's history goes
+    try std.testing.expectEqual(fresh(&more), h.pass(&u, &more, .{ .marks = &.{13} }));
+    try std.testing.expectEqual(@as(u32, 4), u.find(&edited, &.{}, &.{}, kb).?.at); // B's rewind went last, as unsalted
+    try std.testing.expect(u.find(&first, &.{}, &.{}, kb).?.at != 8);
+    try std.testing.expectEqual(u.entries.items.len, h.live);
+}
+
+test "a pass makes room before it starts for a state another salt already holds at the same tokens" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 300); // fake bytes 100 + at
+    defer s.deinit();
+    const ka = pc.saltKey("tenant-a");
+    const kb = pc.saltKey("tenant-b");
+    _ = try request(&f, &s, a, &seq(20, 50), 13, &.{}, 0); // 113, the oldest
+    const t1 = seq(10, 1);
+    _ = try request(&f, &s, a, &t1, 8, &.{}, ka); // 108: 221 held
+    f.salt = kb;
+    const plan = try s.beginRewind(a, &t1, 8, 0, &.{}, &.{}, null, &.{}, kb); // B's own 108 at the same tokens
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted); // before the pass, so a peer hears of it with the request
+    try std.testing.expectEqual(fresh(&t1), f.pass(&s, &t1, plan));
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+    try std.testing.expectEqual(s.entries.items.len, f.live);
+}
+
+test "a store frees its states out of its list: a family's drop never sees the state it drops" {
+    const Family = struct {
+        store: ?*const Store = null,
+        live: usize = 0,
+        seen: bool = false, // a drop found its own state still in the store's list
+        fn snapshots(f: *@This()) pc.Snapshots {
+            return .{ .ptr = f, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop } };
+        }
+        fn bytes(_: *anyopaque, at: u32) u64 {
+            return 100 + at;
+        }
+        fn save(ptr: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+            const f: *@This() = @ptrCast(@alignCast(ptr));
+            f.live += 1;
+            const st = try std.testing.allocator.create(u32);
+            st.* = at;
+            return st;
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {}
+        fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+            const f: *@This() = @ptrCast(@alignCast(ptr));
+            for (f.store.?.entries.items) |e| f.seen = f.seen or e.saved == saved; // the list holds the states still kept
+            std.testing.allocator.destroy(@as(*u32, @ptrCast(@alignCast(saved))));
+            f.live -= 1;
+        }
+    };
+    var f: Family = .{};
+    var s = Store.init(std.testing.allocator, f.snapshots(), .{ .min_prompt = 0 }, 1 << 20);
+    f.store = &s;
+    for ([_]u64{ pc.saltKey("tenant-a"), 0 }) |salt| try std.testing.expect(s.keep(&seq(10, 1), 8, null, &.{}, &.{}, salt));
+    try std.testing.expectEqual(@as(usize, 2), f.live);
+    s.deinit();
+    try std.testing.expectEqual(@as(usize, 0), f.live);
+    try std.testing.expect(!f.seen);
+}
