+    for (runs, 1..) |run, id| {
+        const r: Request = .{ .prompt = &t1, .max_tokens = 4, .history_len = 8, .cache_salt = run.salt };
+        try std.testing.expectEqual(@as(?u32, run.cached), try Box.run(e, @intCast(id), &r));
+    }
+    try std.testing.expectEqual(@as(usize, 3), store.entries.items.len);
+    const t2 = t1 ++ [_]u32{ 7, 7 };
+    const warm: Request = .{ .prompt = &t2, .max_tokens = 0, .background = true, .history_len = t2.len, .cache_salt = ka };
+    _ = try Box.run(e, 6, &warm); // A's next turn prefilled in the background, kept at its end under A
+    try std.testing.expectEqual(ka, Snaps.salt);
+    const t3 = t2 ++ [_]u32{ 5, 3 };
+    for ([_]u64{ ka, 0, kb }, [_]u32{ 12, 8, 8 }, 7..) |salt, cached, id| { // only A resumes past the warm pass
+        const r: Request = .{ .prompt = &t3, .max_tokens = 4, .history_len = 12, .cache_salt = salt };
+        try std.testing.expectEqual(@as(?u32, cached), try Box.run(e, @intCast(id), &r));
+    }
+    try std.testing.expectEqual(@as(u64, 6), store.counts.hits);
+}
