+        }
+        for ([_][]const u8{ "\"\"", "123", "true", "[\"a\"]", "{\"a\":1}" }) |salt| {
+            var backend: Capture = .{};
+            try std.testing.expectEqual(@as(?u16, 400), try send(&backend, route, salt));
+            try std.testing.expectEqual(@as(usize, 0), backend.count);
+        }
+    }
+}
