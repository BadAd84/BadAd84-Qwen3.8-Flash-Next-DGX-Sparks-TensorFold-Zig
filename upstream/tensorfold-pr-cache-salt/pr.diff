+
+/// A request under `salt` (0 reply tokens: a background prompt-only pass); returns where its prompt pass started.
+fn salted(host: *serial.Host, ids: []const u32, history: u32, count: u32, salt: u64) !u32 {
+    var box: Box = .{};
+    const r = api.Request{ .prompt = ids, .max_tokens = count, .history_len = history, .cache_salt = salt, .background = count == 0 };
+    try host.engine().submit(1, &r, .{ .ctx = &box, .event = Box.event });
+    try box.wait();
+    return box.from;
+}
+
+test "a serial host keeps and resumes under the request's cache salt: its marks, its replies and its warm passes" {
+    const ka = pc.saltKey("tenant-a");
+    const kb = pc.saltKey("tenant-b");
+    const tokens = seedTokens();
+    var f: Fixture = .{};
+    var store = pc.Store.init(a, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 1 << 20);
+    defer store.deinit();
+    const host = try serial.Host.init(a, io, f.driver(&store, true));
+    defer host.deinit();
+    for ([_]u64{ ka, kb, 0 }) |salt| { // each keeps its history at 18 and its reply's end at 20, then resumes its own
+        try std.testing.expectEqual(@as(u32, 0), try salted(host, tokens[0..20], 18, 1, salt));
+        try std.testing.expectEqual(@as(u32, 18), try salted(host, tokens[0..20], 18, 1, salt));
+    }
+    try std.testing.expectEqual(@as(u32, 20), try salted(host, tokens[0..24], 22, 1, ka)); // A's next turn: past its reply
+    try std.testing.expectEqual(@as(u32, 24), try salted(host, tokens[0..26], 26, 0, ka)); // A's warm pass, kept at 26
+    try std.testing.expectEqual(@as(u32, 26), try salted(host, tokens[0..28], 27, 1, ka));
+    try std.testing.expectEqual(@as(u32, 20), try salted(host, tokens[0..28], 27, 1, 0)); // the unsalted: their reply's end
+}
