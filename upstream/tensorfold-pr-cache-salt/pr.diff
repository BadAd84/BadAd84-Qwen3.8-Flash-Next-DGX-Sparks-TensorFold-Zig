+        try std.testing.expect(!backend.warms[0]);
+        if (route == .completions) { // a completion warms no next turn
+            try std.testing.expectEqual(@as(usize, 1), backend.count);
+        } else { // the next turn's background pass keeps its state under the same salt
+            try std.testing.expectEqual(@as(usize, 2), backend.count);
+            try std.testing.expect(backend.warms[1]);
+            try std.testing.expectEqual(key, backend.salts[1]);
+        }
+    }
+}
+
+test "absent or null cache_salt is none; a non-string or empty one is a 400 that submits nothing" {
