* text=auto
# Text is stored with LF whatever the local core.autocrlf (a Windows git archive extraction once committed
# CRLF here). The lines below force LF in the working tree too, for what bash and the boxes run.
# Scripts and the files the box runs must be LF: with core.autocrlf=true a Windows checkout otherwise writes CRLF,
# bash rejects it, and build_qwen_ots.sh once put CRLF layer files into the image.
*.sh text eol=lf
*.py text eol=lf
*.env text eol=lf
*.service text eol=lf
# git bundles are binary: never normalised
*.bundle binary
