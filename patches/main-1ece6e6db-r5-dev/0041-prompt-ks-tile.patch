     return sys.environment.read(bool, "TF_FLASHNEXT_READOUT_FUSE", false);
 }
+
+/// TF_FLASHNEXT_PROMPT_KS_N=0: the prompt tile's own column block. 64 takes the captured prompt matmul's
+/// 64-column block and banded tile order (prompt_mm.py's _b16mm_ks BLOCK_N and GROUP) on the fused K-slice tile.
+/// 0 (the default) keeps the engine's 128-column prompt tile; the sums and bits are the same either way.
+pub fn promptKsN() sys.environment.Error!usize {
+    return sys.environment.read(usize, "TF_FLASHNEXT_PROMPT_KS_N", 0);
+}
+
+/// TF_FLASHNEXT_PROMPT_KS_GROUP=0: row tiles a band in the 64-column prompt tile's tile order (0: the engine's own
+/// sweep). Only read when TF_FLASHNEXT_PROMPT_KS_N selects the 64-column tile.
+pub fn promptKsGroup() sys.environment.Error!usize {
+    return sys.environment.read(usize, "TF_FLASHNEXT_PROMPT_KS_GROUP", 0);
+}
