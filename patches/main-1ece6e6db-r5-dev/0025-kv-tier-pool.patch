+/// --learn-conversations keeps a state in the prompt cache: a plan that leaves it no bytes is refused by name.
+pub fn learningRefusal(a: Allocator, o: api.Open, counted: Count, kept: kv_pages.Kept, room: u64, window: u64) !?[]const u8 {
+    if (!o.learn_conversations or o.learn == null or kept.copied > 0) return null;
+    const state: u64 = if (counted.layout) |l| l.snap_bytes + l.token_bytes *| window else 0;
+    const plain = "--learn-conversations keeps each conversation state in the prompt cache before its disk writer " ++
+        "takes it, and this shape's plan leaves the cache no bytes of the {d:.1} GiB the CUDA memory budget leaves: " ++
+        "serve with --prompt-cache-gib N, or without --learn-conversations";
+    const pooled = "--learn-conversations keeps each conversation state in the prompt cache before its disk writer " ++
+        "takes it, and this shape's plan leaves the cache no bytes: {d} streams take {d} pages of {d} rows of the " ++
+        "{d:.1} GiB the CUDA memory budget leaves; serve with --prompt-cache-gib N, where a state at the " ++
+        "{d}-token window takes about {d:.1} GiB, or without --learn-conversations";
+    if (counted.layout) |l| if (counted.paged) |p|
+        return try std.fmt.allocPrint(a, pooled, .{ p.lanes, p.pages, l.page_tokens, toGib(room), window, toGib(state) });
+    return try std.fmt.allocPrint(a, plain, .{toGib(room)});
+}
+
+test "CUDA cache default: a tier whose plan leaves the cache no bytes is refused by name" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const mib: u64 = 1 << 20;
+    // an INT4 checkpoint at --parallel 8 and a 262144-token window: 33.1 GiB left, 389 pages, no cache
+    const l: kv_pool.Layout = .{ .fixed_bytes = 0, .token_bytes = 18_880, .page_tokens = 4096, .snap_bytes = 113 * mib };
+    const counted: Count = .{ .streams = 8, .paged = .{ .lanes = 8, .snaps = 0, .copied = 0, .pages = 389 }, .layout = l };
+    const learning: api.Open = .{ .dir = "", .model_type = "qwen4_exp", .learn = "/cache/kv", .learn_conversations = true };
+    const none: kv_pages.Kept = .{ .snaps = 0, .copied = 0, .snap_bytes = 0 };
+    const why = (try learningRefusal(a, learning, counted, none, 33 << 30, 262_144)).?;
+    try std.testing.expect(std.mem.indexOf(u8, why, "389 pages of 4096 rows") != null);
+    try std.testing.expect(std.mem.indexOf(u8, why, "--prompt-cache-gib N") != null);
+    try std.testing.expect(std.mem.indexOf(u8, why, "4.7 GiB") != null); // 113 MiB plus 262144 x 18880 bytes
+    // a cache the plan leaves a byte of: nothing to refuse
+    try std.testing.expectEqual(@as(?[]const u8, null), try learningRefusal(a, learning, counted, .{ .snaps = 0, .copied = 1, .snap_bytes = 0 }, 33 << 30, 262_144));
+    // the tier off, or no root for its writer: neither is this refusal's business
+    var off = learning;
+    off.learn_conversations = false;
+    try std.testing.expectEqual(@as(?[]const u8, null), try learningRefusal(a, off, counted, none, 33 << 30, 262_144));
+    var rootless = learning;
+    rootless.learn = null;
+    try std.testing.expectEqual(@as(?[]const u8, null), try learningRefusal(a, rootless, counted, none, 33 << 30, 262_144));
+    // no pool: the message names the budget, never pages
+    const bare = (try learningRefusal(a, learning, .{ .streams = 1, .paged = null, .layout = null }, none, 8 << 30, 32_768)).?;
+    try std.testing.expect(std.mem.indexOf(u8, bare, "--prompt-cache-gib N") != null);
+    try std.testing.expect(std.mem.indexOf(u8, bare, "pages") == null);
+}
