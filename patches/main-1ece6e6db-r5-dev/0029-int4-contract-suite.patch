+    }
+    try std.testing.expect(std.mem.indexOf(u8, int4.symbols[1][2][1], "ILi128ELi4ELi2ELi1ELi0ELi4") != null);
+    try std.testing.expect(std.mem.indexOf(u8, int4.symbols[0][0][1], "ILi128ELi1ELi2ELi2ELi2ELi4") != null);
+}
