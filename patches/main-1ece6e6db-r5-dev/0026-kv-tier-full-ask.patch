+test "CUDA cache default: a family without snapshot slots budgets its whole ask, one that declares them still half" {
+    // no snap_slots: its states are copies, the cache the store's
+    const Copies = struct {
+        pub const snap_save = 1;
+    };
+    const Slots = struct {
+        pub const snap_save = 1;
+        pub const snap_slots = 1;
+    };
+    const o: api.Open = .{ .dir = "", .model_type = "qwen4_exp", .prompt_cache_gib = 6 };
+    // the served shape's layout: 18,880 bytes a token, 4,096-token pages, a state's 110.28 MiB fixed part
+    const l: @import("core").kv_pool.Layout = .{ .fixed_bytes = 0, .token_bytes = 18_880, .page_tokens = 4096, .snap_bytes = 115_642_368 };
+    var problem: []const u8 = "";
+    const copies = (try pool.plan(Copies, std.testing.allocator, l, 31 << 30, o, 262_144, &problem, false, false, 0, null)).?;
+    try t.expectEqual(@as(usize, 0), copies.snaps);
+    try t.expectEqual(@as(u64, 6 << 30), copies.copied); // the whole 6 GiB ask is the store's budget
+    const slots = (try pool.plan(Slots, std.testing.allocator, l, 31 << 30, o, 262_144, &problem, false, false, 0, null)).?;
+    try t.expectEqual(@as(usize, 27), slots.snaps); // a family that declares slots still reserves the half
+    try t.expectEqual(@as(u64, 3_320_107_008), slots.copied); // the /stats budget the kvtier-pool window read
+    try t.expectEqual(copies.pages, slots.pages); // the same pages: 2,977.7 MiB changes hands, not the plan
+    // a family that declares slots and names a count keeps exactly that many, as before
+    const named8 = (try pool.plan(Slots, std.testing.allocator, l, 31 << 30, o, 262_144, &problem, false, false, 0, 8)).?;
+    try t.expectEqual(@as(usize, 8), named8.snaps);
+    try t.expectEqual(@as(u64, (6 << 30) - 8 * 115_642_368), named8.copied);
+}
