+test "a cache whose family declares no slots reserves none: the whole ask is copies and the pages are unchanged" {
+    const g: u64 = 1 << 30;
+    // Flash Next at the 262,144-token window: a state's fixed part 115,642,400 B, the served 6 GiB ask
+    const fnx: kv.Layout = .{ .fixed_bytes = 0, .token_bytes = 18_880, .page_tokens = 4096, .snap_bytes = 115_642_368 };
+    const s = kv.split(6 * g, fnx.snap_bytes, 0); // a family that declares no snap_slots passes zero slots
+    try expectEqual(@as(usize, 0), s.snaps);
+    try expectEqual(6 * g, s.copied);
+    // the half a null still names for a family that declares slots: 27 of them at this size, 2,977.65 MiB
+    try expectEqual(@as(usize, 27), kv.split(6 * g, fnx.snap_bytes, null).snaps);
+    try expectEqual(6 * g - 27 * fnx.snap_bytes, kv.split(6 * g, fnx.snap_bytes, null).copied);
+    // the same pages either way: the slot half was never pages, so only the store's share of the cache changes hands
+    const none = try kv.plan(fnx, .{ .room = 31 * g, .engine = 5 * g, .lanes = 8, .cache = 6 * g, .snaps = 0, .asked = true });
+    const half = try kv.plan(fnx, .{ .room = 31 * g, .engine = 5 * g, .lanes = 8, .cache = 6 * g, .snaps = null, .asked = true });
+    try expectEqual(none.pages, half.pages);
+    try expectEqual(@as(usize, 0), none.snaps);
+    try expectEqual(6 * g, none.copied);
+    try expectEqual(@as(usize, 27), half.snaps);
+    try expectEqual(3_320_107_008, half.copied); // the budget the shipped store's /stats reported before this fix
+}
