+/// BF16 weight is coded into `scratch` instead: each 128x128 block at the least power of two that keeps it under 448.
+fn part(store: anytype, prefix: []const u8, i: usize, name: []const u8, n: usize, k: usize, scale: []f32, scratch: []u8) ![]const u8 {
