+    if (w.n != 4 * d or d % 32 != 0) return error.ReadoutShape;
+    var args: launch_.Args = .{};
+    args.add(x);
+    args.add(codes);
+    args.add(w.scale);
+    args.add(normed);
+    args.add(mixed);
+    args.add(xsm);
+    for ([_]usize{ m, d, w.k, w.npad, if (m == 1) w.k else ldx }) |v| args.add(@as(i32, @intCast(v)));
+    try launch_.launch(f, .{
+        .grid = .{ .x = @intCast((m + bm - 1) / bm * (d / 32)), .y = 1, .z = 1 },
+        .block = .{ .x = threads, .y = 1, .z = 1 },
+        .shared = smem,
+    }, s, &args);
