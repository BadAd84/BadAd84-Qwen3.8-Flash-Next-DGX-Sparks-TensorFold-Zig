+    const band = @max(1, @min(rows_t, (12 << 20) / (bm * w.k * 2)));
+    var args: launch_.Args = .{};
+    args.add(x);
+    args.add(codes);
+    args.add(w.scale);
+    args.add(act);
+    args.add(xs);
+    args.add(inj);
+    for ([_]usize{ m, w.n, w.k, sk, w.npad, if (m == 1) w.k else ldx, band, low, streams, has_inj }) |v| args.add(@as(i32, @intCast(v)));
+    try launch_.launch(f, .{
+        .grid = .{ .x = @intCast(rows_t * ((w.n + cols - 1) / cols)), .y = 1, .z = sk },
