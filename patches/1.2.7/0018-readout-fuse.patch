+TF_HCACT(tf_qmmf_hcact_bf16_32, BF16, 32, 64)
+TF_HCACT(tf_qmmf_hcact_bf16_64, BF16, 64, 64)
+TF_HCACT(tf_qmmf_hcact_q12_16, Q12, 16, 32)
+TF_HCACT(tf_qmmf_hcact_q12_32, Q12, 32, 64)
+#undef TF_HCACT
+
+// The read-out up with fn_hc_dense_mix8 in its epilogue: a block takes one 32-column group of all four streams, warp
+// s stream s, each column's m16n8k16 chain as the lane's one-slice tile runs it (BF16 words staged, or the 12-bit
+// blocks two groups ahead); the up rows round to bf16 as the lane stores them, then mix and sum as fn_hc_dense_mix8.
+template <int MODE, int BM>
+__device__ __forceinline__ void upmix_body(
+        const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w, float scale,
+        const __nv_bfloat16* __restrict__ normed, __nv_bfloat16* __restrict__ mixed, float* __restrict__ xsm, int M,
+        int D, int K, int npad, int ldx) {
+    static_assert(MODE == BF16 || MODE == Q12, "the read-out up is BF16 or its 12-bit copy");
+    constexpr int SS = 4, NT = 4, MT = BM / 16, STAGES = BM == 64 ? 2 : 3;
+    constexpr int ROW = GS * 2, CHUNKS = ROW / 16, XB = BM * ROW, HALF = 32 * GS * 2, TILE_BYTES = 64 * GS * 2;
+    constexpr int STAGE = (XB + (MODE == BF16 ? SS * HALF : 0) + 127) / 128 * 128;
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int groups = D / 32, m0 = static_cast<int>(blockIdx.x) / groups * BM, d0 = static_cast<int>(blockIdx.x) % groups * 32;
+    const int KG = K / GS, c0 = warp * D + d0, tile = c0 / 64, half = c0 % 64 / 32;
+    auto stage = [&](int s) { return buf + s * STAGE; };
+    auto load = [&](int s, int g) {
+        unsigned char* p = stage(s);
+        for (int c = tid; c < BM * CHUNKS; c += 128) {
+            const int r = c / CHUNKS, ch = c % CHUNKS;
+            const int row = min(m0 + r, M - 1);
+            cp16z(p + r * ROW + swz<CHUNKS>(r, ch) * 16, x + static_cast<size_t>(row) * ldx + g * GS + ch * 8, m0 + r < M);
+        }
+        if constexpr (MODE == BF16) {
+            unsigned char* pw = p + XB + warp * HALF;  // this stream's half of its 64-column tile, as the half tile reads it
+            for (int c = lane; c < HALF / 16; c += 32)
+                cp16(pw + c * 16, w + (static_cast<size_t>(tile) * KG + g) * TILE_BYTES + half * (TILE_BYTES / 2) + c * 16);
+        }
+    };
+    float acc[MT][NT][4];
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+        for (int j = 0; j < NT; ++j)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+    [[maybe_unused]] tf_qmmf_q12::Raw qr[MODE == Q12 ? NT : 1], qn[MODE == Q12 ? NT : 1];
+    [[maybe_unused]] const tf_qmmf_q12::View qv = tf_qmmf_q12::view(w, npad, K);
+    const uint32_t qb = uint32_t(tile) * uint32_t(KG) * 8 + uint32_t(half * 4);  // group g's first block: qb + 8 g
+    if constexpr (MODE == Q12) {
+        tf_qmmf_q12::warp_load(qr, qv, qb, lane);
+        if (KG > 1) tf_qmmf_q12::warp_load(qn, qv, qb + 8, lane);
+    }
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s) {
+        if (s < KG) load(s, s);
+        commit();
+    }
+    for (int it = 0; it < KG; ++it) {
+        uint32_t bw[MODE == Q12 ? NT : 1][8];
+        if constexpr (MODE == Q12) {
+            tf_qmmf_q12::warp_decode(bw, qr, qv, qb + 8 * uint32_t(it), lane);
+#pragma unroll
+            for (int j = 0; j < NT; ++j) qr[j] = qn[j];
+            if (it + 2 < KG) tf_qmmf_q12::warp_load(qn, qv, qb + 8 * uint32_t(it + 2), lane);
+        }
+        wait<STAGES - 2>();
+        __syncthreads();
+        const int next = it + STAGES - 1;
+        if (next < KG) load(next % STAGES, next);
+        commit();
+        const unsigned char* p = stage(it % STAGES);
+        const unsigned char* pw = p + XB + warp * HALF;
+#pragma unroll
+        for (int kt = 0; kt < GS / 16; ++kt) {
+            uint32_t a[MT][4];
+#pragma unroll
+            for (int i = 0; i < MT; ++i) {
+                const int r = i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+                const int ch = kt * 2 + (lane >> 4);
+                ldmatrix4(a[i], p + r * ROW + swz<CHUNKS>(r, ch) * 16);
+            }
+#pragma unroll
+            for (int j = 0; j < NT; ++j) {
+                uint32_t b0, b1;
+                if constexpr (MODE == BF16) {
+                    const uint2 v = reinterpret_cast<const uint2*>(pw)[(j * 4 + kt) * 32 + lane];
+                    b0 = v.x;
+                    b1 = v.y;
+                } else {
+                    b0 = bw[j][2 * kt];
+                    b1 = bw[j][2 * kt + 1];
+                }
+#pragma unroll
+                for (int i = 0; i < MT; ++i) mma(acc[i][j], a[i], b0, b1);
+            }
+        }
+    }
+    wait<0>();
+    __syncthreads();
+    float* up_s = reinterpret_cast<float*>(buf);  // [BM][SS][32]: the up rows as the lane stores them
+    float* mix_s = up_s + BM * SS * 32;           // [BM][32]: the mixed rows before their bf16 store
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+        for (int j = 0; j < NT; ++j)
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int rl = i * 16 + (lane >> 2) + h * 8, cl = j * 8 + (lane & 3) * 2;
+                up_s[(rl * SS + warp) * 32 + cl] = __bfloat162float(__float2bfloat16_rn(acc[i][j][2 * h] * scale));
+                up_s[(rl * SS + warp) * 32 + cl + 1] = __bfloat162float(__float2bfloat16_rn(acc[i][j][2 * h + 1] * scale));
+            }
+    __syncthreads();
+    for (int t = tid; t < BM * 32; t += 128) {
+        const int rl = t / 32, c = t % 32, row = m0 + rl, d = d0 + c;
+        float mv = 0.0f;
+        if (row < M) {
+            float total = 0.0f;
+            for (int st = 0; st < SS; ++st) {
+                const float nv = tf_glue::bf(normed[(static_cast<size_t>(row) * SS + st) * D + d]);
+                total = __fadd_rn(total, tf_glue::rbf(__fmul_rn(hc_bsig(up_s[(rl * SS + st) * 32 + c]), nv)));
+            }
+            mv = tf_glue::rbf(__fdiv_rn(total, static_cast<float>(SS)));
+            mixed[static_cast<size_t>(row) * D + d] = __float2bfloat16_rn(mv);
+        }
+        mix_s[rl * 32 + c] = mv;
+    }
+    __syncthreads();
+    for (int rl = tid; rl < BM; rl += 128) {
+        const int row = m0 + rl;
+        if (row >= M) continue;
+        float sum = 0.0f;
+        for (int k = 0; k < 32; ++k) sum = __fadd_rn(sum, mix_s[rl * 32 + k]);
+        xsm[static_cast<size_t>(row) * groups + d0 / 32] = sum;
+    }
+}
+#define TF_UPMIX(NAME, MODE, BM) \
+extern "C" __global__ void __launch_bounds__(128) NAME( \
+        const __nv_bfloat16* x, const unsigned char* w, float scale, const __nv_bfloat16* normed, \
+        __nv_bfloat16* mixed, float* xsm, int M, int D, int K, int npad, int ldx) { \
+    upmix_body<MODE, BM>(x, w, scale, normed, mixed, xsm, M, D, K, npad, ldx); \
+}
+TF_UPMIX(tf_qmmf_upmix_bf16_16, BF16, 16)
+TF_UPMIX(tf_qmmf_upmix_bf16_32, BF16, 32)
+TF_UPMIX(tf_qmmf_upmix_bf16_64, BF16, 64)
+TF_UPMIX(tf_qmmf_upmix_q12_16, Q12, 16)
+TF_UPMIX(tf_qmmf_upmix_q12_32, Q12, 32)
+#undef TF_UPMIX
