+#define TF_HCACT(NAME, MODE, BM, BN) \
+extern "C" __global__ void __launch_bounds__(128) NAME( \
+        const __nv_bfloat16* x, const unsigned char* w, float scale, __nv_bfloat16* act, float* xs, \
+        __nv_bfloat16* inj, int M, int N, int K, int SK, int npad, int ldx, int group, int low, int S, int has_inj) { \
+    hcact_body<MODE, BM, BN>(x, w, scale, act, xs, inj, M, N, K, SK, npad, ldx, group, low, S, has_inj); \
+}
