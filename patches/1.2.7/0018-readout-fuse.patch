+// The read-out down with fn_hc_reduce_act in its epilogue: the cluster kernel's tile, K slices and sums, then the act,
+// the inject gates and the act's 32-column sums from the f32 row the reduce would have read.
+template <int MODE, int BM, int BN>
+__device__ __forceinline__ void hcact_body(
+        const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w, float scale,
+        __nv_bfloat16* __restrict__ act, float* __restrict__ xs, __nv_bfloat16* __restrict__ inj, int M, int N, int K,
+        int SK, int npad, int ldx, int group, int low, int S, int has_inj) {
+    constexpr int WM = 1, WN = 4, STAGES = 4;
+    constexpr bool F32 = true, CLUSTER = true, FUSE = false;
+    [[maybe_unused]] const uint8_t* bs = nullptr;
+    [[maybe_unused]] void* out = nullptr;
+    [[maybe_unused]] float* part = nullptr;
