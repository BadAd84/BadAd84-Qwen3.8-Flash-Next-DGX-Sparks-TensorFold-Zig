+__device__ __forceinline__ int kv8_page_slot(const Pg& pg, int pos, int nkv, int kvh, long long& page) {
+    page = static_cast<long long>(pg.pt[pos / pg.ptok]) * (2 * pg.ps);
+    return (pos % pg.ptok) * nkv + kvh;
