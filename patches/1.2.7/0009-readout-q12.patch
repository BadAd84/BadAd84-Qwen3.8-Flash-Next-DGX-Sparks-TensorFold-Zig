diff --git a/zig/kernels/cuda/qmmf_q12.cuh b/zig/kernels/cuda/qmmf_q12.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..818e2aec0f184e1ae1c7de217b755bcb3967c551
--- /dev/null
+++ b/zig/kernels/cuda/qmmf_q12.cuh
@@ -0,0 +1,106 @@
+// The BF16 lane weights' lossless 12-bit copy: a sign and mantissa byte a weight, 4-bit exponents, exact escapes.
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace tf_qmmf_q12 {
+
+// A block is one n8 tile of one 64-input group: 512 weights, 16 a lane, in the BF16 tile's own word order.
+constexpr int SM = 512;
+
+// Bytes a block spends on its 4-bit exponent offsets, and on the top exponent of each of its 8 rows.
+constexpr int EX = 256;
+constexpr int BASE = 8;
+constexpr int HEAD = SM + EX + BASE;
+
+struct View {
+    const uint4* sm;
+    const uint2* ex;
+    const uint8_t* base;
+    const uint32_t* escoff;
+    const uint32_t* esc;
+};
+
+// The arrays of a [npad, K] copy, in the order qmmf_q12.zig's pack writes them.
+__device__ __forceinline__ View view(const unsigned char* p, int npad, int K) {
+    const size_t n = size_t(npad / 8) * (K / 64);
+    View v;
+    v.sm = reinterpret_cast<const uint4*>(p);
+    v.ex = reinterpret_cast<const uint2*>(p + n * SM);
+    v.base = p + n * (SM + EX);
+    v.escoff = reinterpret_cast<const uint32_t*>(p + n * HEAD);
+    v.esc = v.escoff + n + 1;
+    return v;
+}
+
+struct Raw {
+    uint4 sm;
+    uint2 ex;
+    uint32_t base;
+};
+
+__device__ __forceinline__ void load(Raw& r, const View& w, uint32_t blk, int lane) {
+    const size_t i = size_t(blk) * 32 + lane;
+    r.sm = __ldg(w.sm + i);
+    r.ex = __ldg(w.ex + i);
+    r.base = __ldg(w.base + size_t(blk) * 8 + (lane >> 2));
+}
+
+// The exact bits of the weight at `pos` (16 lane + j) in this block's escape list, which is ordered by position.
+__device__ __noinline__ uint32_t escape_bits(const uint32_t* esc, uint32_t e0, uint32_t e1, uint32_t pos) {
+    for (uint32_t e = e0; e < e1; ++e) {
+        const uint32_t v = __ldg(esc + e);
+        if ((v >> 16) == pos) return v & 0xFFFFu;
+    }
+    return 0;
+}
+
+// A lane's 16 weights as its 4 k16 chunks' operand pairs (chunk c is o[2 c] then o[2 c + 1]).
+__device__ __forceinline__ void decode(uint32_t (&o)[8], const Raw& r, const View& w, uint32_t blk, int lane) {
+    const uint32_t sw[4] = {r.sm.x, r.sm.y, r.sm.z, r.sm.w};
+    // the row's top exponent in both halves, a guard bit above each so the subtraction never borrows across them
+    const uint32_t bwd = (r.base * 0x00800080u) | 0x80008000u;
+#pragma unroll
+    for (int p = 0; p < 8; ++p) {
+        const uint32_t sa = 2u * (p & 1), sb = sa + 1u;
+        // the stored sign and mantissa bytes into bytes 0 and 2, their signs replicated into bytes 1 and 3
+        const uint32_t x = __byte_perm(sw[p >> 1], 0u, sa | ((sa | 8u) << 4) | (sb << 8) | ((sb | 8u) << 12));
+        const uint32_t z = __byte_perm(r.ex.x, r.ex.y, uint32_t(p & 3) | (uint32_t(4 + (p & 3)) << 8));
+        const uint32_t off = p < 4 ? (z & 0x000F000Fu) * 128u : (z & 0x00F000F0u) * 8u;
+        o[p] = (x & 0x807F807Fu) | ((bwd - off) & 0x7F807F80u);
+    }
+    const uint32_t mx = r.ex.x & (r.ex.x >> 1) & (r.ex.x >> 2) & (r.ex.x >> 3) & 0x11111111u;
+    const uint32_t my = r.ex.y & (r.ex.y >> 1) & (r.ex.y >> 2) & (r.ex.y >> 3) & 0x11111111u;
+    if (mx | my) {
+        const uint32_t e0 = __ldg(w.escoff + blk), e1 = __ldg(w.escoff + blk + 1);
+#pragma unroll 1
+        for (int c = 0; c < 16; ++c) {
+            const uint32_t h = c >> 3, nib = c & 7;
+            if (!(((h ? my : mx) >> (4 * nib)) & 1)) continue;
+            const int p = (nib >> 1) + 4 * (nib & 1), j = 2 * p + h;
+            const uint32_t bits = escape_bits(w.esc, e0, e1, uint32_t(16 * lane + j));
+            const uint32_t sh = 16u * h, keep = ~(0xFFFFu << sh);
+#pragma unroll
+            for (int pp = 0; pp < 8; ++pp) o[pp] = pp == p ? ((o[pp] & keep) | (bits << sh)) : o[pp];
+        }
+    }
+}
+
+// The warp's n8 tiles of one 64-input group, decoded: the block at column tile n0 / 64, group g, tile wn NT + j.
+template <int NT>
+__device__ __forceinline__ void warp_tiles(uint32_t (&o)[NT][8], const unsigned char* p, int npad, int K, int n0,
+                                           int g, int wn, int lane) {
+    const View w = view(p, npad, K);
+    const uint32_t first = (uint32_t(n0 / 64) * uint32_t(K / 64) + uint32_t(g)) * 8 + uint32_t((n0 % 64) / 32 * 4);
+#pragma unroll
+    for (int j = 0; j < NT; ++j) {
+        const uint32_t blk = first + uint32_t(wn * NT + j);
+        Raw r;
+        load(r, w, blk, lane);
+        decode(o[j], r, w, blk, lane);
+    }
+}
+
+}  // namespace tf_qmmf_q12
