index 0000000000000000000000000000000000000000..769f47ee78a60d69dc2ce8cb8668ec8c6f377df0
--- /dev/null
+++ b/zig/src/cuda/qmmf_q12.zig
@@ -0,0 +1,291 @@
+//! A BF16 lane weight's lossless 12-bit copy (qmmf_q12.cuh): the image it packs into, and the tiles that read it.
+const std = @import("std");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const qmmf = @import("qmmf.zig");
+
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// Bytes a block spends on its weights' sign and mantissa bytes, their 4-bit offsets, and its 8 rows' top exponents.
+pub const sm_bytes = 512;
+pub const ex_bytes = 256;
+pub const base_bytes = 8;
+pub const head_bytes = sm_bytes + ex_bytes + base_bytes;
+
+/// The row tiles these instances carry: a window of up to this many rows reads the copy, wider passes the weights.
+pub const max_rows = 32;
+
+/// A weight is escaped when its exponent is further below its row's top exponent than a 4-bit offset can say.
+pub const max_offset = 14;
+
+/// The column of each of a lane's 16 weights inside its 64-input group, by weight index (4 k16 chunks of 4).
+const cols: [16]usize = blk: {
+    var c: [16]usize = undefined;
+    for (&c, 0..) |*v, j| v.* = (j >> 2) * 16 + (j & 1) + 8 * ((j & 2) >> 1);
+    break :blk c;
+};
+
+const Slot = struct { q: u8, j: u8 };
+
+/// The lane and weight index each of a row's 64 inputs belongs to: `cols` read the other way round.
+const slot: [64]Slot = blk: {
+    var s: [64]Slot = undefined;
+    for (0..4) |q| for (cols, 0..) |c, j| {
+        s[2 * q + c] = .{ .q = q, .j = j };
+    };
+    break :blk s;
+};
+
+/// Blocks of a [npad, k] copy: one n8 tile of one 64-input group each, numbered as packBf16 orders its words.
+pub fn blocks(npad: usize, k: usize) usize {
+    return (npad / 8) * (k / qmmf.group);
+}
+
+/// Bytes of the image: the blocks' arrays, their escape offsets, then the escaped weights' exact bits.
+pub fn bytes(npad: usize, k: usize, escapes: usize) usize {
+    const n = blocks(npad, k);
+    return n * head_bytes + (n + 1) * 4 + escapes * 4;
+}
+
+/// The [n, k] row and column of weight `j` of `lane` in block `blk`; a row past n is the tile's zero padding.
+pub fn at(blk: usize, lane: usize, j: usize, k: usize) struct { row: usize, col: usize } {
+    const kg = k / qmmf.group;
+    const tg = blk / 8;
+    return .{
+        .row = (tg / kg) * 64 + (blk % 8) * 8 + lane / 4,
+        .col = (tg % kg) * qmmf.group + 2 * (lane % 4) + cols[j],
+    };
+}
+
+fn exponent(v: u16) u8 {
+    return @intCast((v >> 7) & 0xFF);
+}
+
+/// Escapes the image holds: the count its last offset carries.
+pub fn escapeCount(image: []const u8, npad: usize, k: usize) usize {
+    const nb = blocks(npad, k);
+    return std.mem.readInt(u32, image[nb * head_bytes + nb * 4 ..][0..4], .little);
+}
+
+/// One block row's 64 inputs into the lanes' bytes and offsets, its escaped weights onto `esc`.
+fn packRow(head: []u8, esc: *std.ArrayList(u32), gpa: std.mem.Allocator, span: []const u8, nb: usize, blk: usize, g: usize) !void {
+    var v: [64]u16 = @splat(0);
+    var base: u8 = 0;
+    for (&v, 0..) |*o, c| {
+        if (span.len != 0) o.* = std.mem.readInt(u16, span[c * 2 ..][0..2], .little);
+        base = @max(base, exponent(o.*));
+    }
+    head[nb * (sm_bytes + ex_bytes) + blk * 8 + g] = base;
+    const sm = head[blk * sm_bytes + 4 * g * 16 ..][0..64];
+    const ex = head[nb * sm_bytes + blk * ex_bytes + 4 * g * 8 ..][0..32];
+    @memset(ex, 0);
+    for (v, slot) |x, s| {
+        const q: usize = s.q;
+        const j: usize = s.j;
+        const below = @as(u16, base) - exponent(x);
+        const code: u8 = if (below > max_offset) 15 else @intCast(below);
+        sm[q * 16 + j] = @intCast(((x >> 8) & 0x80) | (x & 0x7F));
+        ex[q * 8 + 4 * (j & 1) + ((j >> 1) & 3)] |= code << @intCast(4 * (j >> 3));
+        if (code != 15) continue;
+        const pos: u32 = @intCast(16 * (4 * g + q) + j);
+        try esc.append(gpa, pos << 16 | @as(u32, x));
+    }
+}
+
+/// The 12-bit image of the BF16 [n, k] rows `w` padded to `npad`: one pass, its escapes gathered as it is written.
+pub fn pack(gpa: std.mem.Allocator, w: []const u8, n: usize, k: usize, npad: usize) ![]u8 {
+    std.debug.assert(w.len == n * k * 2 and k % qmmf.group == 0 and npad % 128 == 0);
+    const nb = blocks(npad, k);
+    const head_len = nb * head_bytes + (nb + 1) * 4;
+    const head = try gpa.alloc(u8, head_len);
+    defer gpa.free(head);
+    var esc: std.ArrayList(u32) = .empty;
+    defer esc.deinit(gpa);
+    for (0..nb) |blk| {
+        std.mem.writeInt(u32, head[nb * head_bytes + blk * 4 ..][0..4], @intCast(esc.items.len), .little);
+        for (0..8) |g| {
+            const p = at(blk, 4 * g, 0, k);
+            const span: []const u8 = if (p.row < n) w[(p.row * k + p.col) * 2 ..][0..128] else &.{};
+            try packRow(head, &esc, gpa, span, nb, blk, g);
+        }
+    }
+    std.mem.writeInt(u32, head[nb * head_bytes + nb * 4 ..][0..4], @intCast(esc.items.len), .little);
+    const image = try gpa.alloc(u8, head_len + esc.items.len * 4);
+    @memcpy(image[0..head_len], head);
+    @memcpy(image[head_len..], std.mem.sliceAsBytes(esc.items));
+    return image;
+}
+
+/// The weight the image holds at `j` of `lane` in `blk`, read back the way qmmf_q12.cuh's decode reads it.
+pub fn word(image: []const u8, npad: usize, k: usize, blk: usize, lane: usize, j: usize) u16 {
+    const nb = blocks(npad, k);
+    const sm = image[blk * sm_bytes + lane * 16 + j];
+    const ex = image[nb * sm_bytes + blk * ex_bytes + lane * 8 + 4 * (j & 1) + ((j >> 1) & 3)];
+    const code: u8 = @intCast((ex >> @intCast(4 * (j >> 3))) & 0xF);
+    if (code == 15) {
+        const e0 = std.mem.readInt(u32, image[nb * head_bytes + blk * 4 ..][0..4], .little);
+        const e1 = std.mem.readInt(u32, image[nb * head_bytes + (blk + 1) * 4 ..][0..4], .little);
+        const list = nb * head_bytes + (nb + 1) * 4;
+        for (e0..e1) |e| {
+            const v = std.mem.readInt(u32, image[list + e * 4 ..][0..4], .little);
+            if (v >> 16 == 16 * lane + j) return @truncate(v);
+        }
+        return 0;
+    }
+    const base = image[nb * (sm_bytes + ex_bytes) + blk * 8 + lane / 4];
+    return (@as(u16, sm & 0x80) << 8) | (@as(u16, base - code) << 7) | @as(u16, sm & 0x7F);
+}
+
+/// qmmf.cu's Q12 instances: row tiles 16 and 32 at 64 columns, and the 16-row half tile, each plain then clustered.
+fn symbol(comptime bm: u32, comptime bn: u32, comptime wide: bool, comptime cluster: bool) [:0]const u8 {
+    const name = "_ZN7tf_qmmf11qmmf_kernelILi5ELi{d}ELi{d}ELi1ELi4ELi4ELb{d}ELb{d}ELb0" ++
+        "EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiii";
+    return std.fmt.comptimePrint(name, .{ bm, bn, @intFromBool(wide), @intFromBool(cluster) });
+}
+
+/// Dynamic shared bytes of a 12-bit tile: the inputs' stages alone, its weights coming straight from global memory.
+pub fn sharedBytes(bm: u32, bn: u32) u32 {
+    const stage = (bm * qmmf.group * 2 + 127) / 128 * 128;
+    const partials = (bm / 16) * (bn / 32) * 4 * 128 * 4;
+    return @max(4 * stage, partials);
+}
+
+const row_tiles = [_]u32{ 16, 32 };
+
+pub const Lane = struct {
+    /// By row tile, then output kind, then plain or clustered; `half` is the 16-row tile at 32 columns.
+    fns: [row_tiles.len][2][2]Function,
+    half: [2][2]Function,
+    reduce: [2]Function,
+
+    /// The instances of an already loaded qmmf module; an image without them refuses here, not at the first launch.
+    pub fn load(mod: Module) !Lane {
+        var l: Lane = undefined;
+        inline for (row_tiles, 0..) |bm, ti| inline for (.{ false, true }, 0..) |wide, oi| inline for (.{ false, true }, 0..) |cl, ci| {
+            const f = try mod.function(symbol(bm, 64, wide, cl));
+            try f.allowDynamicShared(sharedBytes(bm, 64));
+            l.fns[ti][oi][ci] = f;
+        };
+        inline for (.{ false, true }, 0..) |wide, oi| inline for (.{ false, true }, 0..) |cl, ci| {
+            const f = try mod.function(symbol(16, 32, wide, cl));
+            try f.allowDynamicShared(sharedBytes(16, 32));
+            l.half[oi][ci] = f;
+        };
+        for (&l.reduce, qmmf.reduce_symbols) |*f, name| f.* = try mod.function(name);
+        return l;
+    }
+
+    /// qmmf.Lane.matmulOut over `image`, the weight's 12-bit copy: the same tile, slices, sums and epilogue.
+    pub fn matmulOut(l: Lane, s: Stream, x: u64, ldx: usize, m: usize, w: qmmf.Weight, image: u64, y: u64, out: qmmf.Out, part: u64, clusters: bool, half_below: usize) !void {
+        const p = qmmf.planFor(m, w, clusters);
+        if (p.fused or p.bm > max_rows) return error.LaneRows;
+        if (p.reduce and part == 0) return error.MissingLanePart;
+        const rows_t = (m + p.bm - 1) / p.bm;
+        const half = p.bm == 16 and rows_t * ((w.n + 63) / 64) * p.sk < half_below;
+        const cols_n: u32 = if (half) 32 else 64;
+        const f = if (half) l.half[@backingInt(out)][@intFromBool(p.cluster)] else l.fns[@intFromBool(p.bm == 32)][@backingInt(out)][@intFromBool(p.cluster)];
+        const band = @max(1, @min(rows_t, (12 << 20) / (@as(usize, p.bm) * w.k * 2)));
+        var args: launch_.Args = .{};
+        args.add(x);
+        args.add(image);
+        args.add(@as(u64, 0));
+        args.add(w.scale);
+        args.add(y);
+        args.add(if (p.reduce) part else @as(u64, 0));
+        args.add(@as(i32, @intCast(m)));
+        args.add(@as(i32, @intCast(w.n)));
+        args.add(@as(i32, @intCast(w.k)));
+        args.add(@as(i32, @intCast(p.sk)));
+        args.add(@as(i32, @intCast(w.npad)));
+        args.add(@as(i32, @intCast(if (m == 1) w.k else ldx)));
+        args.add(@as(i32, @intCast(band)));
+        try launch_.launch(f, .{
+            .grid = .{ .x = @intCast(rows_t * ((w.n + cols_n - 1) / cols_n)), .y = 1, .z = p.sk },
+            .block = .{ .x = 128, .y = 1, .z = 1 },
+            .shared = sharedBytes(p.bm, cols_n),
+            .cluster = if (p.cluster) .{ .x = 1, .y = 1, .z = p.sk } else null,
+        }, s, &args);
+        if (!p.reduce) return;
+        const total: usize = m * w.n;
+        var r: launch_.Args = .{};
+        r.add(part);
+        r.add(y);
+        r.add(@as(i64, @intCast(total)));
+        r.add(@as(i32, @intCast(p.sk)));
+        r.add(w.scale);
+        try launch_.launch(l.reduce[@backingInt(out)], .{
+            .grid = .{ .x = @intCast((total + 255) / 256), .y = 1, .z = 1 },
+            .block = .{ .x = 256, .y = 1, .z = 1 },
+        }, s, &r);
+    }
+};
+
+const testing = std.testing;
+
+/// Every weight of the image read back, against the BF16 words the lane tile would have read in its place.
+fn roundTrip(gpa: std.mem.Allocator, w: []const u16, n: usize, k: usize) !usize {
+    const npad = (n + 127) / 128 * 128;
+    const tiled = try gpa.alloc(u16, npad * k);
+    defer gpa.free(tiled);
+    qmmf.packBf16(tiled, w, n, k);
+    const image = try pack(gpa, std.mem.sliceAsBytes(w), n, k, npad);
+    defer gpa.free(image);
+    try testing.expectEqual(bytes(npad, k, escapeCount(image, npad, k)), image.len);
+    for (0..blocks(npad, k)) |blk| for (0..32) |lane| for (0..16) |j| {
+        const want = tiled[blk * 512 + (j >> 2) * 128 + lane * 4 + (j & 3)];
+        try testing.expectEqual(want, word(image, npad, k, blk, lane, j));
+    };
+    return escapeCount(image, npad, k);
+}
+
+test "the copy gives back every bf16 bit pattern the BF16 tile would have read" {
+    const gpa = testing.allocator;
+    const n = 1024;
+    const k = 64;
+    const w = try gpa.alloc(u16, n * k);
+    defer gpa.free(w);
+    for (w, 0..) |*v, i| v.* = @truncate(i);
+    _ = try roundTrip(gpa, w, n, k);
+}
+
+test "rows past n, zeros and exponents far below their row's top survive as escapes" {
+    const gpa = testing.allocator;
+    const n = 324;
+    const k = 640;
+    const w = try gpa.alloc(u16, n * k);
+    defer gpa.free(w);
+    var prng = std.Random.DefaultPrng.init(0x12b0c12);
+    const r = prng.random();
+    // a checkpoint's own shape: one row's exponents within a few binades, with exact zeros among them
+    for (w) |*v| v.* = if (r.uintLessThan(u32, 50) == 0) 0 else @as(u16, r.int(u1)) << 15 | @as(u16, r.intRangeAtMost(u8, 118, 127)) << 7 | r.int(u7);
+    try testing.expect(try roundTrip(gpa, w, n, k) > 0);
+}
+
+test "a narrow row escapes nothing and its image is three quarters of the weights" {
+    const gpa = testing.allocator;
+    const n = 128;
+    const k = 128;
+    const w = try gpa.alloc(u16, n * k);
+    defer gpa.free(w);
+    var prng = std.Random.DefaultPrng.init(7);
+    const r = prng.random();
+    for (w) |*v| v.* = @as(u16, r.int(u1)) << 15 | @as(u16, r.intRangeAtMost(u8, 120, 127)) << 7 | r.int(u7);
+    try testing.expectEqual(@as(usize, 0), try roundTrip(gpa, w, n, k));
+    try testing.expectEqual(@as(usize, 24_964), bytes(n, k, 0)); // 32 blocks of 512 weights: 776 bytes each, plus offsets
+}
+
+test "block numbering and the bytes of a copy follow the tile's own order" {
+    try testing.expectEqual(@as(usize, 7680), blocks(384, 10240));
+    const first = at(0, 0, 0, 10240);
+    try testing.expect(first.row == 0 and first.col == 0);
+    // block 8 is the next 64-input group of the same column tile: the same rows, 64 inputs along
+    const next = at(8, 5, 3, 10240);
+    try testing.expect(next.row == 1 and next.col == 64 + 2 + 9);
+    // block 1 is the next n8 tile of the first group: its rows are 8 to 15
+    try testing.expectEqual(@as(usize, 8), at(1, 0, 0, 10240).row);
+    try testing.expectEqual(@as(u8, 1), slot[2].q);
+    try testing.expectEqual(@as(u8, 2), slot[8].j);
+}
