diff --git a/zig/src/families/flashnext/cuda_hc_q12.zig b/zig/src/families/flashnext/cuda_hc_q12.zig
new file mode 100644
index 0000000000000000000000000000000000000000..50d7befd80c87e7f4b23e432e58ef16b96b79af4
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_hc_q12.zig
@@ -0,0 +1,105 @@
+//! The read-out matrices' lossless 12-bit copies (TF_FLASHNEXT_HC_Q12) and the boot check that they read back equal.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const q12 = cuda.qmmf_q12;
+
+/// What the copies cost and hold, for the boot line: the matrices, their BF16 and 12-bit bytes, and their escapes.
+pub const Stats = struct { matrices: usize = 0, bf16: usize = 0, q12: usize = 0, escapes: usize = 0 };
+
+pub var stats: Stats = .{};
+
+var cached: ?bool = null;
+
+/// TF_FLASHNEXT_HC_Q12=1 builds the copies, 0 or unset keeps the BF16 weights; any other value refuses the start.
+pub fn on() !bool {
+    if (cached) |v| return v;
+    const v = std.c.getenv("TF_FLASHNEXT_HC_Q12") orelse {
+        cached = false;
+        return false;
+    };
+    const s = std.mem.span(v);
+    if (std.mem.eql(u8, s, "1") or std.mem.eql(u8, s, "0")) {
+        cached = s[0] == '1';
+        return cached.?;
+    }
+    std.log.err("TF_FLASHNEXT_HC_Q12 is \"{s}\": it takes 1 or 0", .{s});
+    return error.BadSetting;
+}
+
+/// The device copy of a read-out's BF16 [n, k] rows, counted into `stats`; the rows themselves stay for the prompt.
+pub fn build(gpa: std.mem.Allocator, driver: *const cuda.Driver, w: []const u8, n: usize, k: usize) !cuda.DeviceBuffer {
+    const npad = cuda.nvfp4.padded(n);
+    const image = try q12.pack(gpa, w, n, k, npad);
+    defer gpa.free(image);
+    stats.matrices += 1;
+    stats.bf16 += npad * k * 2;
+    stats.q12 += image.len;
+    stats.escapes += q12.escapeCount(image, npad, k);
+    return cuda.DeviceBuffer.fromHost(driver, image);
+}
+
+/// The copies' boot line: what they hold and what they cost beside the BF16 rows they do not replace.
+pub fn report() void {
+    if (stats.matrices == 0) return;
+    const gb = @as(f64, @floatFromInt(stats.q12)) / 1e9;
+    const share = 100 * @as(f64, @floatFromInt(stats.q12)) / @as(f64, @floatFromInt(stats.bf16));
+    std.log.info("flashnext: read-outs in 12 bits: {d} matrices, {d:.2} GB beside their rows ({d:.1}% of them), {d} escapes", .{ stats.matrices, gb, share, stats.escapes });
+}
+
+fn sample(r: std.Random, lo: u8, hi: u8) u16 {
+    if (r.uintLessThan(u32, 50) == 0) return 0;
+    return @as(u16, r.int(u1)) << 15 | @as(u16, r.intRangeAtMost(u8, lo, hi)) << 7 | r.int(u7);
+}
+
+/// The boot check: a packed copy of a read-out's own shape gives the BF16 weights' bytes at every decode row tile.
+pub fn selfCheck(gpa: std.mem.Allocator, driver: *const cuda.Driver, s: cuda.Stream, lane: *const cuda.qmmf.Lane, fast: *const q12.Lane) !void {
+    const n: usize = 324;
+    const k: usize = 10240;
+    const npad = cuda.nvfp4.padded(n);
+    const w = try gpa.alloc(u16, n * k);
+    defer gpa.free(w);
+    const x = try gpa.alloc(u16, q12.max_rows * k);
+    defer gpa.free(x);
+    const tiled = try gpa.alloc(u16, npad * k);
+    defer gpa.free(tiled);
+    const got = try gpa.alloc(u8, 2 * q12.max_rows * n * 4);
+    defer gpa.free(got);
+    var prng = std.Random.DefaultPrng.init(0x12b0c12);
+    const r = prng.random();
+    var y = try cuda.DeviceBuffer.alloc(driver, 2 * q12.max_rows * n * 4);
+    defer y.free();
+    var part = try cuda.DeviceBuffer.alloc(driver, 8 * q12.max_rows * n * 4);
+    defer part.free();
+    var xb = try cuda.DeviceBuffer.alloc(driver, q12.max_rows * k * 2);
+    defer xb.free();
+    // a narrow spread of exponents, then one wide enough that weights fall past what a 4-bit offset can say
+    for ([_]u8{ 120, 112 }) |lo| {
+        for (w) |*v| v.* = sample(r, lo, 127);
+        for (x) |*v| v.* = sample(r, 112, 127);
+        cuda.qmmf.packBf16(tiled, w, n, k);
+        try xb.upload(0, std.mem.sliceAsBytes(x));
+        var wb = try cuda.DeviceBuffer.fromHost(driver, std.mem.sliceAsBytes(tiled));
+        defer wb.free();
+        const image = try q12.pack(gpa, std.mem.sliceAsBytes(w), n, k, npad);
+        defer gpa.free(image);
+        var qb = try cuda.DeviceBuffer.fromHost(driver, image);
+        defer qb.free();
+        const weight = cuda.modelopt.bf16Weight(wb.ptr, n, k);
+        for ([_]cuda.qmmf.Out{ .f32, .bf16 }) |out| {
+            const unit: usize = if (out == .f32) 4 else 2;
+            for ([_]usize{ 1, 5, 16, 17, 32 }) |m| {
+                try y.fill8(0xA5, s.handle);
+                try lane.matmulOut(s, xb.ptr, k, m, weight, y.ptr, out, part.ptr);
+                try fast.matmulOut(s, xb.ptr, k, m, weight, qb.ptr, y.ptr + q12.max_rows * n * 4, out, part.ptr, lane.clusters, lane.half_below);
+                try s.synchronize();
+                try y.download(0, got);
+                const a = got[0 .. m * n * unit];
+                const b = got[q12.max_rows * n * 4 ..][0 .. m * n * unit];
+                if (std.mem.eql(u8, a, b)) continue;
+                std.log.err("flashnext: the 12-bit read-out differs from its BF16 weights at {d} rows, {s} out", .{ m, @tagName(out) });
+                return error.Q12NotLossless;
+            }
+        }
+    }
+}
