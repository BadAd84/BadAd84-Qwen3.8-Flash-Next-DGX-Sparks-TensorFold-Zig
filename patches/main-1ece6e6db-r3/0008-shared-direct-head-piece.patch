diff --git a/zig/src/families/flashnext/cuda_part_rows_test.zig b/zig/src/families/flashnext/cuda_part_rows_test.zig
new file mode 100644
index 000000000..c2142092f
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_part_rows_test.zig
@@ -0,0 +1,58 @@
+//! The MTP head's fc_h lane asks tiles.matmul for `streams x piece` rows at sk > 1, and that call writes one fp32
+//! slice into part and clears the slice beside it, so part must hold `2 x streams x piece` rows. A piece is at most
+//! half the pass's cap, so the lane needs `4 x cap` rows. The 8,607-token resume prompt (cap 3,072, the recipe's
+//! TF_FLASHNEXT_HEAD_PIECE=1536) asked for 12,288 rows in a 6,144-row part and failed with CUDA_ERROR_INVALID_VALUE;
+//! this holds the arithmetic that failed, main's own 256-row bound across every cap, and the bound the fix keeps.
+const std = @import("std");
+const sizes = @import("cuda_scratch_sizes.zig");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// partRows as the first 0008 left it: two cap slices, or a legacy lane tile's out_sk slices below 64 rows.
+fn partRowsBefore(cap: usize) usize {
+    return @max(2 * cap, wt.out_sk * @min(cap, 63));
+}
+
+/// The rows a tiles.matmul at sk > 1 writes into part: its fp32 slice and the slice it clears beside it.
+fn laneRows(streams: usize, piece: usize) usize {
+    return 2 * streams * piece;
+}
+
+/// The head's piece on a pass of `cap` rows, as forwardHeadPieces bounds it: the request, and the pass's half.
+fn pieceOf(request: usize, cap: usize) usize {
+    return @max(@as(usize, 1), @min(request, cap / 2));
+}
+
+test "the MTP head's fc_h lane fits part: the recipe's 1536-row piece at cap 3072 and main's 256 across caps" {
+    // the measured failure: the resume probe's prompt pass (cap 3,072) with the recipe's TF_FLASHNEXT_HEAD_PIECE
+    const cap: usize = 3072;
+    try std.testing.expectEqual(@as(usize, 1536), pieceOf(1536, cap));
+    try std.testing.expectEqual(@as(usize, 6144), partRowsBefore(cap)); // the buffer the labelled build overran
+    const need = laneRows(wt.streams, pieceOf(1536, cap));
+    try std.testing.expectEqual(@as(usize, 12288), need); // 2 x 4 x 1536 rows of dims
+    try std.testing.expect(need > partRowsBefore(cap)); // fails on the first 0008's partRows
+    try std.testing.expect(need <= sizes.partRows(cap)); // holds on the fix
+    try std.testing.expectEqual(@as(usize, 12288), sizes.partRows(cap));
+
+    // main's own 256-row bound, over every cap: the range where the old buffer overruns, computed not assumed
+    var first: usize = 0;
+    var last: usize = 0;
+    var c: usize = 1;
+    while (c <= 4096) : (c += 1) {
+        if (laneRows(wt.streams, pieceOf(256, c)) > partRowsBefore(c)) {
+            if (first == 0) first = c;
+            last = c;
+        }
+        try std.testing.expect(laneRows(wt.streams, pieceOf(256, c)) <= sizes.partRows(c));
+    }
+    try std.testing.expectEqual(@as(usize, 128), first);
+    try std.testing.expectEqual(@as(usize, 1023), last);
+    // the range's own ends: 127 fits the old buffer, and main's 1,024-row cap fills it exactly
+    try std.testing.expect(laneRows(wt.streams, pieceOf(256, 127)) <= partRowsBefore(127));
+    try std.testing.expectEqual(laneRows(wt.streams, pieceOf(256, 1024)), partRowsBefore(1024));
+
+    // the recipe's piece on the caps a serve meets: the head pass's own 32-row floor to the engine's 3,072 chunk
+    for ([_]usize{ 32, 48, 126, 512, 1024, 2048, 3071, 3072, 4096 }) |at| {
+        try std.testing.expect(laneRows(wt.streams, pieceOf(1536, at)) <= sizes.partRows(at));
+    }
+    try std.testing.expectEqual(@as(usize, 504), sizes.partRows(63)); // 8 x 63: the legacy tile's floor unchanged
+}
