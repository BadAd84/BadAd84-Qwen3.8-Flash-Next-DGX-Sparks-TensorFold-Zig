-/// One projection's E4M3 weight [n, k]; its BF16 weight_scale_inv [n/128, k/128] widened (exactly) into `scale`.
-fn part(store: anytype, prefix: []const u8, i: usize, name: []const u8, n: usize, k: usize, scale: []f32) ![]const u8 {
+/// E4M3 [n, k] and its BF16 weight_scale_inv, widened exactly; a BF16 weight goes into `scratch` block by block.
+fn part(store: anytype, prefix: []const u8, i: usize, name: []const u8, n: usize, k: usize, scale: []f32, scratch: []u8) ![]const u8 {
     var buf: [512]u8 = undefined;
+    const w = try store.get(try std.fmt.bufPrint(&buf, "{s}.experts.{d}.{s}.weight", .{ prefix, i, name }));
+    if (w.dtype == .bf16) {
+        if (!w.is(.bf16, &.{ n, k }) or w.bytes.len != n * k * 2 or scratch.len != n * k or scale.len != (n / blk) * (k / blk)) return error.UnexpectedTensor;
+        for (0..n / blk) |bi| for (0..k / blk) |bj| {
+            var top: f32 = 0;
+            for (0..blk) |r| for (0..blk) |c| {
+                top = @max(top, @abs(bf16At(w.bytes, (bi * blk + r) * k + bj * blk + c)));
+            };
+            const e = exponentFor(top);
+            scale[bi * (k / blk) + bj] = std.math.ldexp(@as(f32, 1.0), e);
+            for (0..blk) |r| for (0..blk) |c| {
+                const at = (bi * blk + r) * k + bj * blk + c;
+                scratch[at] = @import("core").exlr8.codec.e4m3FromF32(std.math.ldexp(bf16At(w.bytes, at), -e));
+            };
+        };
+        return scratch;
+    }
+    // stored E4M3 rows go through the shared block-FP8 reader
     const h = try core.quant.fp8.read(store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.{s}", .{ prefix, i, name }), n, k, .bf16, null);
     try core.quant.fp8.widen(h.scale_inv, scale, true);
     return h.weight.bytes;
 }
 
+fn bf16At(bytes: []const u8, i: usize) f32 {
+    return @bitCast(@as(u32, std.mem.readInt(u16, bytes[i * 2 ..][0..2], .little)) << 16);
+}
+
+/// The least power of two that brings `top` to 448 or under, as its exponent (0 for an all-zero block).
+fn exponentFor(top: f32) i32 {
+    if (!(top > 0) or !std.math.isFinite(top)) return 0;
+    var e: i32 = @intFromFloat(@ceil(@log2(top / 448.0)));
+    while (std.math.ldexp(top, -e) > 448.0) e += 1;
+    while (e > -126 and std.math.ldexp(top, -(e - 1)) <= 448.0) e -= 1;
+    return std.math.clamp(e, -126, 127);
+}
