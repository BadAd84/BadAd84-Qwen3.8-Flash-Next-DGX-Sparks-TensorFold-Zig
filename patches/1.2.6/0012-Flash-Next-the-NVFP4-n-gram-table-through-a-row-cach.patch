+//! The n-gram table's rows through a direct-mapped cache, the rows of later passes asked for ahead.
+const std = @import("std");
+const core = @import("core");
+const ple = @import("cuda_ple.zig");
+const knobs = @import("cuda_knobs.zig");
+const direct_io = core.direct_io;
+const std = @import("std");
+const core = @import("core");
+const direct_io = core.direct_io;
+
+/// Bytes of a row's codes and scales a cache slot holds (dh / 2 + dh / 16 of a 160-wide head: 90).
+pub const max_row = 96;
+const words = max_row / 8;
+/// Set in a slot's tag while its row is being written: the row's id + 1 is the rest.
+const busy: u64 = 1 << 63;
+const batch_ring = 16;
+pub const max_workers = 128;
+/// Most ids a worker claims at once (fewer when a batch is small, so that it spreads over the workers).
+const claim_ids = 8;
+/// A reader that finds its row busy waits for it this long, then reads the row itself.
+const wait_spins = 20_000;
+
+/// Where one shard's two arrays sit: file index, and byte offsets of the codes and scales.
+pub const Shard = struct { file: u16, codes_at: u64, scales_at: u64 };
+
+const Slot = extern struct { tag: u64, data: [words]u64 };
+
+/// Reads since the last `take`.
+pub const Stats = struct {
+    hits: std.atomic.Value(u64) = .init(0),
+    waited: std.atomic.Value(u64) = .init(0),
+    own_reads: std.atomic.Value(u64) = .init(0),
+    ahead_reads: std.atomic.Value(u64) = .init(0),
+    ahead_skipped: std.atomic.Value(u64) = .init(0),
+    ahead_rows: std.atomic.Value(u64) = .init(0),
+};
+
+const Batch = struct {
+    ids: []i64 = &.{},
+    grain: usize = 1,
+    claimed: std.atomic.Value(usize) = .init(0),
+    finished: std.atomic.Value(usize) = .init(0),
+    done: bool = true,
+};
+
+pub const Reader = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    files: []direct_io.File,
+    shards: []Shard,
+    /// first row of each shard, and the row count at the end
+    starts: []i64,
+    row_codes: usize,
+    row_scales: usize,
+    slots: []Slot,
+    shift: u6,
+    stats: Stats = .{},
+    // the read-ahead queue
+    mutex: std.Io.Mutex = .init,
+    batches: [batch_ring]Batch = @splat(.{}),
+    head: usize = 0,
+    tail: usize = 0,
+    go: std.atomic.Value(u32) = .init(0),
+    stopping: std.atomic.Value(bool) = .init(false),
+    threads: [max_workers]std.Thread = undefined,
+    spawned: usize = 0,
+    want_workers: usize,
+
+    /// `paths` are opened for reading; `slot_count` is a power of two. The reader owns nothing the arguments pass.
+    pub fn create(gpa: std.mem.Allocator, io: std.Io, paths: []const [:0]const u8, shards: []const Shard, starts: []const i64, row_codes: usize, row_scales: usize, slot_count: usize, n_workers: usize) !*Reader {
+        if (row_codes + row_scales > max_row or !std.math.isPowerOfTwo(slot_count) or shards.len + 1 != starts.len) return error.UnexpectedTensor;
+        const r = try gpa.create(Reader);
+        errdefer gpa.destroy(r);
+        const files = try gpa.alloc(direct_io.File, paths.len);
+        errdefer gpa.free(files);
+        var opened: usize = 0;
+        errdefer for (files[0..opened]) |*f| f.close();
+        for (paths, files) |p, *f| {
+            f.* = try direct_io.File.open(p);
+            opened += 1;
+        }
+        const own_shards = try gpa.dupe(Shard, shards);
+        errdefer gpa.free(own_shards);
+        const own_starts = try gpa.dupe(i64, starts);
+        errdefer gpa.free(own_starts);
+        // anonymous memory, zero until a slot is written: only the slots in use are resident
+        const mem = try std.posix.mmap(null, slot_count * @sizeOf(Slot), .{ .READ = true, .WRITE = true }, .{ .TYPE = .PRIVATE, .ANONYMOUS = true }, -1, 0);
+        r.* = .{
+            .gpa = gpa,
+            .io = io,
+            .files = files,
+            .shards = own_shards,
+            .starts = own_starts,
+            .row_codes = row_codes,
+            .row_scales = row_scales,
+            .slots = @as([*]Slot, @ptrCast(mem.ptr))[0..slot_count],
+            .shift = @intCast(@as(u32, 64) - std.math.log2_int(usize, slot_count)),
+            .want_workers = @min(n_workers, max_workers),
+        };
+        return r;
+    }
+
+    /// Stops the workers and releases the files and the cache.
+    pub fn destroy(r: *Reader) void {
+        r.stopping.store(true, .release);
+        _ = r.go.fetchAdd(1, .release);
+        r.io.futexWake(u32, &r.go.raw, std.math.maxInt(u32));
+        for (r.threads[0..r.spawned]) |th| th.join();
+        for (&r.batches) |*b| if (!b.done) r.gpa.free(b.ids);
+        for (r.files) |*f| f.close();
+        std.posix.munmap(@as([*]align(std.heap.page_size_min) u8, @ptrCast(@alignCast(r.slots.ptr)))[0 .. r.slots.len * @sizeOf(Slot)]);
+        r.gpa.free(r.files);
+        r.gpa.free(r.shards);
+        r.gpa.free(r.starts);
+        r.gpa.destroy(r);
+    }
+
+    fn slotOf(r: *const Reader, id: u64) *Slot {
+        return &r.slots[(id *% 0x9E3779B97F4A7C15) >> r.shift];
+    }
+
+    fn locate(r: *const Reader, id: i64) ?struct { shard: usize, local: u64 } {
+        const n = r.shards.len;
+        if (id < 0 or id >= r.starts[n]) return null;
+        var lo: usize = 0;
+        var hi = n;
+        while (lo + 1 < hi) {
+            const mid = (lo + hi) / 2;
+            if (r.starts[mid] <= id) lo = mid else hi = mid;
+        }
+        return .{ .shard = lo, .local = @intCast(id - r.starts[lo]) };
+    }
+
+    /// The row's codes then scales from the file, ahead of nothing: two positional reads.
+    fn readRaw(r: *const Reader, shard: usize, local: u64, out: *[max_row]u8) !void {
+        var buf: [2 * direct_io.alignment]u8 align(direct_io.alignment) = undefined;
+        const s = r.shards[shard];
+        const f = r.files[s.file];
+        @memcpy(out[0..r.row_codes], try f.read(&buf, s.codes_at + local * r.row_codes, r.row_codes));
+        @memcpy(out[r.row_codes..][0..r.row_scales], try f.read(&buf, s.scales_at + local * r.row_scales, r.row_scales));
+    }
+
+    fn store(slot: *Slot, raw: *const [max_row]u8) void {
+        for (0..words) |i| @atomicStore(u64, &slot.data[i], std.mem.readInt(u64, raw[i * 8 ..][0..8], .little), .release);
+    }
+
+    fn load(slot: *const Slot, raw: *[max_row]u8) void {
+        for (0..words) |i| std.mem.writeInt(u64, raw[i * 8 ..][0..8], @atomicLoad(u64, &slot.data[i], .acquire), .little);
+    }
+
+    /// Row `id`'s raw bytes (codes, then scales): from the cache, a read under way, or the file.
+    pub fn get(r: *Reader, id: i64, out: *[max_row]u8) !void {
+        const loc = r.locate(id) orelse return error.UnexpectedTensor;
+        const want: u64 = @as(u64, @intCast(id)) + 1;
+        const slot = r.slotOf(want);
+        var spins: u32 = 0;
+        var waited = false;
+        while (true) {
+            const t = @atomicLoad(u64, &slot.tag, .acquire);
+            if (t == want) {
+                load(slot, out);
+                // an overwrite during the copy shows in the tag (each data word was stored after the claim)
+                if (@atomicLoad(u64, &slot.tag, .acquire) == want) {
+                    _ = r.stats.hits.fetchAdd(1, .monotonic);
+                    if (waited) _ = r.stats.waited.fetchAdd(1, .monotonic);
+                    return;
+                }
+                continue;
+            }
+            if (t == (want | busy) and spins < wait_spins) {
+                spins += 1;
+                waited = true;
+                if (spins % 64 == 0) std.Thread.yield() catch {} else std.atomic.spinLoopHint();
+                continue;
+            }
+            if (t & busy == 0 and @cmpxchgStrong(u64, &slot.tag, t, want | busy, .acq_rel, .monotonic) == null) {
+                r.readRaw(loc.shard, loc.local, out) catch |err| {
+                    @atomicStore(u64, &slot.tag, 0, .release);
+                    return err;
+                };
+                store(slot, out);
+                @atomicStore(u64, &slot.tag, want, .release);
+                _ = r.stats.own_reads.fetchAdd(1, .monotonic);
+                return;
+            }
+            // the slot is another row's in the middle of a write: read without keeping the row
+            try r.readRaw(loc.shard, loc.local, out);
+            _ = r.stats.own_reads.fetchAdd(1, .monotonic);
+            return;
+        }
+    }
+
+    /// Reads row `id` into the cache unless it is there or under way.
+    fn fetch(r: *Reader, id: i64) void {
+        const loc = r.locate(id) orelse return;
+        const want: u64 = @as(u64, @intCast(id)) + 1;
+        const slot = r.slotOf(want);
+        const t = @atomicLoad(u64, &slot.tag, .acquire);
+        if (t == want or t == (want | busy) or t & busy != 0 or @cmpxchgStrong(u64, &slot.tag, t, want | busy, .acq_rel, .monotonic) != null) {
+            _ = r.stats.ahead_skipped.fetchAdd(1, .monotonic);
+            return;
+        }
+        var raw: [max_row]u8 = @splat(0);
+        r.readRaw(loc.shard, loc.local, &raw) catch {
+            @atomicStore(u64, &slot.tag, 0, .release);
+            return;
+        };
+        store(slot, &raw);
+        @atomicStore(u64, &slot.tag, want, .release);
+        _ = r.stats.ahead_reads.fetchAdd(1, .monotonic);
+    }
+
+    /// Asks the workers to read the rows `ids` into the cache, in order, and returns at once; a full queue drops it.
+    pub fn prefetch(r: *Reader, ids: []const i64) void {
+        if (ids.len == 0 or r.want_workers == 0) return;
+        const own = r.gpa.dupe(i64, ids) catch return;
+        r.mutex.lockUncancelable(r.io);
+        if (r.tail - r.head == batch_ring or r.startWorkers() == 0) {
+            r.mutex.unlock(r.io);
+            r.gpa.free(own);
+            return;
+        }
+        const b = &r.batches[r.tail % batch_ring];
+        b.ids = own;
+        b.grain = std.math.clamp((ids.len + r.want_workers - 1) / r.want_workers, 1, claim_ids);
+        b.claimed.store(0, .monotonic);
+        b.finished.store(0, .monotonic);
+        b.done = false;
+        r.tail += 1;
+        r.mutex.unlock(r.io);
+        _ = r.stats.ahead_rows.fetchAdd(ids.len, .monotonic);
+        _ = r.go.fetchAdd(1, .release);
+        r.io.futexWake(u32, &r.go.raw, @intCast(@min(r.spawned, (ids.len + b.grain - 1) / b.grain)));
+    }
+
+    /// Workers up to the wanted count (the mutex held); how many there are.
+    fn startWorkers(r: *Reader) usize {
+        while (r.spawned < r.want_workers) {
+            r.threads[r.spawned] = std.Thread.spawn(.{}, work, .{r}) catch break;
+            r.spawned += 1;
+        }
+        return r.spawned;
+    }
+
+    /// The next ids to read: a slice of the oldest batch that has any left (null: none), and the batch.
+    fn claim(r: *Reader) ?struct { ids: []const i64, batch: *Batch } {
+        r.mutex.lockUncancelable(r.io);
+        defer r.mutex.unlock(r.io);
+        // the newest batch first: a drafted token's few rows are wanted within milliseconds, a chunk's many later
+        var i = r.tail;
+        while (i > r.head) {
+            i -= 1;
+            const b = &r.batches[i % batch_ring];
+            const at = b.claimed.load(.monotonic);
+            if (at >= b.ids.len) continue;
+            const n = @min(b.grain, b.ids.len - at);
+            b.claimed.store(at + n, .monotonic);
+            return .{ .ids = b.ids[at..][0..n], .batch = b };
+        }
+        return null;
+    }
+
+    fn finish(r: *Reader, b: *Batch, n: usize) void {
+        // the length before the count: the last finisher frees the ids
+        const len = b.ids.len;
+        if (b.finished.fetchAdd(n, .acq_rel) + n != len) return;
+        r.mutex.lockUncancelable(r.io);
+        defer r.mutex.unlock(r.io);
+        r.gpa.free(b.ids);
+        b.ids = &.{};
+        b.done = true;
+        while (r.head < r.tail and r.batches[r.head % batch_ring].done) r.head += 1;
+    }
+
+    fn work(r: *Reader) void {
+        while (true) {
+            const seen = r.go.load(.acquire);
+            if (r.stopping.load(.acquire)) return;
+            if (r.claim()) |c| {
+                for (c.ids) |id| r.fetch(id);
+                r.finish(c.batch, c.ids.len);
+                continue;
+            }
+            r.io.futexWaitUncancelable(u32, &r.go.raw, seen);
+        }
+    }
+
+    /// Returns once every asked-for row has been read (tests, and a clean stop).
+    pub fn drain(r: *Reader) void {
+        while (true) {
+            r.mutex.lockUncancelable(r.io);
+            const idle = r.head == r.tail;
+            r.mutex.unlock(r.io);
+            if (idle) return;
+            std.Thread.yield() catch {};
+        }
+    }
+
+    /// Takes the counters since the last call.
+    pub fn take(r: *Reader) struct { hits: u64, waited: u64, own: u64, ahead: u64, skipped: u64, rows: u64 } {
+        return .{
+            .hits = r.stats.hits.swap(0, .monotonic),
+            .waited = r.stats.waited.swap(0, .monotonic),
+            .own = r.stats.own_reads.swap(0, .monotonic),
+            .ahead = r.stats.ahead_reads.swap(0, .monotonic),
+            .skipped = r.stats.ahead_skipped.swap(0, .monotonic),
+            .rows = r.stats.ahead_rows.swap(0, .monotonic),
+        };
+    }
+};
+
+/// Fills `row_out` from the cache when the engine reads through one: false leaves it to the caller's reader.
+pub fn row(g: *const ple.Ngram, id: i64, loc: anytype, row_out: []u16) !bool {
+    if (g.format != .nvfp4) return false;
+    const c = g.cache orelse return false;
+    var raw: [max_row]u8 = undefined;
+    // a read that fails leaves the row to the caller's reader
+    c.get(id, &raw) catch return false;
+    const t = g.tables[loc.shard];
+    const rc = t.width / 2;
+    const one: core.nvfp4_rows.Table = .{ .codes = raw[0..rc], .scales = raw[rc..][0 .. t.width / 16], .rows = 1, .width = t.width, .global = t.global };
+    try one.gather(&.{0}, row_out);
+    return true;
+}
+
+/// The positional reader over the shards' files: where each shard's codes and scales sit in them.
+pub fn open(g: *ple.Ngram, io: std.Io) !*Reader {
+    const dh = g.hash.dh;
+    var paths: [ple.max_shards][:0]const u8 = undefined;
+    var shards: [ple.max_shards]Shard = undefined;
+    if (g.files.items.len > paths.len or dh % 16 != 0) return error.UnexpectedTensor;
+    for (g.files.items, 0..) |o, i| paths[i] = o.file.path;
+    for (g.tables[0..g.hash.shards], 0..) |t, s| {
+        const at = @intFromPtr(t.codes.ptr);
+        const fi = for (g.files.items, 0..) |o, i| {
+            const base = @intFromPtr(o.file.map.memory.ptr);
+            if (at >= base and at < base + o.file.map.memory.len) break i;
+        } else return error.UnexpectedTensor;
+        const base = @intFromPtr(g.files.items[fi].file.map.memory.ptr);
+        const scales_at = @intFromPtr(t.scales.ptr);
+        if (scales_at < base or scales_at + t.scales.len > base + g.files.items[fi].file.map.memory.len) return error.UnexpectedTensor;
+        shards[s] = .{ .file = @intCast(fi), .codes_at = at - base, .scales_at = scales_at - base };
+    }
+    return create(g.gpa, io, paths[0..g.files.items.len], shards[0..g.hash.shards], g.hash.starts[0 .. g.hash.shards + 1], dh / 2, dh / 16, try cacheSlots(), try workers());
+}
+
+fn cacheSlots() !usize {
+    const mib = try knobs.gatherCacheMib();
+    return std.math.floorPowerOfTwo(usize, @max(1, mib << 20) / @sizeOf(Slot));
+}
+
+fn workers() !usize {
+    return @min(try knobs.gatherThreads(), max_workers);
+}
+
+/// The rows of `tokens[lo..hi)` into the cache, hashed in the background, when warm-ahead is on and cached.
+pub fn warmNext(g: *ple.Ngram, tokens: []const u32, lo: usize, hi: usize) void {
+    if (!g.warm_ahead) return;
+    const rd = g.cache orelse return;
+    const n1 = g.hash.n - 1;
+    if (rd.want_workers == 0 or lo < n1 or hi <= lo or hi > tokens.len) return;
+    var hist: [ple.max_n]i64 = undefined;
+    for (0..n1) |k| hist[k] = tokens[lo - n1 + k];
+    aheadChunk(g, hist[0..n1], tokens[lo..hi]);
+}
+
+/// Reads, in the background, the rows of `tokens` (a prompt chunk) after `history` (n - 1 ids) into the cache.
+pub fn aheadChunk(g: *ple.Ngram, history: []const i64, tokens: []const u32) void {
+    const rd = g.cache orelse return;
+    if (rd.want_workers == 0 or history.len != g.hash.n - 1 or tokens.len == 0) return;
+    if (g.ahead_thread) |th| th.join();
+    g.ahead_thread = null;
+    const job = g.gpa.create(AheadJob) catch return;
+    job.* = .{ .g = g, .tokens = g.gpa.dupe(u32, tokens) catch {
+        g.gpa.destroy(job);
+        return;
+    }, .hist = undefined };
+    @memcpy(job.hist[0..history.len], history);
+    g.ahead_thread = std.Thread.spawn(.{}, AheadJob.run, .{job}) catch {
+        g.gpa.free(job.tokens);
+        g.gpa.destroy(job);
+        return;
+    };
+}
+
+const AheadJob = struct {
+    g: *ple.Ngram,
+    tokens: []u32,
+    hist: [ple.max_n]i64,
+
+    fn run(job: *AheadJob) void {
+        const g = job.g;
+        defer {
+            g.gpa.free(job.tokens);
+            g.gpa.destroy(job);
+        }
+        const heads = g.hash.heads;
+        const ids = g.gpa.alloc(i64, job.tokens.len * heads) catch return;
+        defer g.gpa.free(ids);
+        const hist = job.hist[0 .. g.hash.n - 1];
+        for (job.tokens, 0..) |token, t| {
+            ple.lastIds(g.hash, hist, token, ids[t * heads ..][0..heads]) catch return;
+            for (0..hist.len - 1) |i| hist[i] = hist[i + 1];
+            hist[hist.len - 1] = token;
+        }
+        g.cache.?.prefetch(ids);
+    }
+};
+
+/// A decode round's drafted tokens as the head picks them: their rows are read while the head drafts the next ones.
+pub const Ahead = struct {
+    const max_lanes = 64;
+    g: *const ple.Ngram,
+    hist: [max_lanes][ple.max_n]i64 = undefined,
+    ids: [max_lanes * ple.max_heads]i64 = undefined,
+    n: usize = 0,
+
+    /// Null unless TF_FLASHNEXT_DRAFT_AHEAD=1 and the table is read through the cache.
+    pub fn init(g: *const ple.Ngram) ?Ahead {
+        const rd = g.cache orelse return null;
+        if (!(knobs.draftAhead() catch false) or rd.want_workers == 0) return null;
+        return .{ .g = g };
+    }
+
+    /// Lane `k`'s history (the n - 1 ids before its next token).
+    pub fn lane(a: *Ahead, k: usize, history: []const i64) void {
+        if (k < max_lanes and history.len == a.g.hash.n - 1) @memcpy(a.hist[k][0..history.len], history);
+    }
+
+    /// Lane `k`'s next token: its row ids join the batch `flush` sends.
+    pub fn push(a: *Ahead, k: usize, token: u32) void {
+        const heads = a.g.hash.heads;
+        if (k >= max_lanes) return;
+        if (a.n + heads > a.ids.len) a.flush();
+        const hist = a.hist[k][0 .. a.g.hash.n - 1];
+        ple.lastIds(a.g.hash, hist, token, a.ids[a.n..][0..heads]) catch return;
+        a.n += heads;
+        for (0..hist.len - 1) |i| hist[i] = hist[i + 1];
+        hist[hist.len - 1] = token;
+    }
+
+    /// Asks the reader's threads for the rows pushed since the last flush.
+    pub fn flush(a: *Ahead) void {
+        if (a.n > 0) a.g.cache.?.prefetch(a.ids[0..a.n]);
+        a.n = 0;
+    }
+};
diff --git a/zig/src/families/flashnext/cuda_ple_cache_test.zig b/zig/src/families/flashnext/cuda_ple_cache_test.zig
new file mode 100644
index 000000000..8dd185e61
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_ple_cache_test.zig
@@ -0,0 +1,207 @@
+//! The row cache's reads return the mapping's rows, bit for bit, however they were asked for.
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const ple_cache = @import("cuda_ple_cache.zig");
+const fixture = @import("cuda_ple_nvfp4_test.zig").fixture;
+const a = std.testing.allocator;
+const io = std.testing.io;
+
+test "NVFP4 rows read by pread equal the mapped rows, cold, ahead and after eviction" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try fixture(tmp.dir, true);
+    const path = try std.fmt.allocPrint(a, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer a.free(path);
+    var g = try ple.Ngram.init(a, io, path);
+    defer g.deinit();
+    try std.testing.expect(g.cache == null);
+    var tokens: [513]u32 = undefined;
+    for (&tokens, 0..) |*v, i| v.* = @intCast((i * 11 + 3) % 100);
+    var want: [513 * 32]u16 = undefined;
+    var want_xs: [513]f32 = undefined;
+    var want_hist = [_]i64{99};
+    try g.rows(&want_hist, &tokens, &want, &want_xs);
+
+    try ple_cache.open(&g, io);
+    const rd = g.cache.?;
+    var got: [513 * 32]u16 = undefined;
+    var got_xs: [513]f32 = undefined;
+    // cold: every row from the file
+    @memset(&got, 0xdead);
+    var hist = [_]i64{99};
+    try g.rows(&hist, &tokens, &got, &got_xs);
+    try std.testing.expectEqualSlices(u16, &want, &got);
+    try std.testing.expectEqualSlices(f32, &want_xs, &got_xs);
+    try std.testing.expectEqualSlices(i64, &want_hist, &hist);
+    const cold = rd.take();
+    try std.testing.expect(cold.own > 0);
+    // warm: the same rows from the cache
+    @memset(&got, 0xdead);
+    hist = .{99};
+    try g.rows(&hist, &tokens, &got, &got_xs);
+    try std.testing.expectEqualSlices(u16, &want, &got);
+    const warm = rd.take();
+    try std.testing.expectEqual(@as(u64, 0), warm.own);
+    try std.testing.expect(warm.hits > 0);
+    // ahead: a fresh reader's cache filled by a chunk's read-ahead, then gathered with no read of the gather's own
+    g.cache = null;
+    rd.destroy();
+    try ple_cache.open(&g, io);
+    const rd2 = g.cache.?;
+    g.aheadChunk(&[_]i64{99}, tokens[0..300]);
+    g.ahead_thread.?.join();
+    g.ahead_thread = null;
+    rd2.drain();
+    _ = rd2.take();
+    @memset(&got, 0xdead);
+    hist = .{99};
+    try g.rows(&hist, tokens[0..300], got[0 .. 300 * 32], got_xs[0..300]);
+    try std.testing.expectEqualSlices(u16, want[0 .. 300 * 32], got[0 .. 300 * 32]);
+    try std.testing.expectEqual(@as(u64, 0), rd2.take().own);
+    // the decode read-ahead pushes tokens with a lane's moving history
+    var ahead: ple_cache.Ahead = .{ .g = &g };
+    ahead.lane(0, &[_]i64{99});
+    for (tokens[300..310]) |t| ahead.push(0, t);
+    ahead.flush();
+    rd2.drain();
+    var hist2 = [_]i64{99};
+    try g.rows(&hist2, tokens[0..300], got[0 .. 300 * 32], got_xs[0..300]);
+    _ = rd2.take();
+    @memset(&got, 0xdead);
+    try g.rows(&hist2, tokens[300..310], got[0 .. 10 * 32], got_xs[0..10]);
+    try std.testing.expectEqualSlices(u16, want[300 * 32 .. 310 * 32], got[0 .. 10 * 32]);
+    try std.testing.expectEqual(@as(u64, 0), rd2.take().own);
+}
+
+test "NVFP4 rows read by pread stay exact when slots collide" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try fixture(tmp.dir, true);
+    const path = try std.fmt.allocPrint(a, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer a.free(path);
+    var g = try ple.Ngram.init(a, io, path);
+    defer g.deinit();
+    var tokens: [257]u32 = undefined;
+    for (&tokens, 0..) |*v, i| v.* = @intCast((i * 7 + 1) % 100);
+    var want: [257 * 32]u16 = undefined;
+    var want_xs: [257]f32 = undefined;
+    var h0 = [_]i64{99};
+    try g.rows(&h0, &tokens, &want, &want_xs);
+    // two slots for every row of the table: nearly every read evicts another
+    const reader = ple_cache;
+    var paths = [_][:0]const u8{g.files.items[0].file.path};
+    const base = @intFromPtr(g.files.items[0].file.map.memory.ptr);
+    var shards: [2]reader.Shard = undefined;
+    for (g.tables[0..2], &shards) |t, *s| s.* = .{ .file = 0, .codes_at = @intFromPtr(t.codes.ptr) - base, .scales_at = @intFromPtr(t.scales.ptr) - base };
+    g.cache = try reader.Reader.create(a, io, &paths, &shards, g.hash.starts[0..3], 8, 1, 2, 8);
+    var got: [257 * 32]u16 = undefined;
+    var got_xs: [257]f32 = undefined;
+    for (0..3) |_| {
+        var h = [_]i64{99};
+        @memset(&got, 0xdead);
+        try g.rows(&h, &tokens, &got, &got_xs);
+        try std.testing.expectEqualSlices(u16, &want, &got);
+        g.cache.?.prefetch(&.{ 0, 1, 2, 3, 4, 5, 6, 7 });
+    }
+}
+
+fn ms(io_: std.Io, t0: i96) f64 {
+    return @as(f64, @floatFromInt(std.Io.Clock.awake.now(io_).toNanoseconds() - t0)) / 1e6;
+}
+
+fn gather(g: *ple.Ngram, hist: *[2]i64, toks: []const u32, out: []u16, xs: []f32) !void {
+    try g.rows(hist, toks, out, xs[0 .. out.len / 32]);
+}
+
+// TF_PLE_REAL_DIR=<checkpoint dir>: the real 28.7 GiB table, mapped and by pread, on random tokens (timings on stderr).
+test "real checkpoint: pread rows equal the mapped rows" {
+    const dir = std.c.getenv("TF_PLE_REAL_DIR") orelse return error.SkipZigTest;
+    var g = try ple.Ngram.init(a, io, std.mem.span(dir));
+    defer g.deinit();
+    const w = g.width();
+    const seed: u64 = if (std.c.getenv("TF_PLE_SEED")) |v| std.fmt.parseInt(u64, std.mem.span(v), 10) catch 42 else 42;
+    var prng = std.Random.DefaultPrng.init(seed);
+    const n = 3072;
+    const tokens = try a.alloc(u32, 2 * n);
+    defer a.free(tokens);
+    for (tokens) |*t| t.* = prng.random().uintLessThan(u32, 248000);
+    const want = try a.alloc(u16, 2 * n * w);
+    defer a.free(want);
+    const got = try a.alloc(u16, 2 * n * w);
+    defer a.free(got);
+    const xs = try a.alloc(f32, 2 * n * w / 32);
+    defer a.free(xs);
+    var hist = [_]i64{ g.hash.eos, g.hash.eos };
+    var t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, tokens[0..n], want[0 .. n * w], xs);
+    std.debug.print("\nmapped, {d} rows: {d:.1} ms\n", .{ n, ms(io, t0) });
+    hist = .{ g.hash.eos, g.hash.eos };
+    try gather(&g, &hist, tokens[n..], want[n * w ..], xs);
+    // decode-sized, mapped: 90 tokens' rows
+    const small = try a.alloc(u16, 90 * w);
+    defer a.free(small);
+    hist = .{ g.hash.eos, g.hash.eos };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, tokens[100..190], small, xs);
+    std.debug.print("mapped, 90 rows: {d:.2} ms\n", .{ms(io, t0)});
+
+    try ple_cache.open(&g, io);
+    const rd = g.cache.?;
+    hist = .{ g.hash.eos, g.hash.eos };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, tokens[0..n], got[0 .. n * w], xs);
+    std.debug.print("pread cold, {d} rows: {d:.1} ms\n", .{ n, ms(io, t0) });
+    try std.testing.expectEqualSlices(u16, want[0 .. n * w], got[0 .. n * w]);
+    hist = .{ g.hash.eos, g.hash.eos };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, tokens[0..n], got[0 .. n * w], xs);
+    std.debug.print("pread cached, {d} rows: {d:.1} ms\n", .{ n, ms(io, t0) });
+    try std.testing.expectEqualSlices(u16, want[0 .. n * w], got[0 .. n * w]);
+    // read ahead of the second chunk, then its gather
+    hist = .{ tokens[n - 2], tokens[n - 1] };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    g.aheadChunk(&hist, tokens[n..]);
+    g.ahead_thread.?.join();
+    g.ahead_thread = null;
+    std.debug.print("ahead of {d} rows asked: {d:.1} ms; ", .{ n, ms(io, t0) });
+    rd.drain();
+    std.debug.print("all read after {d:.1} ms\n", .{ms(io, t0)});
+    _ = rd.take();
+    hist = .{ tokens[n - 2], tokens[n - 1] };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, tokens[n..], got[n * w ..], xs);
+    std.debug.print("pread after read-ahead, {d} rows: {d:.1} ms\n", .{ n, ms(io, t0) });
+    const q = rd.take();
+    std.debug.print("  own reads {d}, hits {d}\n", .{ q.own, q.hits });
+    // the second chunk's expected rows came after the first chunk's history: a mapped gather of the same call compares
+    const rdp = g.cache;
+    g.cache = null;
+    hist = .{ tokens[n - 2], tokens[n - 1] };
+    try gather(&g, &hist, tokens[n..], want[n * w ..], xs);
+    g.cache = rdp;
+    try std.testing.expectEqualSlices(u16, want[n * w ..], got[n * w ..]);
+    // a decode round: 90 rows cold by pread, then the same asked for ahead
+    hist = .{ g.hash.eos, g.hash.eos };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, tokens[100..190], small[0 .. 90 * w], xs);
+    std.debug.print("pread, 90 rows (cached from the first pass): {d:.2} ms\n", .{ms(io, t0)});
+    var fresh: [90]u32 = undefined;
+    for (&fresh) |*t| t.* = prng.random().uintLessThan(u32, 248000);
+    hist = .{ g.hash.eos, g.hash.eos };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, &fresh, small[0 .. 90 * w], xs);
+    std.debug.print("pread, 90 fresh rows, cold: {d:.2} ms\n", .{ms(io, t0)});
+    var ahead: ple_cache.Ahead = .{ .g = &g };
+    var fresh2: [90]u32 = undefined;
+    for (&fresh2) |*t| t.* = prng.random().uintLessThan(u32, 248000);
+    ahead.lane(0, &[_]i64{ g.hash.eos, g.hash.eos });
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for (fresh2) |t| ahead.push(0, t);
+    ahead.flush();
+    rd.drain();
+    std.debug.print("decode read-ahead of 90 tokens' rows, all read after {d:.2} ms\n", .{ms(io, t0)});
+    hist = .{ g.hash.eos, g.hash.eos };
+    t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    try gather(&g, &hist, &fresh2, small[0 .. 90 * w], xs);
+    std.debug.print("pread, 90 rows read ahead: {d:.2} ms\n", .{ms(io, t0)});
+}
