+var tail_rows: ?usize = null;
+
+/// TF_FLASHNEXT_PREFILL_TAIL: a last prompt chunk under this many rows is evened out with the one before it (0: off).
+pub fn prefillTail() usize {
+    if (tail_rows == null) tail_rows = knobs.prefillTail() catch 0;
+    return tail_rows.?;
+}
+
+/// A last chunk under `tail` rows takes about half of what remains: two even chunks past the expert tiles' 1,024 rows.
+pub fn tailRowsFor(rows: usize, total: usize, at: usize, tail: usize) usize {
+    if (tail == 0 or at + rows >= total or total - at - rows >= tail) return rows;
+    const even = ((total - at + 1) / 2 + 15) / 16 * 16;
+    return @min(even, rows);
+}
+
+/// tailRowsFor at the process's TF_FLASHNEXT_PREFILL_TAIL.
+pub fn tailRows(rows: usize, total: usize, at: usize) usize {
+    return tailRowsFor(rows, total, at, prefillTail());
+}
+
 test "TF_FLASHNEXT_CHUNK takes 1 to the largest measured pass and refuses the rest" {
     try std.testing.expectEqual(batch.default_chunk, try parseChunk(null));
     try std.testing.expectEqual(@as(usize, 4096), try parseChunk("4096"));
@@ -71,3 +92,24 @@ test "a pass takes the solo rows unless another lane decodes; prompts still fill
     try std.testing.expectEqual(@as(usize, 1536), passRows(&m, 0, 8192, 1536));
     try std.testing.expectEqual(@as(usize, 1536), passRows(&m, 0, 1536, 1536));
 }
+
+fn planTail(total: usize, chunk: usize, tail: usize, out: []usize) []usize {
+    var at: usize = 0;
+    var n: usize = 0;
+    while (at < total) : (n += 1) {
+        out[n] = tailRowsFor(@min(chunk, total - at), total, at, tail);
+        at += out[n];
+    }
+    return out[0..n];
+}
+
+test "the tail rule evens out a short last chunk and leaves the rest alone" {
+    var buf: [16]usize = undefined;
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072, 3072, 3072, 193 }, planTail(12481, 3072, 0, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072, 3072, 1648, 1617 }, planTail(12481, 3072, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072, 3072, 3072, 600 }, planTail(12888, 3072, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072 }, planTail(6144, 3072, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{100}, planTail(100, 3072, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 1584, 1584 }, planTail(6240, 3072, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 1536, 1536, 1536, 1536 }, planTail(6144, 1536, 512, &buf));
+}
