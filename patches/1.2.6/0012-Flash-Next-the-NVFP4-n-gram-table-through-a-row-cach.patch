+/// One lane's draft with the decode read-ahead: the next token's rows are asked for as the head drafts (DRAFT_AHEAD=1).
+pub fn one(self: anytype, seq: anytype, d: anytype, next: []const u32, rows: u64, position: u64, count: usize, sm: ?mtp.Sampling, stop: f64, out: *mtp.Chain) !void {
+    var buf = ple_cache.Ahead.init(&self.engine.ngram);
+    const a: ?*ple_cache.Ahead = if (buf) |*b| b else null;
