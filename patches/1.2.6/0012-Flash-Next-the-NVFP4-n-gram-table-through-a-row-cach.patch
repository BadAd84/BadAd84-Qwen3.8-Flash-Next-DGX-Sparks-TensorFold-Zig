+//! Row-cache reader and prompt-shape switches (platform-validated environment); the defaults keep the plain reader.
+const sys = @import("sys");
+
+/// TF_FLASHNEXT_GATHER_READ=pread: the table's rows through a row cache and parked readers; 0 keeps the plain reader.
+pub fn gatherRead() sys.environment.Error!bool {
+    return (try sys.environment.read(usize, "TF_FLASHNEXT_GATHER_READ", 0)) == 1;
+}
+
+/// TF_FLASHNEXT_GATHER_THREADS: parked readers of the row cache (default 128, the most; 0 gathers every row itself).
+pub fn gatherThreads() sys.environment.Error!usize {
+    return sys.environment.read(usize, "TF_FLASHNEXT_GATHER_THREADS", 128);
+}
+
+/// TF_FLASHNEXT_GATHER_CACHE_MIB: the row cache's address space in MiB (default 256; only slots in use are resident).
+pub fn gatherCacheMib() sys.environment.Error!usize {
+    return sys.environment.read(usize, "TF_FLASHNEXT_GATHER_CACHE_MIB", 256);
+}
+
+/// TF_FLASHNEXT_DRAFT_AHEAD=1: a drafted token's rows are read while the head drafts the next (needs the row cache).
+pub fn draftAhead() sys.environment.Error!bool {
+    return sys.environment.read(bool, "TF_FLASHNEXT_DRAFT_AHEAD", false);
+}
+
+/// TF_FLASHNEXT_PREFILL_TAIL: a last prompt chunk under this many rows is evened out with the one before it (0: off).
+pub fn prefillTail() sys.environment.Error!usize {
+    return sys.environment.read(usize, "TF_FLASHNEXT_PREFILL_TAIL", 0);
+}
