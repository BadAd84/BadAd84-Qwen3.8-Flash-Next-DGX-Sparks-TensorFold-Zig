+                if (col + 1 < N) {
+                    if ((N & 1) == 0) *reinterpret_cast<float2*>(dst) = make_float2(tot[i][j][2 * h], tot[i][j][2 * h + 1]);
+                    else {
+                        dst[0] = tot[i][j][2 * h];
+                        dst[1] = tot[i][j][2 * h + 1];
+                    }
+                } else if (col < N) dst[0] = tot[i][j][2 * h];
+            }
