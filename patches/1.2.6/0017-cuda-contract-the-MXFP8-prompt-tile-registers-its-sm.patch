From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Mon, 9 Nov 2026 10:08:58 +0000
Subject: [PATCH 17/27] cuda contract: the MXFP8 prompt tile registers its
 sm_12x launches

The relaxed tile and its two-stage variant record nvcc 13.0 receipts on sm_120 and sm_121
(175 and 128 registers a thread): the two-stage variant compiles to exactly the register file
one needs for two blocks an SM, and the three-stage tile holds one. The five-SM audit entries
for sm_80 through sm_89 remain pending, as do the float64 reference and the served envelope for
gates 1 through 4.
---
 zig/src/core/contract/qmmf_prompt_records.zig | 34 +++++++++++++++++--
 1 file changed, 31 insertions(+), 3 deletions(-)

diff --git a/zig/src/core/contract/qmmf_prompt_records.zig b/zig/src/core/contract/qmmf_prompt_records.zig
index 16096a3b6..94326a1d7 100644
--- a/zig/src/core/contract/qmmf_prompt_records.zig
+++ b/zig/src/core/contract/qmmf_prompt_records.zig
@@ -1,4 +1,4 @@
-//! BF16 K64 and unfused K32 prompt receipts from nvcc 13.0 on sm_12x; later compilers remain pending.
+//! BF16 K64, unfused K32 and MXFP8 prompt receipts from nvcc 13.0 on sm_12x; later compilers remain pending.
 const std = @import("std");
 const registry = @import("registry.zig");
 const limits = @import("limits.zig");
@@ -37,7 +37,22 @@ fn k32(comptime wide: bool) registry.CudaRecord {
     }, .usage = usage(120), .later_pending = true };
 }
 
-pub const records = [_]registry.CudaRecord{ record(false, false), record(false, true), record(true, false), record(true, true), k32(false), k32(true) };
+fn mxRecord(comptime name: []const u8, comptime symbol: []const u8, comptime dynamic: u32, comptime regs: u32) registry.CudaRecord {
+    return .{ .launch = .{
+        .name = name,
+        .symbol = symbol,
+        .image = "qmmf",
+        .threads = 256,
+        .dynamic = dynamic,
+        .opt_in = true,
+        .min_sm = 120,
+    }, .usage = usage(regs), .later_pending = true };
+}
+
+pub const records = [_]registry.CudaRecord{
+    record(false, false),                                                             record(false, true),                                                             record(true, false),                                                                         record(true, true),                                                                         k32(false), k32(true),
+    mxRecord("qmmf MXFP8 prompt 128x128 bf16", "tf_qmmf_prompt_mx_bf16", 74496, 175), mxRecord("qmmf MXFP8 prompt 128x128 fp32", "tf_qmmf_prompt_mx_f32", 74496, 175), mxRecord("qmmf MXFP8 prompt 128x128 two-stage bf16", "tf_qmmf_prompt_mx2_bf16", 49664, 128), mxRecord("qmmf MXFP8 prompt 128x128 two-stage fp32", "tf_qmmf_prompt_mx2_f32", 49664, 128),
+};
 
 test "qmmf prompt launch records hold nvcc 13.0's usage on sm_12x, later releases pending" {
     try std.testing.expectEqual(@as(usize, 0), try registry.checkCuda(std.testing.allocator, records[0..4], true));
@@ -52,7 +67,7 @@ test "qmmf prompt launch records hold nvcc 13.0's usage on sm_12x, later release
 }
 
 test "qmmf prompt K32 records hold nvcc 13.0 usage and keep later compilers pending" {
-    for (records[4..]) |r| {
+    for (records[4..6]) |r| {
         try std.testing.expectEqual(@as(u32, 256), r.launch.threads);
         try std.testing.expectEqual(@as(u32, 49152), r.launch.dynamic);
         try std.testing.expect(r.launch.opt_in and !r.geometry_pending);
@@ -68,3 +83,16 @@ test "qmmf prompt K32 records hold nvcc 13.0 usage and keep later compilers pend
             try std.testing.expectEqual(registry.none, registry.usageFor(r, release));
     }
 }
+
+test "qmmf MXFP8 prompt records hold nvcc 13.0 usage on sm_12x, later releases pending" {
+    for (records[6..]) |r| {
+        try std.testing.expectEqual(@as(u32, 256), r.launch.threads);
+        try std.testing.expect(r.launch.opt_in and !r.geometry_pending);
+        try std.testing.expect(registry.usageFor(r, .{ .major = 13, .minor = 0 })[4].regs > 0);
+        for ([_]limits.Nvcc{ .{ .major = 13, .minor = 2 }, .{ .major = 13, .minor = 3 } }) |rel|
+            try std.testing.expectEqual(registry.none, registry.usageFor(r, rel));
+    }
+    try std.testing.expectEqual(@as(u32, 74496), records[6].launch.dynamic);
+    try std.testing.expectEqual(@as(u32, 49664), records[8].launch.dynamic);
+    try std.testing.expectEqual(@as(usize, 0), try registry.checkCuda(std.testing.allocator, records[6..], true));
+}
