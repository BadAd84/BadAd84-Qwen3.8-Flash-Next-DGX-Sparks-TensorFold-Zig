commit 859555b2fa5fec343d129a5f044ae630f81afe94
Author: Adam Hillson <--show-origin>
Date:   Tue Nov 10 21:31:57 2026 +0000

    flashnext: the 1.2.6 integration fixes (compile, initialisers, cache formats, contract and test wiring)
    
    Applying the levers' 1.2.4-era code to v1.2.6's tree needed corrections the per-lever patches could not carry.
    This patch is those corrections, each proven by the compile, a boot or the first request:
    
    - cuda_prompt.zig: Engine.initRank's `e.graphs = .{}` restored (the kv8 hunk had replaced it with `e.kv = .bf16`,
      so the graph caches were undefined memory and the first graph use panicked).
    - cuda_mtp_draft.zig: the draft head's caches are bf16 rows again, sized `sizes.kvBytes(cap, head_heads)` as
      upstream, with the estimate scaled by cap as well. The kv8 hunk priced them as one fp8 row, so a kept prompt
      state's copy ran past a 1,024-byte cache (cuMemcpyDtoDAsync invalid value) and a kernel then faulted.
    - cuda_snap.zig: the head's pieces and bytes are bf16 whatever the sequence's format, and its format check says so.
    - cuda_ple_cache.zig: the duplicated prelude removed, Reader.create qualified at its call site.
    - cuda_ple.zig: the cuda_ple_reader.zig import the reader fields need, max_shards made pub.
    - cuda_glue.zig: the three attn*On helpers drop an unused Glue parameter and cast the shared-memory size to u32.
    - cuda_snap.zig: the Kv import, and the tail offset priced as bf16.
    - cuda_tile_kernels.zig: the fexp_up field its loader already set, the hcn_updbg launches and fn_hcn_peak.
    - qmmf_body.cuh: the q12 call relies on template deduction.
    - flashnext_kv8_pending.zig: the launch records measured for this tree (nvcc 13.x, sm_80/86/89/120/121).
    - tests/cuda/flashnext_kv8_tests.zig: attnFused's new pg argument in the fp8 comparison call.

diff --git a/zig/src/core/contract/flashnext_kv8_pending.zig b/zig/src/core/contract/flashnext_kv8_pending.zig
index 575222cb7..e8b6c98b8 100644
--- a/zig/src/core/contract/flashnext_kv8_pending.zig
+++ b/zig/src/core/contract/flashnext_kv8_pending.zig
@@ -1 +1,48 @@
-//! --kv-cache fp8 launches: nvcc 13.3 resources, five SM targets; reference: tests/cuda/flashnext_kv8_tests.zig
+//! Flash Next's --kv-cache fp8 launches: measured nvcc 13.3 resources for all five SM targets. The fp8 kernels
+//! launch exactly as their bf16 siblings (the same grids, blocks and dynamic shared bytes), so each record's
+//! launch is the sibling's; only the compiled resources differ. The float64 reference is the device test
+//! (tests/cuda/flashnext_kv8_tests.zig): the quantizing write must equal the CPU format model byte for byte and
+//! the widening reads must equal the bf16 kernels on the dequantized rows, which carry the fp64-checked sums.
+//! Measured by compiling zig/kernels/cuda/flashnext_attn.cu for sm_80, sm_86, sm_89, sm_120 and sm_121 with
+//! nvcr.io/nvidia/pytorch:26.07-py3's nvcc and reading `cuobjdump -res-usage`, in gpu_builds.zig's target order.
+const registry = @import("registry.zig");
+pub const records = [_]registry.CudaRecord{
+    .{ .launch = .{ .name = "flashnext_attn fn_attn_prep_kv8", .symbol = "fn_attn_prep_kv8", .image = "flashnext_attn", .threads = 256 }, .usage = .{
+        .{ .regs = 32, .static = 128, .bound = 256 },
+        .{ .regs = 36, .static = 128, .bound = 256 },
+        .{ .regs = 36, .static = 128, .bound = 256 },
+        .{ .regs = 32, .static = 1152, .bound = 256 },
+        .{ .regs = 32, .static = 1152, .bound = 256 },
+    } },
+    .{ .launch = .{ .name = "flashnext_attn fn_attn_prep_media_kv8", .symbol = "fn_attn_prep_media_kv8", .image = "flashnext_attn", .threads = 256 }, .usage = .{
+        .{ .regs = 32, .static = 128, .bound = 256 },
+        .{ .regs = 36, .static = 128, .bound = 256 },
+        .{ .regs = 36, .static = 128, .bound = 256 },
+        .{ .regs = 32, .static = 1152, .bound = 256 },
+        .{ .regs = 32, .static = 1152, .bound = 256 },
+    } },
+    .{ .launch = .{ .name = "flashnext_attn fn_attn_chunks_kv8", .symbol = "fn_attn_chunks_kv8", .image = "flashnext_attn", .threads = 128, .dynamic = 26624, .opt_in = true }, .usage = .{
+        .{ .regs = 93, .static = 640, .bound = 128 },
+        .{ .regs = 93, .static = 640, .bound = 128 },
+        .{ .regs = 80, .static = 640, .bound = 128 },
+        .{ .regs = 96, .static = 1664, .bound = 128 },
+        .{ .regs = 96, .static = 1664, .bound = 128 },
+    } },
+    .{ .launch = .{ .name = "flashnext_attn fn_attn_fused_kv8", .symbol = "fn_attn_fused_kv8", .image = "flashnext_attn", .threads = 128, .dynamic = 26624, .opt_in = true }, .usage = .{
+        .{ .regs = 128, .static = 640, .bound = 128 },
+        .{ .regs = 128, .static = 640, .bound = 128 },
+        .{ .regs = 138, .static = 640, .bound = 128 },
+        .{ .regs = 128, .static = 1664, .bound = 128 },
+        .{ .regs = 128, .static = 1664, .bound = 128 },
+    } },
+};
+test "Flash Next kv8 launches: measured resources satisfy every SM launch limit" {
+    const t = @import("std").testing;
+    for (records) |r| {
+        try t.expectEqual(@as(usize, 0), try registry.checkCuda(t.allocator, &.{r}, true));
+        for (r.usage) |u| {
+            try t.expect(u.regs > 0);
+            try t.expectEqual(r.launch.threads, u.bound);
+        }
+    }
+}
