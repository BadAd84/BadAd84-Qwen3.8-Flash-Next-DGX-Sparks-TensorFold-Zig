+/// Device bytes each admitted stream allocates at a `window`-token cache: its sequence and, with the MTP head (`head_ids`
+/// its draft vocabulary, null without it), the head's cache and window buffers, in the engine's KV format.
+pub fn streamBytes(kv: prompt.kv_format.Kv, window: usize, head_ids: ?usize, chunk: usize, tp_head: bool, h: @import("cuda_heads.zig").Heads) usize {
+    var n = prompt.seqBytesFor(kv, window, h);
+    if (head_ids) |ids| {
+        n += mtp.Draft.bytesFor(kv, window, ids, chunk, h);
+    } else if (tp_head) n += mtp.Draft.bytesFor(kv, window, 1, chunk, h);
+    return n;
+}
+
+/// A stream's image rows: the features it holds and 16 bytes of each context position's row bookkeeping.
+fn visionStreamBytes(v: anytype, context: usize) usize {
+    return @as(usize, v.image_tokens) * @import("cuda_prompt_wt.zig").dims * 2 + 16 * context;
+}
