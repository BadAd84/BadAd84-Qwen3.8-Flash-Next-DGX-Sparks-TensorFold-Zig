+++ b/zig/src/platform/environment_test.zig
@@ -86,6 +86,7 @@ const valid = [_]Case{
     .{ .name = "TF_FLASHNEXT_HC2_UP", .raw = "48", .n = 48 },
     .{ .name = "TF_FLASHNEXT_HEAD_PIECE", .raw = "1024", .n = 1024 },
     .{ .name = "TF_FLASHNEXT_HEAD_PIECE", .raw = "0", .n = 0 },
+    .{ .name = "TF_ROCE_GID_INDEX", .raw = "2147483647", .n = 2147483647 },
     .{ .name = "TF_DRAMA_PREFILL_ROWS", .raw = " 128 ", .n = 128 },
     .{ .name = "TF_DRAMA_REFERENCE_CACHE", .raw = "0", .n = 0 },
     .{ .name = "TF_GEMMA4_CHUNK_SOLO", .raw = "2048", .n = 2048 },
