From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Mon, 9 Nov 2026 11:18:15 +0000
Subject: [PATCH 23/28] flashnext: the roce valid case is back in the
 environment test

The covered check requires a valid case per rule row, and my insert replaced the
TF_ROCE_GID_INDEX one.
---
 zig/src/families/flashnext/cuda_batch.zig | 1 +
 zig/src/families/flashnext/cuda_glue.zig  | 2 ++
 zig/src/platform/environment_test.zig     | 1 +
 3 files changed, 4 insertions(+)

diff --git a/zig/src/families/flashnext/cuda_batch.zig b/zig/src/families/flashnext/cuda_batch.zig
index 499e5654b..80615a3dd 100644
--- a/zig/src/families/flashnext/cuda_batch.zig
+++ b/zig/src/families/flashnext/cuda_batch.zig
@@ -14,6 +14,7 @@ const hc = @import("cuda_batch_hc.zig");
 const gdn_lanes = @import("cuda_batch_gdn_lanes.zig");
 const batch_lanes = @import("cuda_batch_lanes.zig");
 const tiles = @import("cuda_tiles.zig");
+const tk = @import("cuda_tile_kernels.zig");
 const moe_native = @import("cuda_moe_native.zig");
 const zs = @import("cuda_zero_slice.zig");
 const ops = @import("cuda_batch_ops.zig");
diff --git a/zig/src/families/flashnext/cuda_glue.zig b/zig/src/families/flashnext/cuda_glue.zig
index 04ad040b6..9c506630d 100644
--- a/zig/src/families/flashnext/cuda_glue.zig
+++ b/zig/src/families/flashnext/cuda_glue.zig
@@ -35,6 +35,7 @@ const Fns = struct {
     wb0: cuda.Function,
     wb_moe: cuda.Function,
     wb_moe_sh: cuda.Function,
+    wb_slices: cuda.Function,
     // each writeback with fn_hc_normalize in one block a row (2560 columns, 4 streams): the same bits
     wbn0: cuda.Function,
     wbn_moe: cuda.Function,
@@ -136,6 +137,7 @@ pub const Glue = struct {
             .wb0 = try g.hc.function("fn_hc_writeback0"),
             .wb_moe = try g.hc.function("fn_hc_writeback_moe"),
             .wb_moe_sh = try g.hc.function("fn_hc_writeback_moe_sh"),
+            .wb_slices = try g.hc.function("fn_hc_writeback_slices"),
             .wbn0 = try g.hc.function("fn_hc_writeback_norm0"),
             .wbn_moe = try g.hc.function("fn_hc_writeback_norm_moe"),
             .wbn_slices = try g.hc.function("fn_hc_writeback_norm_slices"),
