 }
 
-#define TF_PROMPT_MX(NAME, BM, BN, WM, WN, ST, F32)                                                                   \
-    extern "C" __global__ void __launch_bounds__(WM * WN * 32) NAME(                                                  \
+#define TF_PROMPT_MX(NAME, BM, BN, WM, WN, ST, F32, MINB)                                                             \
+    extern "C" __global__ void __launch_bounds__(WM * WN * 32, MINB) NAME(                                            \
         const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w, const uint8_t* __restrict__ bs,    \
         float scale, void* __restrict__ out, int M, int N, int K, int npad, int ldx, int group) {                     \
         tf_qmmf::prompt_mx_body<BM, BN, WM, WN, ST, F32>(x, w, bs, scale, out, M, N, K, npad, ldx, group);            \
@@ -379,5 +379,8 @@ __device__ __forceinline__ void prompt_mx_body(
 }  // namespace tf_qmmf
 
 // Names the Zig launcher loads (qmmf.zig Lane.prompt_mx): block rows x columns, warps, stages, bf16 or fp32 out.
-TF_PROMPT_MX(tf_qmmf_prompt_mx_bf16, 128, 128, 2, 4, 3, false)
-TF_PROMPT_MX(tf_qmmf_prompt_mx_f32, 128, 128, 2, 4, 3, true)
+TF_PROMPT_MX(tf_qmmf_prompt_mx_bf16, 128, 128, 2, 4, 3, false, 1)
+TF_PROMPT_MX(tf_qmmf_prompt_mx_f32, 128, 128, 2, 4, 3, true, 1)
+// The same tile and arithmetic with two stages and two blocks an SM (TF_FLASHNEXT_PROMPT_GEMM2=1), at the same bits.
+TF_PROMPT_MX(tf_qmmf_prompt_mx2_bf16, 128, 128, 2, 4, 2, false, 2)
+TF_PROMPT_MX(tf_qmmf_prompt_mx2_f32, 128, 128, 2, 4, 2, true, 2)
diff --git a/zig/src/cuda/qmmf.zig b/zig/src/cuda/qmmf.zig
index 4e920db81..85069b878 100644
--- a/zig/src/cuda/qmmf.zig
+++ b/zig/src/cuda/qmmf.zig
@@ -137,13 +137,18 @@ pub const reduce_symbols = [2][:0]const u8{
     "_ZN7tf_qmmf13reduce_kernelILb1EEEvPKfPvxif",
 };
 const row_tiles = [_]u32{ 16, 32, 64 };
-/// The MXFP8 prompt tile's dynamic shared bytes (qmmf.cu Tile<MXFP8, 128, 128, 2, 4, 3>::SMEM).
-const prompt_mx_shared: u32 = 3 * ((128 * 128 + 128 * group + 128 * 2 + 127) / 128 * 128);
+/// The prompt tile's dynamic shared bytes: 3 stages of 128 input rows, 128 weight columns and their scales.
+const prompt_mx_stage: u32 = (128 * 128 + 128 * group + 128 * 2 + 127) / 128 * 128;
+const prompt_mx_shared: u32 = 3 * prompt_mx_stage;
+/// The two-stage, two-blocks-an-SM variant (mx2_tile): both blocks fit an SM shared memory.
+const prompt_mx2_shared: u32 = 2 * prompt_mx_stage;
 
 /// What a call writes: bf16 rows, or the fp32 sums unrounded (a tensor-parallel rank's partial rows).
 pub const Out = enum { bf16, f32 };
 /// Narrowest MXFP8 projection the relaxed 128 x 128 prompt tile takes in a prompt pass; 0 (the default): none.
 pub var prompt_mx_min_n: usize = 0;
+/// TF_FLASHNEXT_PROMPT_GEMM2=1: the prompt tile runs with two stages and two blocks an SM, same arithmetic and bits.
+pub var mx2_tile: bool = false;
 
 fn loadTiles(mod: Module, comptime mode: Mode, comptime wide: bool) ![7]Function {
     var set: [7]Function = undefined;
@@ -191,6 +196,7 @@ pub const Lane = struct {
     shared_down: [4]Function = undefined,
     prompt: ?[2][2]Function = null, // Out, then plain / fused; loadPrompt() fills it on sm_12x
     prompt_mx: [2]Function = undefined, // by Out: the relaxed MXFP8 prompt tile (a lane built by hand never launches it)
+    prompt_mx2: [2]Function = undefined, // by Out: the same tile, two stages, two blocks an SM (mx2_tile)
     prompt_k32: ?[2]Function = null, // Out; unsplit BF16 prompt calls, loadPrompt() fills it on sm_12x
     prompt_sms: usize = 0, // the device's SMs: the tile runs when its blocks fill more than half of them
     clusters: bool, // sm_90 on: slices meet in a cluster's shared memory
@@ -216,6 +222,10 @@ pub const Lane = struct {
             f.* = try mod.function(name);
             try f.allowDynamicShared(prompt_mx_shared);
         }
+        for (&l.prompt_mx2, [_][:0]const u8{ "tf_qmmf_prompt_mx2_bf16", "tf_qmmf_prompt_mx2_f32" }) |*f, name| {
+            f.* = try mod.function(name);
+            try f.allowDynamicShared(prompt_mx2_shared);
+        }
         inline for (.{ Mode.mxfp8, Mode.bf16 }, 0..) |mode, mi| inline for (.{ false, true }, 0..) |wide, oi| inline for (.{ false, true }, 0..) |cl, ci| {
             const f = try mod.function(halfSymbol(mode, cl, wide));
             try f.allowDynamicShared(halfShared(mode));
@@ -290,10 +300,10 @@ pub const Lane = struct {
         args.add(@as(i32, @intCast(w.npad)));
         args.add(@as(i32, @intCast(if (m == 1) w.k else ldx)));
         args.add(@as(i32, @intCast(band)));
-        try launch_.launch(l.prompt_mx[@backingInt(out)], .{
+        try launch_.launch((if (mx2_tile) l.prompt_mx2 else l.prompt_mx)[@backingInt(out)], .{
             .grid = .{ .x = @intCast(rows_t * ((w.n + 127) / 128)), .y = 1, .z = 1 },
             .block = .{ .x = 256, .y = 1, .z = 1 },
-            .shared = prompt_mx_shared,
+            .shared = if (mx2_tile) prompt_mx2_shared else prompt_mx_shared,
         }, s, &args);
     }
 
@@ -568,3 +578,8 @@ test "a cut weight pinned to the whole weight's K slices plans as the whole one
     try std.testing.expectEqual(@as(u32, 4), (try pinned(cut, 4)).sk); // 40 groups: 10 a slice
     for ([_]u32{ 0, 3, 8, 16 }) |bad| try std.testing.expectError(error.BadSplit, pinned(cut, bad)); // 8: 5 a slice
 }
+
+test "the two-stage prompt tile fits two blocks in an SM" {
+    try std.testing.expectEqual(@as(u32, 74496), prompt_mx_shared);
+    try std.testing.expectEqual(@as(u32, 49664), prompt_mx2_shared);
+}
