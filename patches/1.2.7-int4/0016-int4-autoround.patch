diff --git a/zig/src/families/flashnext/cuda_int4.zig b/zig/src/families/flashnext/cuda_int4.zig
new file mode 100644
index 0000000000..429d9fc417
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_int4.zig
@@ -0,0 +1,505 @@
+//! GPTQ int4 weights of the INT4-AutoRound checkpoint (azampatti/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound): the
+//! routed experts and the lm_head, symmetric 4-bit codes with an fp16 scale per 128 inputs and output column
+//! (AutoGPTQ's v1 layout: qweight int32 [K/8, N], eight codes a word low nibble first; qzeros all 7, so every zero
+//! point is 8; no g_idx). zig/kernels/cuda/fn_int4.cu runs them: exact weights in bf16 MMAs, one fp32 MMA chain a
+//! group, groups added with fmaf in order, so a row's bits never depend on the other rows or the plan's items.
+//! Source: the production branch's zig/src/families/flashnext/cuda_int4.zig and fn_int4.cu at 5c3e3e29 (our own
+//! engine fork), with the plan types taken from cuda.grouped and the kernels loaded from a driver.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const grouped = cuda.grouped;
+/// experts.cu's plan tile: the items of a decode call hold up to 16 pairs.
+pub const plan_tile: usize = 16;
+
+/// One layer's routed experts: up = [E][gate, up] and down = [E] packed matrices with their scales.
+pub const Experts = struct {
+    up: u64 = 0,
+    up_s: u64 = 0,
+    down: u64 = 0,
+    down_s: u64 = 0,
+    count: u32 = 0,
+    /// the intermediate width (gate/up outputs, down inputs)
+    width: u32 = 0,
+    dims: u32 = 0,
+    /// down's input group: 128, or 64 where a slice of the width cuts a group of 128
+    gs_down: u32 = 128,
+};
+
+/// One packed matrix [n outputs, k inputs] (the head).
+pub const Mat = struct { w: u64 = 0, s: u64 = 0, n: u32 = 0, k: u32 = 0, gs: u32 = 128 };
+
+pub const checkpoint_group = 128;
+
+/// Words a packed [n, k] matrix holds (8 codes a word).
+pub fn wordsOf(n: usize, k: usize) usize {
+    return n * k / 8;
+}
+
+/// fp16 scales a packed [n, k] matrix holds at groups of `gs`.
+pub fn scalesOf(n: usize, k: usize, gs: usize) usize {
+    return n * (k / gs);
+}
+
+/// A GPTQ word's eight codes (input j at nibble j) reordered for the kernel: nibble i = input 2i, nibble i + 4 =
+/// input 2i + 1 (the pair at shift 4p is inputs 2p, 2p + 1).
+pub fn shuffle(w: u32) u32 {
+    var out: u32 = 0;
+    inline for (0..4) |i| {
+        out |= ((w >> (8 * i)) & 0xF) << (4 * i);
+        out |= ((w >> (8 * i + 4)) & 0xF) << (4 * (i + 4));
+    }
+    return out;
+}
+
+/// One checkpoint matrix: qweight int32 [k_full / 8, n_full] and scales fp16 [k_full / 128, n_full], little-endian.
+pub const Source = struct { qweight: []const u8, scales: []const u8, n_full: usize, k_full: usize };
+
+pub const Slice = struct { n0: usize, n: usize, k0: usize, k: usize, gs: usize };
+
+/// A slice the kernels take: groups of 64 or 128 inside the source's groups of 128, whole n8 tiles, in bounds.
+fn checkSlice(src: Source, sl: Slice) !void {
+    if (sl.gs != 64 and sl.gs != 128) return error.BadSlice;
+    if (sl.n == 0 or sl.k == 0 or sl.n % 8 != 0 or sl.k % sl.gs != 0 or sl.k0 % sl.gs != 0) return error.BadSlice;
+    if (sl.n0 + sl.n > src.n_full or sl.k0 + sl.k > src.k_full or src.k_full % checkpoint_group != 0) return error.BadSlice;
+    if (src.qweight.len != src.k_full / 8 * src.n_full * 4 or src.scales.len != src.k_full / checkpoint_group * src.n_full * 2) return error.BadLength;
+}
+
+/// Columns [n0, n0 + n) and inputs [k0, k0 + k) of `src` in the kernel's word order: [n/8][k/gs][32][gs/32].
+pub fn packWords(src: Source, sl: Slice, out: []u32) !void {
+    try checkSlice(src, sl);
+    if (out.len != wordsOf(sl.n, sl.k)) return error.BadLength;
+    const kg = sl.k / sl.gs;
+    const per = sl.gs / 32;
+    var at: usize = 0;
+    for (0..sl.n / 8) |nt| for (0..kg) |g| for (0..32) |lane| {
+        const col = sl.n0 + nt * 8 + lane / 4;
+        const t = lane % 4;
+        for (0..per) |b| {
+            const kp = (sl.k0 + g * sl.gs + b * 32) / 8 + t;
+            out[at] = shuffle(std.mem.readInt(u32, src.qweight[(kp * src.n_full + col) * 4 ..][0..4], .little));
+            at += 1;
+        }
+    };
+}
+
+/// The scales of the same slice: fp16 bits [n/8][k/gs][8] (a group of 64 repeats its group of 128's scale).
+pub fn packScales(src: Source, sl: Slice, out: []u16) !void {
+    try checkSlice(src, sl);
+    const kg = sl.k / sl.gs;
+    if (out.len != scalesOf(sl.n, sl.k, sl.gs)) return error.BadLength;
+    var at: usize = 0;
+    for (0..sl.n / 8) |nt| for (0..kg) |g| for (0..8) |c| {
+        const col = sl.n0 + nt * 8 + c;
+        const row = (sl.k0 + g * sl.gs) / checkpoint_group;
+        out[at] = std.mem.readInt(u16, src.scales[(row * src.n_full + col) * 2 ..][0..2], .little);
+        at += 1;
+    };
+}
+
+/// AutoGPTQ v1 symmetric zero points: every nibble of qzeros [k_full / 128, n_full / 8] is 7 (8 minus one).
+pub fn zerosAreSymmetric(qzeros: []const u8) bool {
+    var i: usize = 0;
+    while (i + 8 <= qzeros.len) : (i += 8) if (std.mem.readInt(u64, qzeros[i..][0..8], .little) != 0x7777777777777777) return false;
+    while (i < qzeros.len) : (i += 1) if (qzeros[i] != 0x77) return false;
+    return true;
+}
+
+/// Code q of input k, column n of `src` (0..15; the weight is (q - 8) * scale).
+pub fn code(src: Source, n: usize, k: usize) u4 {
+    const w = std.mem.readInt(u32, src.qweight[((k / 8) * src.n_full + n) * 4 ..][0..4], .little);
+    return @intCast((w >> @intCast(4 * (k % 8))) & 0xF);
+}
+
+pub fn scale(src: Source, n: usize, k: usize) f32 {
+    const h: f16 = @bitCast(std.mem.readInt(u16, src.scales[((k / checkpoint_group) * src.n_full + n) * 2 ..][0..2], .little));
+    return @floatCast(h);
+}
+
+/// The dequantized weight of input k, column n: (q - 8) * scale, exact in fp32.
+pub fn weight(src: Source, n: usize, k: usize) f32 {
+    return @as(f32, @floatFromInt(@as(i32, code(src, n, k)) - 8)) * scale(src, n, k);
+}
+
+/// A whole matrix packed for the kernels and uploaded: the head (groups of 128 over all its inputs).
+pub fn uploadMat(gpa: std.mem.Allocator, d: *const cuda.Driver, src: Source) !struct { mat: Mat, w: cuda.DeviceBuffer, s: cuda.DeviceBuffer } {
+    const sl: Slice = .{ .n0 = 0, .n = src.n_full, .k0 = 0, .k = src.k_full, .gs = checkpoint_group };
+    const words = try gpa.alloc(u32, wordsOf(sl.n, sl.k));
+    defer gpa.free(words);
+    try packWords(src, sl, words);
+    const scales = try gpa.alloc(u16, scalesOf(sl.n, sl.k, sl.gs));
+    defer gpa.free(scales);
+    try packScales(src, sl, scales);
+    var wb = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(words));
+    errdefer wb.free();
+    const sb = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(scales));
+    return .{ .mat = .{ .w = wb.ptr, .s = sb.ptr, .n = @intCast(sl.n), .k = @intCast(sl.k), .gs = checkpoint_group }, .w = wb, .s = sb };
+}
+
+// ---- the kernels -------------------------------------------------------------------------------------------------
+
+const warps = 4;
+/// [kind: gate/up SwiGLU (gs 128), down fp32 gs 128, down bf16 gs 128, fp32 gs 64, bf16 gs 64][NT: 1, 2, 4]
+const n_kinds = 5;
+const nts = [_]usize{ 1, 2, 4 };
+/// row tiles of 16 a pass: 1 (decode), 2 (prompt items of up to 64 pairs, the head's 32-row items)
+const mts = [_]usize{ 1, 2 };
+
+fn symbol(comptime gs: usize, comptime nt: usize, comptime mt: usize, comptime mats: usize, comptime epi: usize) [:0]const u8 {
+    return std.fmt.comptimePrint("_ZN10tf_fn_int411int4_kernelILi{d}ELi{d}ELi{d}ELi{d}ELi{d}ELi4EEEvPK13__nv_bfloat16iiPKjPK6__halfiiPKiSA_SA_iPvifi", .{ gs, nt, mt, mats, epi });
+}
+
+/// The plan tile of prompt calls (items of up to 64 pairs, two 16-row tiles a pass) and the pairs from which it is
+/// taken; smaller calls take plan_tile (16) and one tile a pass.
+pub const prompt_tile: usize = 64;
+pub const prompt_pairs: usize = 2048;
+
+/// Every call takes 16-pair items unless TF_FLASHNEXT_INT4_TILE=64 (the same bits either way).
+pub fn tileFor(pairs: usize) usize {
+    const want = if (std.c.getenv("TF_FLASHNEXT_INT4_TILE")) |v| std.fmt.parseInt(usize, std.mem.span(v), 10) catch plan_tile else plan_tile;
+    return if (want == prompt_tile and pairs >= prompt_pairs) prompt_tile else plan_tile;
+}
+
+const kinds = [n_kinds]struct { gs: usize, mats: usize, epi: usize }{
+    .{ .gs = 128, .mats = 2, .epi = 2 }, .{ .gs = 128, .mats = 1, .epi = 0 }, .{ .gs = 128, .mats = 1, .epi = 3 },
+    .{ .gs = 64, .mats = 1, .epi = 0 },  .{ .gs = 64, .mats = 1, .epi = 3 },
+};
+
+pub const symbols = blk: {
+    var out: [n_kinds][nts.len][mts.len][:0]const u8 = undefined;
+    for (kinds, 0..) |k, i| for (nts, 0..) |nt, j| for (mts, 0..) |mt, q| {
+        out[i][j][q] = symbol(k.gs, nt, mt, k.mats, k.epi);
+    };
+    break :blk out;
+};
+
+/// The routed down of prompt calls (int4_prompt_kernel: a block an (item of up to 64 pairs, 128 columns), 8 warps).
+pub const prompt_down_tile: usize = 64;
+const prompt_threads = 256;
+/// [gs 128, 64][fp32, bf16 out]: stages 2 (128) and 3 (64)
+const prompt_stages = [2]usize{ 2, 3 };
+
+fn promptSymbol(comptime gs: usize, comptime epi: usize, comptime st: usize) [:0]const u8 {
+    return std.fmt.comptimePrint("_ZN10tf_fn_int418int4_prompt_kernelILi{d}ELi1ELi{d}ELi2ELi4ELi2ELi4ELi{d}EEEvPK13__nv_bfloat16iiPKjPK6__halfiiPKiSA_SA_Pvifi", .{ gs, epi, st });
+}
+
+pub const prompt_symbols = [2][2][:0]const u8{
+    .{ promptSymbol(128, 0, 2), promptSymbol(128, 3, 2) },
+    .{ promptSymbol(64, 0, 3), promptSymbol(64, 3, 3) },
+};
+
+/// int4_prompt_kernel's dynamic shared memory: stages x (64 rows of a group, 16 n8 tiles' words and scales).
+pub fn promptSmem(gs: usize, stages: usize) u32 {
+    return @intCast(stages * (64 * gs * 2 + 16 * 32 * (gs / 32) * 4 + 16 * 16));
+}
+
+/// The routed gate/up of prompt calls on int4_prompt_kernel: {row warps, column warps, row tiles a warp, n8 tiles a
+/// warp, stages}, a block 64 rows x 128 columns (TF_FLASHNEXT_INT4_PROMPT_GATE_UP=1; the same bits).
+pub const PromptGu = struct { wr: usize, wc: usize, rt: usize, wn: usize, stages: usize };
+pub const prompt_gu: PromptGu = .{ .wr = 2, .wc = 4, .rt = 2, .wn = 4, .stages = 3 };
+
+pub const prompt_gu_symbol = std.fmt.comptimePrint("_ZN10tf_fn_int418int4_prompt_kernelILi128ELi2ELi2ELi{d}ELi{d}ELi{d}ELi{d}ELi{d}EEEvPK13__nv_bfloat16iiPKjPK6__halfiiPKiSA_SA_Pvifi", .{ prompt_gu.wr, prompt_gu.wc, prompt_gu.rt, prompt_gu.wn, prompt_gu.stages });
+
+/// int4_prompt_kernel's dynamic shared memory for `mats` matrices, `br` rows and `bt` n8 tiles a block.
+pub fn promptSmemOf(gs: usize, mats: usize, br: usize, bt: usize, stages: usize) u32 {
+    return @intCast(stages * (br * gs * 2 + mats * bt * 32 * (gs / 32) * 4 + mats * bt * 16));
+}
+
+pub fn promptGuRows(p: PromptGu) usize {
+    return p.wr * p.rt * 16;
+}
+pub fn promptGuTiles(p: PromptGu) usize {
+    return p.wc * p.wn;
+}
+pub fn promptGuSmem(p: PromptGu) u32 {
+    return promptSmemOf(128, 2, promptGuRows(p), promptGuTiles(p), p.stages);
+}
+
+/// sm_121's (GB10's) opt-in shared memory a block.
+pub const sm121_smem_optin = 101376;
+comptime {
+    std.debug.assert(promptGuSmem(prompt_gu) <= sm121_smem_optin);
+}
+
+/// Whether a block of prompt_gu fits a GPU: its dynamic plus `static` shared memory within the opt-in limit.
+pub fn promptGuFits(static: usize, optin: usize) bool {
+    return promptGuSmem(prompt_gu) + static <= optin;
+}
+
+/// Whether gateUpPrompt takes a call on `ex`: whole column blocks, K groups of 128, aligned rows, words and stores.
+pub fn gateUpPromptFits(ex: Experts, x: u64, x_stride: usize, out: u64) bool {
+    const cols = 8 * promptGuTiles(prompt_gu);
+    return ex.width % cols == 0 and ex.dims % 128 == 0 and x_stride % 8 == 0 and x % 16 == 0 and ex.up % 16 == 0 and ex.up_s % 16 == 0 and out % 8 == 0;
+}
+
+pub const Kernels = struct {
+    module: cuda.Module,
+    fns: [n_kinds][nts.len][mts.len]cuda.Function,
+    /// resident blocks of each function on this GPU (occupancy x SMs)
+    blocks: [n_kinds][nts.len][mts.len]usize,
+    /// the prompt down: [gs 128, 64][fp32, bf16] and their resident blocks
+    pdown: [2][2]cuda.Function,
+    pdown_blocks: [2][2]usize,
+    /// the head's row tiles a pass past 16 rows: 2 (TF_FLASHNEXT_HEAD_ROW_TILES=2) reads the weights once for 32 rows
+    head_mt: usize = 1,
+    pgu_fn: cuda.Function,
+    pgu_blocks: usize,
+    pgu_ready: bool = false,
+    pgu: bool = false,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var device: c_int = 0;
+        var sms_c: c_int = 0;
+        var optin_c: c_int = 0;
+        try d.check(d.api.cuDeviceGet(&device, 0), "cuDeviceGet");
+        try d.check(d.api.cuDeviceGetAttribute(&sms_c, .multiprocessor_count, device), "cuDeviceGetAttribute");
+        try d.check(d.api.cuDeviceGetAttribute(&optin_c, .max_shared_memory_per_block_optin, device), "cuDeviceGetAttribute");
+        const sms: usize = @intCast(sms_c);
+        var k: Kernels = undefined;
+        k.module = try cuda.Module.load(d, cuda.kernels.fn_int4);
+        errdefer k.module.unload();
+        for (symbols, 0..) |row, i| for (row, 0..) |cols, j| for (cols, 0..) |s, q| {
+            k.fns[i][j][q] = try k.module.function(s);
+            k.blocks[i][j][q] = @as(usize, @max(1, try k.fns[i][j][q].occupancy(warps * 32, 0))) * sms;
+        };
+        for (0..2) |g| for (0..2) |o| {
+            const sm = promptSmem(if (g == 0) 128 else 64, prompt_stages[g]);
+            k.pdown[g][o] = try k.module.function(prompt_symbols[g][o]);
+            try k.pdown[g][o].allowDynamicShared(sm);
+            k.pdown_blocks[g][o] = @as(usize, @max(1, try k.pdown[g][o].occupancy(prompt_threads, sm))) * sms;
+        };
+        const sm_gu = promptGuSmem(prompt_gu);
+        k.pgu_fn = try k.module.function(prompt_gu_symbol);
+        const static: usize = @intCast(try k.pgu_fn.attribute(.shared_size_bytes));
+        k.pgu_ready = promptGuFits(static, @intCast(optin_c));
+        k.pgu_blocks = 0;
+        if (k.pgu_ready) {
+            try k.pgu_fn.allowDynamicShared(sm_gu);
+            k.pgu_blocks = @as(usize, @max(1, try k.pgu_fn.occupancy(@intCast(prompt_gu.wr * prompt_gu.wc * 32), sm_gu))) * sms;
+        }
+        const want_pgu = if (std.c.getenv("TF_FLASHNEXT_INT4_PROMPT_GATE_UP")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+        k.pgu = want_pgu and k.pgu_ready;
+        k.head_mt = try headRowTiles(if (std.c.getenv("TF_FLASHNEXT_HEAD_ROW_TILES")) |v| std.mem.span(v) else null);
+        std.log.info("int4 kernels: prompt gate/up {s}, lm_head {s}", .{ if (k.pgu) "int4_prompt_kernel" else "int4_kernel", if (k.head_mt == 2) "32-row items past 16 rows" else "16-row items" });
+        return k;
+    }
+
+    pub fn deinit(k: *Kernels) void {
+        k.module.unload();
+    }
+};
+
+/// TF_FLASHNEXT_HEAD_ROW_TILES: the head's row tiles a pass for calls past 16 rows, 1 (unset) or 2; else refused.
+pub fn headRowTiles(v: ?[]const u8) !usize {
+    const s = v orelse return 1;
+    if (std.mem.eql(u8, s, "1")) return 1;
+    if (std.mem.eql(u8, s, "2")) return 2;
+    std.log.warn("TF_FLASHNEXT_HEAD_ROW_TILES={s} refused: 1 (16-row items) or 2 (32-row items)", .{s});
+    return error.BadSetting;
+}
+
+fn int(x: usize) c_int {
+    return @intCast(x);
+}
+
+/// The widest n8-tile count whose units still fill the GPU twice over (the same bits at any NT).
+fn pickNt(k: *const Kernels, kind: usize, max_items: usize, n: usize, q: usize) usize {
+    var j: usize = nts.len;
+    while (j > 1) {
+        j -= 1;
+        const units = max_items * (n / (8 * nts[j]));
+        if (n % (8 * nts[j]) == 0 and units >= 2 * k.blocks[kind][j][q] * warps) return j;
+    }
+    return 0;
+}
+
+fn launch(k: *const Kernels, s: cuda.Stream, kind: usize, max_items: usize, x: u64, x_stride: usize, slots: usize, w: u64, sc: u64, kk: usize, n: usize, p: ?grouped.Plan, rows: usize, out: u64, out_stride: usize, skip: c_int, force_nt: ?usize, mt: usize) !void {
+    // uint4 loads of the input rows, uint4/uint2 weight words, half2 scales, float2/bf16x2 stores
+    if (n % 8 != 0 or kk % kinds[kind].gs != 0 or x_stride % 8 != 0 or x % 16 != 0 or w % 16 != 0 or sc % 4 != 0 or out % 8 != 0) return error.Invalid;
+    const q = std.mem.indexOfScalar(usize, &mts, mt) orelse return error.Invalid;
+    const j = if (force_nt) |f| (std.mem.indexOfScalar(usize, &nts, f) orelse return error.Invalid) else pickNt(k, kind, max_items, n, q);
+    if (n % (8 * nts[j]) != 0) return error.Invalid;
+    const units = max_items * (n / (8 * nts[j]));
+    const grid = @min((units + warps - 1) / warps, k.blocks[kind][j][q]);
+    if (grid < 1) return;
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(int(x_stride));
+    a.add(int(slots));
+    a.add(w);
+    a.add(sc);
+    a.add(int(kk));
+    a.add(int(n));
+    if (p) |pl| {
+        a.add(pl.items);
+        a.add(pl.counts);
+        a.add(pl.members);
+    } else {
+        a.add(@as(u64, 0));
+        a.add(@as(u64, 0));
+        a.add(@as(u64, 0));
+    }
+    a.add(int(rows));
+    a.add(out);
+    a.add(int(out_stride));
+    a.add(@as(f32, 0));
+    a.add(skip);
+    try cuda.launch.launch(k.fns[kind][j][q], .{ .grid = .{ .x = @intCast(grid) }, .block = .{ .x = warps * 32 } }, s, &a);
+}
+
+/// The routed experts' gate/up with SwiGLU: x [R, D] token rows -> out [R * slots, width] bf16, a row per routed pair
+/// of the plan (items of expert `skip` untouched). `tile`: the plan's (tileFor: 64 makes two row tiles a pass).
+pub fn gateUp(k: *const Kernels, s: cuda.Stream, x: u64, x_stride: usize, ex: Experts, p: grouped.Plan, plan_slots: usize, plan_experts: usize, out: u64, rows: usize, skip: c_int, tile: usize) !void {
+    const items = grouped.maxItems(rows * plan_slots, plan_experts, tile);
+    try launch(k, s, 0, items, x, x_stride, plan_slots, ex.up, ex.up_s, ex.dims, ex.width, p, 0, out, ex.width, skip, null, if (tile > 16) 2 else 1);
+}
+
+/// The routed experts' down: act [R * slots, width] pair rows -> out [R * slots, D], fp32 (`f32_out`) or bf16.
+pub fn down(k: *const Kernels, s: cuda.Stream, act: u64, act_stride: usize, ex: Experts, p: grouped.Plan, plan_slots: usize, plan_experts: usize, out: u64, f32_out: bool, rows: usize, skip: c_int, tile: usize) !void {
+    const items = grouped.maxItems(rows * plan_slots, plan_experts, tile);
+    const kind: usize = switch (ex.gs_down) {
+        128 => if (f32_out) 1 else 2,
+        64 => if (f32_out) 3 else 4,
+        else => return error.Invalid,
+    };
+    try launch(k, s, kind, items, act, act_stride, 0, ex.down, ex.down_s, ex.width, ex.dims, p, 0, out, ex.dims, skip, null, if (tile > 16) 2 else 1);
+}
+
+/// The routed experts' down of a prompt call on int4_prompt_kernel: `down`'s outputs, byte for byte, from a plan
+/// whose items hold at most `prompt_down_tile` pairs.
+pub fn downPrompt(k: *const Kernels, s: cuda.Stream, act: u64, act_stride: usize, ex: Experts, p: grouped.Plan, plan_slots: usize, plan_experts: usize, out: u64, f32_out: bool, rows: usize, skip: c_int) !void {
+    const gs: usize = ex.gs_down;
+    const g: usize = switch (gs) {
+        128 => 0,
+        64 => 1,
+        else => return error.Invalid,
+    };
+    const n: usize = ex.dims;
+    const kk: usize = ex.width;
+    if (n % 128 != 0 or kk % gs != 0 or act_stride % 8 != 0 or act % 16 != 0 or ex.down % 16 != 0 or ex.down_s % 16 != 0 or out % 8 != 0) return error.Invalid;
+    const items = grouped.maxItems(rows * plan_slots, plan_experts, prompt_down_tile);
+    const units = items * (n / 128);
+    const f = k.pdown[g][@intFromBool(!f32_out)];
+    const grid = @min(units, k.pdown_blocks[g][@intFromBool(!f32_out)]);
+    if (grid < 1) return;
+    var a: cuda.Args = .{};
+    a.add(act);
+    a.add(int(act_stride));
+    a.add(@as(c_int, 0));
+    a.add(ex.down);
+    a.add(ex.down_s);
+    a.add(int(kk));
+    a.add(int(n));
+    a.add(p.items);
+    a.add(p.counts);
+    a.add(p.members);
+    a.add(out);
+    a.add(int(n));
+    a.add(@as(f32, 0));
+    a.add(skip);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(grid) }, .block = .{ .x = prompt_threads }, .shared = promptSmem(gs, prompt_stages[g]) }, s, &a);
+}
+
+/// Whether a prompt call of `pairs` routed pairs takes `downPrompt` (TF_FLASHNEXT_INT4_PROMPT_DOWN=0: never).
+pub fn promptDown(pairs: usize) bool {
+    if (std.c.getenv("TF_FLASHNEXT_INT4_PROMPT_DOWN")) |v| if (std.mem.eql(u8, std.mem.span(v), "0")) return false;
+    return pairs >= prompt_pairs;
+}
+
+/// The routed gate/up of a prompt call on int4_prompt_kernel (prompt_gu): `gateUp`'s outputs, byte for byte, from a
+/// plan whose items hold at most `prompt_tile` (64) pairs.
+pub fn gateUpPrompt(k: *const Kernels, s: cuda.Stream, x: u64, x_stride: usize, ex: Experts, p: grouped.Plan, plan_slots: usize, plan_experts: usize, out: u64, rows: usize, skip: c_int) !void {
+    const sh = prompt_gu;
+    const n: usize = ex.width;
+    const kk: usize = ex.dims;
+    const cols = 8 * promptGuTiles(sh);
+    if (!k.pgu_ready or !gateUpPromptFits(ex, x, x_stride, out)) return error.Invalid;
+    const items = grouped.maxItems(rows * plan_slots, plan_experts, prompt_tile);
+    const units = items * (n / cols);
+    const grid = @min(units, k.pgu_blocks);
+    if (grid < 1) return;
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(int(x_stride));
+    a.add(int(plan_slots));
+    a.add(ex.up);
+    a.add(ex.up_s);
+    a.add(int(kk));
+    a.add(int(n));
+    a.add(p.items);
+    a.add(p.counts);
+    a.add(p.members);
+    a.add(out);
+    a.add(int(n));
+    a.add(@as(f32, 0));
+    a.add(skip);
+    try cuda.launch.launch(k.pgu_fn, .{ .grid = .{ .x = @intCast(grid) }, .block = .{ .x = @intCast(sh.wr * sh.wc * 32) }, .shared = promptGuSmem(sh) }, s, &a);
+}
+
+/// Whether a prompt call of `pairs` routed pairs takes `gateUpPrompt`; else int4_kernel on 16-pair items, same bits.
+pub fn promptGu(k: *const Kernels, pairs: usize, ex: Experts, x: u64, x_stride: usize, out: u64) bool {
+    return k.pgu and pairs >= prompt_pairs and gateUpPromptFits(ex, x, x_stride, out);
+}
+
+/// A dense matmul (the head): x [rows, k] -> out [rows, n] bf16 (or fp32), rows `x_stride` apart.
+pub fn dense(k: *const Kernels, s: cuda.Stream, x: u64, x_stride: usize, m: Mat, out: u64, f32_out: bool, rows: usize) !void {
+    if (rows == 0) return;
+    const kind: usize = switch (m.gs) {
+        128 => if (f32_out) 1 else 2,
+        64 => if (f32_out) 3 else 4,
+        else => return error.Invalid,
+    };
+    const mt: usize = if (rows <= 16 or k.head_mt == 1) 1 else 2;
+    try launch(k, s, kind, (rows + 16 * mt - 1) / (16 * mt), x, if (rows == 1) m.k else x_stride, 0, m.w, m.s, m.k, m.n, null, rows, out, m.n, -1, null, mt);
+}
+
+// ---- host tests ----------------------------------------------------------------------------------------------------
+
+test "shuffle puts input 2i at nibble i and 2i + 1 at nibble i + 4" {
+    var w: u32 = 0;
+    for (0..8) |j| w |= @as(u32, @intCast(j + 1)) << @intCast(4 * j);
+    const s = shuffle(w);
+    for (0..4) |i| {
+        try std.testing.expectEqual(@as(u32, @intCast(2 * i + 1)), (s >> @intCast(4 * i)) & 0xF);
+        try std.testing.expectEqual(@as(u32, @intCast(2 * i + 2)), (s >> @intCast(4 * (i + 4))) & 0xF);
+    }
+}
+
+test "packWords: a lane's word of a block holds its column's inputs 8 t .. 8 t + 7" {
+    const gpa = std.testing.allocator;
+    const n_full = 16;
+    const k_full = 256;
+    const qw = try gpa.alloc(u8, k_full / 8 * n_full * 4);
+    defer gpa.free(qw);
+    var prng = std.Random.DefaultPrng.init(7);
+    prng.random().bytes(qw);
+    const sc = try gpa.alloc(u8, k_full / 128 * n_full * 2);
+    defer gpa.free(sc);
+    for (0..sc.len / 2) |i| std.mem.writeInt(u16, sc[2 * i ..][0..2], @intCast(i), .little);
+    const src: Source = .{ .qweight = qw, .scales = sc, .n_full = n_full, .k_full = k_full };
+    for ([_]usize{ 128, 64 }) |gs| {
+        const sl: Slice = .{ .n0 = 8, .n = 8, .k0 = 128, .k = 128, .gs = gs };
+        const out = try gpa.alloc(u32, wordsOf(sl.n, sl.k));
+        defer gpa.free(out);
+        try packWords(src, sl, out);
+        const kg = sl.k / gs;
+        for (0..kg) |g| for (0..32) |lane| for (0..gs / 32) |b| {
+            const word = out[(g * 32 + lane) * (gs / 32) + b];
+            for (0..8) |j| {
+                const nib: usize = if (j % 2 == 0) j / 2 else j / 2 + 4;
+                const got: u4 = @intCast((word >> @intCast(4 * nib)) & 0xF);
+                const kin = sl.k0 + g * gs + b * 32 + 8 * (lane % 4) + j;
+                try std.testing.expectEqual(code(src, sl.n0 + lane / 4, kin), got);
+            }
+        };
+    }
+}
+
+test "symmetric zero points and the kernel symbols" {
+    var z: [20]u8 = @splat(0x77);
+    try std.testing.expect(zerosAreSymmetric(&z));
+    z[19] = 0x87;
+    try std.testing.expect(!zerosAreSymmetric(&z));
+    try std.testing.expectEqualStrings("_ZN10tf_fn_int411int4_kernelILi128ELi4ELi1ELi2ELi2ELi4EEEvPK13__nv_bfloat16iiPKjPK6__halfiiPKiSA_SA_iPvifi", symbols[0][2][0]);
+}
diff --git a/zig/src/families/flashnext/cuda_int4_load.zig b/zig/src/families/flashnext/cuda_int4_load.zig
new file mode 100644
index 0000000000..0f7d0bfd26
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_int4_load.zig
@@ -0,0 +1,127 @@
+//! INT4-AutoRound's GPTQ int4 tensors packed for fn_int4.cu at load: a layer's routed experts and the lm_head.
+//! The layouts are cuda_int4.zig's (the production branch's loader `int4Experts` / `int4Head`, at one GPU).
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const int4 = @import("cuda_int4.zig");
+
+/// One layer's packed routed experts and the buffers behind them.
+pub const Owned = struct {
+    up: cuda.DeviceBuffer,
+    up_s: cuda.DeviceBuffer,
+    down: cuda.DeviceBuffer,
+    down_s: cuda.DeviceBuffer,
+    ex: int4.Experts,
+
+    pub fn free(self: *Owned) void {
+        self.up.free();
+        self.up_s.free();
+        self.down.free();
+        self.down_s.free();
+        self.* = undefined;
+    }
+};
+
+/// Whether `prefix`'s routed experts are GPTQ int4: the first expert's gate has a qweight.
+pub fn isInt4(store: *wt.Store, prefix: []const u8) bool {
+    var buf: [256]u8 = undefined;
+    return store.has(std.fmt.bufPrint(&buf, "{s}.experts.0.gate_proj.qweight", .{prefix}) catch return false);
+}
+
+/// `name`'s qweight int32 [k/8, n] and scales fp16 [k/128, n], its qzeros checked symmetric (borrowed until release).
+fn source(store: *wt.Store, name: []const u8, n: usize, k: usize) !int4.Source {
+    var buf: [256]u8 = undefined;
+    const qw = try store.get(try std.fmt.bufPrint(&buf, "{s}.qweight", .{name}));
+    if (!qw.is(.i32, &.{ k / 8, n })) return error.UnexpectedTensor;
+    const sc = try store.get(try std.fmt.bufPrint(&buf, "{s}.scales", .{name}));
+    if (!sc.is(.f16, &.{ k / int4.checkpoint_group, n })) return error.UnexpectedTensor;
+    const qz = try store.get(try std.fmt.bufPrint(&buf, "{s}.qzeros", .{name}));
+    if (!qz.is(.i32, &.{ k / int4.checkpoint_group, n / 8 })) return error.UnexpectedTensor;
+    if (!int4.zerosAreSymmetric(qz.bytes)) {
+        std.log.err("{s}: zero points other than 8 (AutoGPTQ v1 qzeros 7); the engine reads symmetric GPTQ", .{name});
+        return error.UnsupportedQuantization;
+    }
+    return .{ .qweight = qw.bytes, .scales = sc.bytes, .n_full = n, .k_full = k };
+}
+
+/// Every routed expert of `prefix` whole, gate and up rows [E][2], down [E], groups of 128, one expert at a time.
+pub fn experts(a: std.mem.Allocator, d: *const cuda.Driver, store: *wt.Store, prefix: []const u8) !Owned {
+    const e = wt.experts_n;
+    const dims = wt.dims;
+    const width = wt.moe_w;
+    const uw = int4.wordsOf(width, dims);
+    const us = int4.scalesOf(width, dims, int4.checkpoint_group);
+    const dw = int4.wordsOf(dims, width);
+    const ds = int4.scalesOf(dims, width, int4.checkpoint_group);
+    var up = try cuda.DeviceBuffer.alloc(d, e * 2 * uw * 4);
+    errdefer up.free();
+    var up_s = try cuda.DeviceBuffer.alloc(d, e * 2 * us * 2);
+    errdefer up_s.free();
+    var down = try cuda.DeviceBuffer.alloc(d, e * dw * 4);
+    errdefer down.free();
+    var down_s = try cuda.DeviceBuffer.alloc(d, e * ds * 2);
+    errdefer down_s.free();
+    const hw = try a.alloc(u32, 2 * uw);
+    defer a.free(hw);
+    const hs = try a.alloc(u16, 2 * us);
+    defer a.free(hs);
+    const hdw = try a.alloc(u32, dw);
+    defer a.free(hdw);
+    const hds = try a.alloc(u16, ds);
+    defer a.free(hds);
+    var buf: [256]u8 = undefined;
+    for (0..e) |x| {
+        defer store.release();
+        for ([_][]const u8{ "gate_proj", "up_proj" }, 0..) |proj, m| {
+            const src = try source(store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.{s}", .{ prefix, x, proj }), width, dims);
+            const sl: int4.Slice = .{ .n0 = 0, .n = width, .k0 = 0, .k = dims, .gs = int4.checkpoint_group };
+            try int4.packWords(src, sl, hw[m * uw ..][0..uw]);
+            try int4.packScales(src, sl, hs[m * us ..][0..us]);
+        }
+        const src = try source(store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.down_proj", .{ prefix, x }), dims, width);
+        const sl: int4.Slice = .{ .n0 = 0, .n = dims, .k0 = 0, .k = width, .gs = int4.checkpoint_group };
+        try int4.packWords(src, sl, hdw);
+        try int4.packScales(src, sl, hds);
+        try up.upload(x * 2 * uw * 4, std.mem.sliceAsBytes(hw));
+        try up_s.upload(x * 2 * us * 2, std.mem.sliceAsBytes(hs));
+        try down.upload(x * dw * 4, std.mem.sliceAsBytes(hdw));
+        try down_s.upload(x * ds * 2, std.mem.sliceAsBytes(hds));
+    }
+    const ex: int4.Experts = .{ .up = up.ptr, .up_s = up_s.ptr, .down = down.ptr, .down_s = down_s.ptr, .count = @intCast(e), .width = @intCast(width), .dims = @intCast(dims), .gs_down = int4.checkpoint_group };
+    return .{ .up = up, .up_s = up_s, .down = down, .down_s = down_s, .ex = ex };
+}
+
+/// Whether the checkpoint's lm_head is GPTQ int4 (a qweight beside no weight).
+pub fn headIsInt4(store: *wt.Store) bool {
+    return store.has("language_model.lm_head.qweight");
+}
+
+/// The lm_head packed as one int4 matrix [vocab, dims]: words in `w`, scales in `s` of the returned projection.
+pub fn head(a: std.mem.Allocator, d: *cuda.Driver, store: *wt.Store) !wt.Q4 {
+    defer store.release();
+    const src = try source(store, "language_model.lm_head", wt.vocab, wt.dims);
+    const up = try int4.uploadMat(a, d, src);
+    var p = wt.Q4.empty(d);
+    p.w = up.w;
+    p.s = up.s;
+    p.n = wt.vocab;
+    p.k = wt.dims;
+    p.int4 = up.mat;
+    return p;
+}
+
+/// The lm_head's rows at `ids` dequantized to BF16 ((q - 8) * scale rounded): the draft head's source (drafts only).
+pub fn headRows(a: std.mem.Allocator, store: *wt.Store, ids: []const u32) ![]u8 {
+    defer store.release();
+    const src = try source(store, "language_model.lm_head", wt.vocab, wt.dims);
+    const out = try a.alloc(u8, ids.len * wt.dims * 2);
+    errdefer a.free(out);
+    for (ids, 0..) |id, r| for (0..wt.dims) |k| {
+        const v: f32 = int4.weight(src, id, k);
+        const bits: u32 = @bitCast(v);
+        // round to nearest even into bf16
+        const rounded: u32 = bits +% (0x7FFF + ((bits >> 16) & 1));
+        std.mem.writeInt(u16, out[(r * wt.dims + k) * 2 ..][0..2], @intCast(rounded >> 16), .little);
+    };
+    return out;
+}
