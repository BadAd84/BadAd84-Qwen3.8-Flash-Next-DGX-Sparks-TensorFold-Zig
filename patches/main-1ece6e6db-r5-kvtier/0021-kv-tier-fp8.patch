+/// A view whose states carry a format their target must match (Flash Next's `copyable`).
+const Formatted = struct {
+    pub const Target = struct { d: *const cuda.Driver, s: cuda.Stream, kv: u64 = 0 };
+    pub const State = struct { at: u32, kv: u64, one: cuda.DeviceBuffer };
+    pub const probe_seed: u64 = 1;
+    pub fn buffers(st: *const State) [2]?cuda.DeviceBuffer {
+        return .{ st.one, null };
+    }
+    pub fn facts(_: *const Target) [1]u64 {
+        return .{0};
+    }
+    pub fn parts(_: *const Target, _: u32, out: anytype, a: std.mem.Allocator) !void {
+        try out.append(a, .{ .bytes = 8, .row = 8 });
+    }
+    pub fn blank(_: *Target, _: u32) !*State {
+        return error.Unexpected;
+    }
+    pub fn copyable(c: *const Target, st: *const State) !void {
+        if (st.kv != c.kv) return error.KvFormat;
+    }
+};
+
+test "CUDA kept: a view's copyable is given its target, so a state of another format is refused before any copy" {
+    var d = Host.driver();
+    const KF = kept.Kept(Formatted);
+    Host.allowed = std.math.maxInt(usize);
+    var a: [8]u8 = undefined;
+    for (&a, 0..) |*x, i| x.* = @intCast(i);
+    var target: Formatted.Target = .{ .d = &d, .s = .{ .d = &d, .handle = @ptrFromInt(331) }, .kv = 1 };
+    var st: Formatted.State = .{ .at = 1, .kv = 0, .one = buffer(&d, &a) };
+    Host.copies = 0;
+    Host.pending = 0;
+    var host: [8]u8 = undefined;
+    try t.expectError(error.KvFormat, KF.image.gather(&target, &st, &.{.{ .off = 16, .len = 8 }}, &host));
+    try t.expectEqual(@as(usize, 0), Host.copies); // refused before any copy: no driver call is made
+    st.kv = 1;
+    try KF.image.gather(&target, &st, &.{.{ .off = 16, .len = 8 }}, &host);
+    try t.expectEqualSlices(u8, &a, &host);
+}
