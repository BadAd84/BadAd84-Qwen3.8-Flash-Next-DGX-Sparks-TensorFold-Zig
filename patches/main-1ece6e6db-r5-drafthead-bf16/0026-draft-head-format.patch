diff --git a/zig/src/families/flashnext/cuda_mtp_head_format_test.zig b/zig/src/families/flashnext/cuda_mtp_head_format_test.zig
new file mode 100644
index 000000000..91c293917
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_mtp_head_format_test.zig
@@ -0,0 +1,62 @@
+//! The draft head's native rows are the stock BF16 rows; a projection the drafter's recode changed is refused.
+const std = @import("std");
+const cuda = @import("cuda");
+const mtp = @import("cuda_mtp.zig");
+
+/// A pass whose native lane is never looked up: the format check answers before any kernel is asked for.
+const FakePass = struct {
+    k: struct { native_lane: cuda.qmmf.Lane },
+    stream: cuda.Stream,
+    s: struct { native_part: u64, dummy: u64 },
+
+    pub fn lane(_: FakePass, _: u64, _: u64, _: anytype, _: u64, _: u64, _: usize, _: usize) !usize {
+        return error.LaneNotReached;
+    }
+};
+
+/// A non-null, aligned pointer that is never dereferenced.
+fn fakeDriver() *const cuda.Driver {
+    return @ptrFromInt(@alignOf(cuda.Driver));
+}
+
+fn emptyBuffer(d: *const cuda.Driver) cuda.DeviceBuffer {
+    return .{ .d = d, .ptr = 0, .len = 0 };
+}
+
+/// A Head with only the fields Head.project reads: the draft projection, its ids and the artifact's fingerprint.
+fn headWith(mode: cuda.qmmf.Mode) mtp.Head {
+    const d = fakeDriver();
+    var h: mtp.Head = undefined;
+    h.draft = .{
+        .w = emptyBuffer(d),
+        .s = emptyBuffer(d),
+        .b = emptyBuffer(d),
+        .n = 4,
+        .k = 64,
+        .native = .{ .mode = mode, .codes = 0, .scales = 0, .n = 4, .k = 64, .npad = 4 },
+    };
+    h.ids = &[_]u32{};
+    h.artifact.fingerprint = @splat(0);
+    return h;
+}
+
+test "draft head format: a native projection the drafter's recode changed is refused by name" {
+    var h = headWith(.mxfp8);
+    const pass: FakePass = .{
+        .k = .{ .native_lane = undefined },
+        .stream = .{ .d = fakeDriver(), .handle = null },
+        .s = .{ .native_part = 0, .dummy = 0 },
+    };
+    // the series' own failure was error.FormatMismatch out of qlinear; the head refuses it itself, by name
+    try std.testing.expectError(error.DraftHeadFormat, h.project(&pass, 0, 0, 0, 1));
+}
+
+test "draft head format: the predicate refuses every coding but BF16 and passes an affine head" {
+    var mxfp8 = headWith(.mxfp8);
+    var bf16 = headWith(.bf16);
+    var affine = headWith(.bf16);
+    affine.draft.native = null;
+    try std.testing.expect(!mtp.storedRows(&mxfp8.draft));
+    try std.testing.expect(mtp.storedRows(&bf16.draft));
+    try std.testing.expect(mtp.storedRows(&affine.draft));
+}
