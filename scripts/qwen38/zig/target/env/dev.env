# DEV environment: the settings for main's engine, the one that is promoted to production when it is ready.
# It starts as the seven names upstream main reads from the production launcher; a lever's setting is added here
# when the lever lands upstream and has been measured, with its value, and nowhere else.
# Promotion replaces prod.env with this file's contents.
export TENSORFOLD_MEMORY_RESERVE_GIB=10
export TENSORFOLD_NO_UPDATE_CHECK=1
export TENSORFOLD_VIDEO_TOKENS=16384
export TF_FLASHNEXT_BATCH_DRAWS=1
export TF_FLASHNEXT_CONFIDENCE=-0.15
export TF_FLASHNEXT_DEPTH=15
export TF_FLASHNEXT_WINDOW=64
# Unsafe above 512 prompt rows: patch 0008's shared-direct write-back routes the shared down through the 128-row prompt tile, and that route answers the wrong prompt at 1,330+ tokens (PatchBisect, 2026-11-22). Off until the tile is fixed.
export TF_FLASHNEXT_PROMPT_SHARED_DIRECT=0
