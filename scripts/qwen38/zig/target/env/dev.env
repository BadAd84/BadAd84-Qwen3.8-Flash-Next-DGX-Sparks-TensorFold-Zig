# DEV environment: every setting that has a measured gain on the current stack, each with the file that measured it.
# READ THIS FIRST: the measured cells below were taken on the recipe's stack, not on this file as written.
# This file is the PROMOTION TARGET: boot it once as written and measure that boot before promoting it, or the
# recipe-supplied levers it now states (the eight served values) are a change nobody has measured yet
# (review finding F1, work/Glm54Review/REPORT.md).
# Promotion replaces prod.env with this file's contents; nothing is added here without a measured positive, and a
# setting measured level or negative stays out with the reason recorded at the bottom.
# Base names carried from the production launcher, mirroring scripts/qwen38/zig/target/env/prod.env; they are the
# launcher's values rather than measured levers, and promotion carries them unchanged. This tree reads BATCH_DRAWS
# and CONFIDENCE here; TF_FLASHNEXT_DEPTH and TF_FLASHNEXT_WINDOW have no reader in it (the only DEPTH string is the
# TF_FLASHNEXT_DEPTH_LOG diagnostic), so they serve the production engine only. Evidence: work/ProseDraft/POLICY.md.
export TENSORFOLD_MEMORY_RESERVE_GIB=10
export TENSORFOLD_NO_UPDATE_CHECK=1
export TENSORFOLD_VIDEO_TOKENS=16384
export TF_FLASHNEXT_BATCH_DRAWS=1
export TF_FLASHNEXT_CONFIDENCE=-0.15
export TF_FLASHNEXT_DEPTH=15
export TF_FLASHNEXT_WINDOW=64
# The production launcher's vision python path, carried for parity with the production env (whose header
# records the 2026-11-23 capture). The dev serve runs VISION=0, so nothing reads it on an arm.
# Evidence: scripts/qwen38/zig/target/env/prod.env.
export TENSORFOLD_VISION_PYTHONPATH=/opt/tensorfold/python
# Measured gains, oldest evidence first.
# Shared-direct prompt write-back: 1.2 percent at 8k and 1.0 percent at 32k cold prefill on the fixed build, decode level.
# Evidence: work/SDFix/RESULT.md (four-arm oracle, contract mode 3 against mode 2), work/PatchBisect/RESULT.md (cost table).
export TF_FLASHNEXT_PROMPT_SHARED_DIRECT=1
# Fused prompt read-out, upstream since #3413 and default off: 3.19 to 6.47 percent cold TTFT, decode level, tokens equal.
# Evidence: work/KnobTest/receipt/w1, work/RoGpu/receipt/cold.md (7 of 8 cold cells faster, 792 of 792 hashes equal).
export TF_FLASHNEXT_READOUT_FUSED=1
# Solo prompt passes at 16,384 rows over main's 8,192: 1.12 to 1.39 percent at 32k and 64k, 2k and 8k level.
# Evidence: work/KnobTest/receipt/w1 (the solo arm), work/KnobTest/VERDICTS.md.
export TF_FLASHNEXT_CHUNK_SOLO=16384
# Prompt passes at 4,096 rows over main's 3,072: 3.6 to 4.1 percent cold TTFT at 1k, 8k and 32k, all three decisive.
# Evidence: work/GapArms/RESULT.md (control 3,072 against 4,096, planner readback 4,096 rows a pass).
export TF_FLASHNEXT_CHUNK=4096
# The lone stream's copy window takes the width the boot check proves, fail-closed at 32 rows: 26 and 12 percent on
# verbatim and one-word copy turns, decode level. Evidence: work/upsubmit/PrCopyWindow/pr-body-g.md receipt, patches r3 0001.
export TF_FLASHNEXT_WINDOW_CHECK=1
# The page pool, because the shape needs it: without it 8 streams at 262,144 is refused by name (39.90 GiB against
# 31.00), and with it the plan fits 8 streams and leaves 3.1 GiB of prompt cache. Not a speed claim; an enabler.
# Persistent NVMe KV tier at that shape: an appended agent turn resumes instead of re-prefilling. Measured 1.042 and
# 1.226 s TTFT against 44.206 and 44.305 s no-tier twins, 116.16 and 118.03 MiB a turn, replies byte-equal, decode
# level in all 30 cells at 1, 2, 4, 6 and 8 streams. The launcher must also carry --prompt-cache-gib 6,
# --prompt-cache-disk /cache/kv, --learn-gib 60, --learn-daily-gib 200 and --learn-min-free-gib 20; the plan grants
# 3.1 GiB of the 6 asked, so a 100k state (2.0 GiB) fits and a 261k state (4.7 GiB) does not.
# On the shipped r5int4 image, whose engine has no tier patch, the argument check refuses --learn-conversations
# together with --prompt-cache-disk ("argument --learn-conversations: not allowed with --prompt-cache-disk"), so a
# window that needs only the in-RAM cache passes --prompt-cache-gib 6 alone and the plan grants 3.1 GiB of it.
# Evidence: work/KvTierShip/RESULT.md, work/KvTierShip/SHAPES.md, work/KvTierDedup/RESULT.md, work/ProseDraft/RESULT.md.
export TF_FLASHNEXT_KV_PAGES=4096
# The image's baked kernel set overridden, because the shape above needs it: both r5 images carry
# TENSORFOLD_CUDA_KERNELS=/opt/tensorfold/share/tensorfold/cuda/sm121 in their own ENV, and a captured set is refused
# with --kv-cache fp8 and with the page pool on one rank (cuda_lanes_load.zig:33,35 raise error.Fp8KvUnsupported and
# error.FlashNextPagesUnsupported whenever captured is not null), which are exactly what the fp8 plan and KV_PAGES set.
# `native` is the value that clears captured for the engine's own glue, so this line is an enabler, not a speed claim.
# An unset variable is what loads the installed set, else the built-ins (cuda/aot.zig:15-22), and absence cannot be
# realised inside this image: the image ENV is always present, `-e NAME=` carries a value, and a blank is taken as a
# folder name and refused (docs/environment.md:116). The dev boot proved it: a valueless line left the engine on the
# captured set and it refused fp8 (work/EnvBoot/RESULT.md section 2b). Evidence: docs/KNOB-SCREEN.md (both images bake
# it), work/QRerun/trees/fp4/src/zig/src/cuda/aot.zig, work/QRerun/trees/fp4/src/zig/src/families/flashnext/cuda_lanes_load.zig.
export TENSORFOLD_CUDA_KERNELS=native
# The shared per-draft gate off: greedy chains keep the -0.15 product stop at every width, so four streams draft 2.8
# tokens a round where the hard-coded 0.6 gate allowed 1.9, and prose reads 229.0 tokens a second against 207.8, both
# runs separated; code 300.1 against 276.8; the one-stream counters unchanged to the digit, which is the control that
# the knob acts only with more than one lane open. Exactness (drafted against "draft": false, concurrent against
# solo, resumed against fresh) and the eight-stream cells are in the same file.
# Evidence: work/ProseDraft/RESULT.md (S0a and S0b against B0a and B0b; window 2 for exactness).
export TF_FLASHNEXT_SHARED_DRAFTS=0
#
# Measured level or negative, deliberately absent: TF_FLASHNEXT_CONFIDENCE=-0.20 (level on prose at 1 and 4 streams
# with the shared gate off, +1.2 percent on code at 4; work/ProseDraft/RESULT.md), TF_FLASHNEXT_CHUNK=1536 (cold TTFT
# 5 to 8 percent slower, work/KnobTest),
# TF_FLASHNEXT_HC_Q12 (1.02 GiB of copies, no gain outside noise, patches r5 README), TF_CACHE_EVICT (no victim on our
# trace, work/KnobTest), TF_FLASHNEXT_READOUT_FUSE and FUSED_SPLIT (level alone, work/Fuse0018Fix and #3475's receipt).
#
# Measured level on this stack, so not set here: TF_FLASHNEXT_GREEDY_WIDE=8 (1 and 4 streams, work/ProseDraft/RESULT.md),
# and production's six draft names set where they would bite if read (DRAFT_CONTINUE, DRAFT_DEPTH_SHARED, DRAFT_PROPOSE,
# MULTI_MAX, NGRAM_LATE, NGRAM_PREFETCH): none has a reader in this tree, and the arm moved nothing.
# NOT re-measured on this stack, so not set here: TF_FLASHNEXT_MTP_WEIGHTS=mxfp8. It needs its own A/B on r5.
#
# What the boots supply over this file, measured on arm A's container (work/QRerun/box/out/QA/env.txt):
# 11 rows equal to this file, 10 different, 9 names this file does not carry. The five config.sh supplies
# through ${NAME:-...} (DRAFT_AHEAD=1, GATHER_EARLY=1, GATHER_READ=pread, PROMPT_GEMM2=1, HEAD_PIECE=1536;
# work/EnvBoot/predict_env.py ran that parse on the box, and HEAD_PIECE's line is quoted in
# work/SeriesFix/box/out/RESULT-BOX.md) take this file's value when it is sourced first, and the dev
# launcher's env block adds PREFILL_TAIL=512. The rest of the ten (MEMORY_RESERVE_GIB 9, KEEP_LATE 1,
# WARM_AHEAD 1, DRAFTS_GREEDY 15) come from the window's own block (work/QRerun/window.sh:69 carries
# DRAFTS_GREEDY=15) or the launcher. None of the ten is measured here, so this file keeps the engine's own
# default for each, which is the value we own; a boot that needs a receipt's shape states it where the
# receipt did.

#
# --- explicit defaults: values the engine's own source gives, written here so no setting is unset
#
# Owner rule 2026-11-23: no setting may be unset. Every setting the served tree reads is written here at the value
# its own read site uses when the variable is absent, and each line names that read site plus the file as evidence.
# A value that differs from the engine default is not allowed in this section: it belongs in the measured section
# above, with its cells. Two settings have a default that no value can express, because the reader tests whether
# the variable is present at all (TF_ROCE_GID_INDEX, TENSORFOLD_CUDA_KERNELS): those two are stated with no value,
# which is exactly the engine's default, and their reader's presence test is quoted on the line.
#
