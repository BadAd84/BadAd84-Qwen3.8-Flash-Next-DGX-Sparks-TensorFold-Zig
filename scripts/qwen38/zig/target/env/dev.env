# DEV environment: every setting that has a measured gain on the current stack, each with the file that measured it.
# Promotion replaces prod.env with this file's contents; nothing is added here without a measured positive, and a
# setting measured level or negative stays out with the reason recorded at the bottom.
# Base names upstream main reads from the production launcher, mirroring scripts/qwen38/zig/target/env/prod.env;
# they are the launcher's values rather than measured levers, and promotion carries them unchanged.
export TENSORFOLD_MEMORY_RESERVE_GIB=10
export TENSORFOLD_NO_UPDATE_CHECK=1
export TENSORFOLD_VIDEO_TOKENS=16384
export TF_FLASHNEXT_BATCH_DRAWS=1
export TF_FLASHNEXT_CONFIDENCE=-0.15
export TF_FLASHNEXT_DEPTH=15
export TF_FLASHNEXT_WINDOW=64
# Measured gains, oldest evidence first.
# Shared-direct prompt write-back: 1.2 percent at 8k and 1.0 percent at 32k cold prefill on the fixed build, decode level.
# Evidence: work/SDFix/RESULT.md (four-arm oracle, contract mode 3 against mode 2), work/PatchBisect/RESULT.md (cost table).
export TF_FLASHNEXT_PROMPT_SHARED_DIRECT=1
# Fused prompt read-out, upstream since #3413 and default off: 3.19 to 6.47 percent cold TTFT, decode level, tokens equal.
# Evidence: work/KnobTest/receipt/w1, work/RoGpu/receipt/cold.md (7 of 8 cold cells faster, 792 of 792 hashes equal).
export TF_FLASHNEXT_READOUT_FUSED=1
# Solo prompt passes at 16,384 rows over main's 8,192: 1.12 to 1.39 percent at 32k and 64k, 2k and 8k level.
# Evidence: work/KnobTest/receipt/w1 (the solo arm), work/KnobTest/VERDICTS.md.
export TF_FLASHNEXT_CHUNK_SOLO=16384
# The lone stream's copy window takes the width the boot check proves, fail-closed at 32 rows: 26 and 12 percent on
# verbatim and one-word copy turns, decode level. Evidence: work/upsubmit/PrCopyWindow/pr-body-g.md receipt, patches r3 0001.
export TF_FLASHNEXT_WINDOW_CHECK=1
#
# Measured level or negative, deliberately absent: TF_FLASHNEXT_CHUNK=1536 (cold TTFT 5 to 8 percent slower, work/KnobTest),
# TF_FLASHNEXT_HC_Q12 (1.02 GiB of copies, no gain outside noise, patches r5 README), TF_CACHE_EVICT (no victim on our
# trace, work/KnobTest), TF_FLASHNEXT_READOUT_FUSE and FUSED_SPLIT (level alone, work/Fuse0018Fix and #3475's receipt).
#
# From the 1.2.7 launcher block and NOT re-measured on this stack, so not set here: TF_FLASHNEXT_SHARED_DRAFTS=0,
# TF_FLASHNEXT_GREEDY_WIDE=8, TF_FLASHNEXT_MTP_WEIGHTS=mxfp8. Each needs its own A/B on r5 before it joins this file.
