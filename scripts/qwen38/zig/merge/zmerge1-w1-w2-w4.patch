+        int64_t idx = int64_t(threadIdx.x) + int64_t(by) * int64_t(bw);
+        if (aligned8) {
+            const uint2* quads = reinterpret_cast<const uint2*>(bits);
+            while (idx * 4 + 3 < int64_t(n)) {
