+        // the mutant is killed when every row tile's path (16, 32: the decode fused kernels, 64: the prompt's) shows it
+        const mutant_ok = sk == 1 or (mutant_differ[0] > 0 and mutant_differ[1] > 0 and mutant_differ[2] > 0);
+        if (!mutant_ok) ok = false;
+        std.debug.print("{s} n {d} k {d} split_k {d}: {d} variant calls (rows {any}), {d} differ from stock; mutant (fused, half the slices) differs on {d}/{d} (tile 16), {d}/{d} (32), {d}/{d} (64) calls: {s}\n", .{ if (differ == 0 and mutant_ok) "PASS" else "FAIL", n, kk, sk, calls, rows_list, differ, mutant_differ[0], mutant_calls[0], mutant_differ[1], mutant_calls[1], mutant_differ[2], mutant_calls[2], if (sk == 1) "no split" else if (mutant_ok) "KILLED" else "SURVIVED (the check cannot see a slice change)" });
