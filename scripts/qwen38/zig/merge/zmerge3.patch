+/// Random block-FP8 weights at the checkpoint's decode shapes (no NaN codes, scales 2^-9..2^-4): every Mode's
+/// outputs (bf16 and fp32; the ld form for the projections, its gaps poisoned) byte-compared with the stock kernel's
+/// at decode row counts, the output poisoned before every call; a mutant (the fused form told half the slices) must
+/// differ; then each mode's time at 1-32 rows, the weights rotated over copies that do not fit the 24 MB L2 (the
+/// engine reads each layer's weights once a round), modes interleaved, median of 5.
+pub fn w8Check(gpa: std.mem.Allocator, ctx: *const cuda.Context) !bool {
+    const d = ctx.d;
+    var k = try Kernels.load(ctx);
+    defer k.deinit();
+    var stream = try cuda.Stream.init(d, true);
+    defer stream.deinit();
+    var e0 = try cuda.Event.init(d, true);
+    defer e0.deinit();
+    var e1 = try cuda.Event.init(d, true);
+    defer e1.deinit();
