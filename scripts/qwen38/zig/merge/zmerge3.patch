+// OTS w8: MT > 2 (the head's 64-row items): only the weights and scales are staged; each row tile's activations are
+// read when that tile is computed (they sit in L1/L2: 64 rows), so the registers hold one tile's at a time instead of
+// MT stages' worth (MT 4 staged spilled). The same MMA chain and fmaf order per output as compute_stage.
+template <int GS, int NT, int MATS>
+struct StageW {
+  Words<GS> w[MATS][NT];
+  uint32_t s[MATS][NT];
+};
+
+template <int GS, int NT, int MATS>
+__device__ __forceinline__ void load_w(StageW<GS, NT, MATS>& st, const uint32_t* const (&w)[MATS],
+                                       const __half* const (&s)[MATS], int KG, int g, int lane, int t) {
+#pragma unroll
+  for (int m = 0; m < MATS; ++m)
+#pragma unroll
+    for (int j = 0; j < NT; ++j) {
+      const size_t tg = (size_t)j * KG + g;
+      st.w[m][j] = load_words<GS>(w[m] + (tg * 32 + lane) * (GS / 32));
+      st.s[m][j] = __ldg(reinterpret_cast<const unsigned int*>(s[m] + tg * 8 + 2 * t));
+    }
+}
+
+template <int GS, int NT, int MATS, int MT>
+__device__ __forceinline__ void compute_jit(float (&acc)[MT][MATS][NT][4], const StageW<GS, NT, MATS>& st, int g, int t,
+                                            const __nv_bfloat16* const (&x0)[MT],
+                                            const __nv_bfloat16* const (&x1)[MT], const bool (&v0)[MT],
+                                            const bool (&v1)[MT]) {
+  const uint4 zero = make_uint4(0u, 0u, 0u, 0u);
+#pragma unroll
+  for (int r = 0; r < MT; ++r) {
+    uint4 xa[GS / 32], xb[GS / 32];
+#pragma unroll
+    for (int b = 0; b < GS / 32; ++b) {
+      const int k0 = g * GS + b * 32 + 8 * t;
+      xa[b] = v0[r] ? __ldg(reinterpret_cast<const uint4*>(x0[r] + k0)) : zero;
+      xb[b] = v1[r] ? __ldg(reinterpret_cast<const uint4*>(x1[r] + k0)) : zero;
+    }
+#pragma unroll
+    for (int m = 0; m < MATS; ++m)
+#pragma unroll
+      for (int j = 0; j < NT; ++j) {
+        const __half2 h = *reinterpret_cast<const __half2*>(&st.s[m][j]);
+        const float s0 = __low2float(h), s1 = __high2float(h);
+        float d[4] = {0.f, 0.f, 0.f, 0.f};
+#pragma unroll
+        for (int b = 0; b < GS / 32; ++b) {
+          const uint32_t word = st.w[m][j].v[b];
+#pragma unroll
+          for (int s = 0; s < 2; ++s)
+            mma(d, comp(xa[b], 2 * s), comp(xb[b], 2 * s), comp(xa[b], 2 * s + 1), comp(xb[b], 2 * s + 1),
+                pair(word, 2 * s), pair(word, 2 * s + 1));
+        }
+        float(&a)[4] = acc[r][m][j];
+        a[0] = fmaf(d[0], s0, a[0]);
+        a[1] = fmaf(d[1], s1, a[1]);
+        if (v1[r]) {
+          a[2] = fmaf(d[2], s0, a[2]);
+          a[3] = fmaf(d[3], s1, a[3]);
+        }
+      }
+  }
+}
