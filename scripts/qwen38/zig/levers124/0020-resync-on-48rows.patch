+test "a resync is armed only by a copy that was landing, and only out of the prompt" {
+    const gpa = std.testing.allocator;
+    var s = try SuffixLookup.init(gpa, .{ .ngram = 2, .min_match = 2, .resync = true });
+    defer s.deinit();
