+    .{ 0x7fc00000, 0x7f },
+};
+
+test "encode gives the codes cuda_fp8.h gives" {
+    for (nvidia_codes) |pair| {
+        try std.testing.expectEqual(@as(u8, @intCast(pair[1])), encode(@bitCast(pair[0])));
+    }
+}
