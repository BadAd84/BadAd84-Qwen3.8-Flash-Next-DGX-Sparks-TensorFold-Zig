diff --git a/zig/src/families/flashnext/cuda_ple_gather_lanes.zig b/zig/src/families/flashnext/cuda_ple_gather_lanes.zig
new file mode 100644
index 000000000..bf2ab5027
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_ple_gather_lanes.zig
@@ -0,0 +1,153 @@
+//! The shared pass's n-gram gather: every lane's rows in one pool call, and the tables' scales locked at load.
+
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const ple_pool = @import("cuda_ple_pool.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const batch_state = @import("cuda_batch_state.zig");
+const knobs = @import("cuda_knobs.zig");
+const sys = @import("sys");
+
+const dims = wt.dims;
+const max_n = ple.max_n;
+
+/// TF_FLASHNEXT_GATHER_LOG=1: where the time of a shared gather goes.
+pub const Stat = struct {
+    pub var on: bool = false;
+    var calls: u64 = 0;
+    var prep_ns: u64 = 0;
+    var run_ns: u64 = 0;
+    var post_ns: u64 = 0;
+    var parts_n: u64 = 0;
+    var items_n: u64 = 0;
+    pub var part_sum = std.atomic.Value(u64).init(0);
+    pub var part_max = std.atomic.Value(u64).init(0);
+    var max_sum: u64 = 0;
+    var run_sum_parts: u64 = 0;
+    pub fn now() u64 {
+        var t: sys.c.timespec = undefined;
+        _ = sys.c.clock_gettime(sys.c.CLOCK.MONOTONIC, &t);
+        return @as(u64, @intCast(t.sec)) * 1_000_000_000 + @as(u64, @intCast(t.nsec));
+    }
+};
+
+/// One stream's rows in a shared gather: its history (moved past the rows), tokens, and its slices of out and xs.
+pub const Part = struct { history: []i64, tokens: []const u32, out: []u16, xs: []f32 };
+
+/// A shared pass's lanes gathered in one pool call (TF_FLASHNEXT_GATHER_EARLY=1, 64 lanes at most); sets failed.
+pub fn early(g: *batch_state.Gather) bool {
+    if (!(knobs.gatherEarly() catch false) or g.lanes.len > 64) return false;
+    var parts: [64]Part = undefined;
+    var at: usize = 0;
+    // each stream's ids come from its own history, so every row's bits are the per-stream call's
+    for (g.lanes, 0..) |l, k| {
+        parts[k] = .{ .history = l.seq.history[0..], .tokens = g.ids[at..][0..l.rows], .out = g.emb[at * dims ..][0 .. l.rows * dims], .xs = g.xs[at * (dims / 32) ..][0 .. l.rows * (dims / 32)] };
+        at += l.rows;
+    }
+    rowsMany(g.ngram, parts[0..g.lanes.len]) catch |err| {
+        g.failed = err;
+    };
+    return true;
+}
+
+/// TF_FLASHNEXT_GATHER_LOCK_SCALES=1 (NVFP4): mlock the tables' scale arrays, so a row faults one page, not two.
+pub fn maybeLockScales(g: *ple.Ngram, io: std.Io) !void {
+    if (try knobs.gatherLockScales() and g.format == .nvfp4) lockScales(g, io);
+}
+
+fn lockScales(g: *ple.Ngram, io: std.Io) void {
+    if (@import("builtin").os.tag != .linux) return;
+    var total: usize = 0;
+    var failed = false;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for (g.tables[0..g.hash.shards]) |t| {
+        const addr = @intFromPtr(t.scales.ptr);
+        const lo = addr & ~@as(usize, 4095);
+        const len = (addr + t.scales.len + 4095 - lo) & ~@as(usize, 4095);
+        const rc = std.os.linux.syscall2(.mlock, lo, len);
+        if (std.os.linux.errno(rc) != .SUCCESS) failed = true else total += len;
+    }
+    std.debug.print("info: flashnext: n-gram scale arrays locked in memory: {d:.2} GiB in {d:.1} s{s}\n", .{ @as(f64, @floatFromInt(total)) / (1 << 30), @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9, if (failed) " (some mlock calls failed)" else "" });
+}
+
+/// `Ngram.rows` over several streams' rows in one pool call; the rows lie one after another in the caller's buffers.
+pub fn rowsMany(g: *const ple.Ngram, parts: []const Part) !void {
+    const heads = g.hash.heads;
+    const w = g.width();
+    var total: usize = 0;
+    for (parts) |q| {
+        if (q.history.len != g.hash.n - 1 or q.out.len != q.tokens.len * w or q.xs.len != q.out.len / 32) return error.UnexpectedTensor;
+        total += q.tokens.len;
+    }
+    const items = total * heads;
+    const ids = try g.gpa.alloc(i64, items);
+    defer g.gpa.free(ids);
+    Stat.on = knobs.gatherLog() catch false;
+    const ts0 = if (Stat.on) Stat.now() else 0;
+    var hists: [64][max_n]i64 = undefined;
+    if (parts.len > hists.len) return error.UnexpectedTensor;
+    var at: usize = 0;
+    for (parts, 0..) |q, k| {
+        const hist = &hists[k];
+        @memcpy(hist[0..q.history.len], q.history);
+        for (q.tokens) |token| {
+            try ple.lastIds(g.hash, hist[0..q.history.len], @intCast(token), ids[at * heads ..][0..heads]);
+            for (0..q.history.len - 1) |i| hist[i] = hist[i + 1];
+            hist[q.history.len - 1] = token;
+            at += 1;
+        }
+    }
+    // the parts' outputs are consecutive in the caller's buffer (row0 on): one fill covers them all
+    var out = parts[0].out;
+    out.len = total * w;
+    for (parts[1..], 0..) |q, k| if (q.out.ptr != parts[k].out.ptr + parts[k].out.len) return error.UnexpectedTensor;
+    const n_threads = @min(ple_pool.max_parts, items / 4);
+    const ts1 = if (Stat.on) Stat.now() else 0;
+    if (Stat.on) {
+        Stat.part_sum.store(0, .monotonic);
+        Stat.part_max.store(0, .monotonic);
+    }
+    if (g.format != .mlx and items > 1) {
+        try @import("cuda_ple_gather.zig").run(g, ids, out);
+    } else if (n_threads <= 1 or g.pool == null) {
+        try g.fill(ids, out, 0, items);
+    } else {
+        const split: ple.Ngram.Split = .{ .g = g, .ids = ids, .out = out, .per = (items + n_threads - 1) / n_threads };
+        try g.pool.?.run(n_threads, .{ .ctx = &split, .run = ple.Ngram.Split.part });
+    }
+    const ts2 = if (Stat.on) Stat.now() else 0;
+    defer if (Stat.on) {
+        Stat.calls += 1;
+        Stat.prep_ns += ts1 - ts0;
+        Stat.run_ns += ts2 - ts1;
+        Stat.post_ns += Stat.now() - ts2;
+        Stat.parts_n += n_threads;
+        Stat.items_n += items;
+        Stat.max_sum += Stat.part_max.load(.monotonic);
+        Stat.run_sum_parts += Stat.part_sum.load(.monotonic);
+        if (Stat.calls % 100 == 0) {
+            const f = 100.0 * 1e6;
+            std.debug.print("gather detail: per call prep {d:.2} ms, pool run {d:.2} ms (slowest part {d:.2} ms, sum of parts {d:.2} ms), post {d:.2} ms; {d:.0} parts, {d:.0} items\n", .{ @as(f64, @floatFromInt(Stat.prep_ns)) / f, @as(f64, @floatFromInt(Stat.run_ns)) / f, @as(f64, @floatFromInt(Stat.max_sum)) / f, @as(f64, @floatFromInt(Stat.run_sum_parts)) / f, @as(f64, @floatFromInt(Stat.post_ns)) / f, @as(f64, @floatFromInt(Stat.parts_n)) / 100.0, @as(f64, @floatFromInt(Stat.items_n)) / 100.0 });
+            Stat.prep_ns = 0;
+            Stat.run_ns = 0;
+            Stat.post_ns = 0;
+            Stat.parts_n = 0;
+            Stat.items_n = 0;
+            Stat.max_sum = 0;
+            Stat.run_sum_parts = 0;
+        }
+    };
+    for (parts) |q| {
+        for (0..q.tokens.len) |t| {
+            const row = q.out[t * w ..][0..w];
+            if (g.format == .mlx and g.scale != 1) {
+                for (row) |*v| {
+                    const f: f32 = @bitCast(@as(u32, v.*) << 16);
+                    v.* = ple.toBf16(f * g.scale);
+                }
+            }
+            ple.sumGroups(row, q.xs[t * (w / 32) ..][0 .. w / 32]);
+        }
+    }
+    for (parts, 0..) |q, k| @memcpy(q.history, hists[k][0..q.history.len]);
+}
