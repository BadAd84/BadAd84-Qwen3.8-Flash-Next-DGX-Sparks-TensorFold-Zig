@@ -0,0 +1,34 @@
+//! TF_FLASHNEXT_GATHER_LOG=1: what a shared pass waits for the n-gram gather at the PLE layer.
+
+const std = @import("std");
+const knobs = @import("cuda_knobs.zig");
+const batch_state = @import("cuda_batch_state.zig");
+
+var passes: u64 = 0;
+var wait_ns: u64 = 0;
+var gather_ns: u64 = 0;
+var ahead_ns: u64 = 0;
+var rows: u64 = 0;
+
+/// Joins the shared pass's gather thread, recording what the pass launched ahead and waited; 100 passes a line.
+pub fn join(thread: ?std.Thread, gather: *const batch_state.Gather, io: std.Io, t0: i96, n: usize) !?std.Thread {
+    const log_gather = thread != null and gather.lanes.len > 0 and try knobs.gatherLog();
+    const t_join = if (log_gather) std.Io.Clock.awake.now(io).toNanoseconds() else 0;
+    if (thread) |th| th.join();
+    if (!log_gather) return null;
+    const t_done = std.Io.Clock.awake.now(io).toNanoseconds();
+    passes += 1;
+    wait_ns += @intCast(t_done - t_join);
+    gather_ns += @intCast(gather.ns);
+    ahead_ns += @intCast(t_join - t0);
+    rows += n;
+    if (passes % 100 == 0) {
+        const f = @as(f64, 1e6) * 100.0;
+        std.debug.print("gather: {d} shared passes, per pass: {d:.1} rows, gather {d:.2} ms, launched ahead {d:.2} ms, join wait {d:.2} ms\n", .{ passes, @as(f64, @floatFromInt(rows)) / 100.0, @as(f64, @floatFromInt(gather_ns)) / f, @as(f64, @floatFromInt(ahead_ns)) / f, @as(f64, @floatFromInt(wait_ns)) / f });
+        wait_ns = 0;
+        gather_ns = 0;
+        ahead_ns = 0;
+        rows = 0;
+    }
+    return null;
+}
